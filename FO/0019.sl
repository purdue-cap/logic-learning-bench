(constraint (with-model P9 (FO.Sem phi (FO.Asp))))
(constraint (with-model P10 (FO.Sem phi (FO.Asp))))
(constraint (with-model P11 (FO.Sem phi (FO.Asp))))
(constraint (with-model P12 (FO.Sem phi (FO.Asp))))
(constraint (with-model P13 (FO.Sem phi (FO.Asp))))
(constraint (with-model P14 (FO.Sem phi (FO.Asp))))
(constraint (with-model P15 (FO.Sem phi (FO.Asp))))
