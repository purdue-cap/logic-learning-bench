(model N11
  ((@node_0 node) (@node_1 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_1 @quorum_a_0)
  (member_b @node_1 @quorum_b_0)
  (member_fa @node_0)
  (rb.correct @node_0)
  (rb.correct @node_1)
  (rb.rcv_msg @node_1 @node_0)
  (rb.sent_msg_proj @node_1)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_0)
)
(model P12
  ((@node_0 node) (@node_1 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_1 @quorum_a_0)
  (member_b @node_1 @quorum_b_0)
  (member_fa @node_0)
  (rb.correct @node_0)
  (rb.correct @node_1)
  (rb.rcv_msg @node_0 @node_0)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_0)
)
(model N13
  ((@node_0 node) (@node_1 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_1 @quorum_a_0)
  (member_b @node_1 @quorum_b_0)
  (member_fa @node_0)
  (rb.correct @node_0)
  (rb.correct @node_1)
  (rb.rcv_msg @node_0 @node_0)
