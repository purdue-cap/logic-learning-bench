(model P17
  ((@node_0 node) (@node_1 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_1 @quorum_a_0)
  (member_b @node_1 @quorum_b_0)
  (member_fi @node_0)
  (rb.correct @node_0)
  (rb.correct @node_1)
  (rb.rcv_msg @node_0 @node_0)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_0)
)

(constraint P0 (not N1) (not N2) P3 (not N4) (not N5) (not N6) P7 P8 (not N9) P10 (not N11) P12 (not N13) (not N14) P15 (not N16) P17)
