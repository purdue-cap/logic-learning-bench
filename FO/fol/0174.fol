; File: good-ivy-examples/fol-thresholds/hybrid_reliable_broadcast_cisa.ivy

; Sig
(sort node)
(sort quorum_a)
(sort quorum_b)
(relation member_a node quorum_a)
(relation member_b node quorum_b)
(relation member_fa node)
(relation member_fc node)
(relation member_fi node)
(relation member_fs node)
(relation rb.accept node)
(relation rb.correct node)
(relation rb.d node)
(relation rb.obedient node)
(relation rb.rcv_init node)
(relation rb.rcv_msg node node)
(relation rb.sent_msg node node)
(relation rb.sent_msg_proj node)
(relation rb.symmetric node)
(constant rb.tp_correctness.n0 node)
(constant rb.tp_relay.n1 node)
(constant rb.tp_relay.n2 node)
; End sig

; Axiom a
(axiom (exists B quorum_b (forall N node (or (not (member_b N B)) (and (and (and (not (member_fa N)) (not (member_fc N))) (not (member_fs N))) (not (member_fi N)))))))
; Axiom a0
(axiom (forall A_BP quorum_a (exists N node (and (and (member_a N A_BP) (not (member_fa N))) (not (member_fs N))))))
; Axiom a1
(axiom (forall B_CF quorum_b (exists A quorum_a (forall N node (or (not (member_a N A)) (and (and (member_b N B_CF) (not (member_fa N))) (not (member_fi N))))))))
; Axiom rb
(axiom (forall N node (not (and (member_fc N) (member_fi N)))))
; Axiom rb0
(axiom (forall N node (not (and (member_fc N) (member_fs N)))))
; Axiom rb1
(axiom (forall N node (not (and (member_fc N) (member_fa N)))))
; Axiom rb2
(axiom (forall N node (not (and (member_fi N) (member_fs N)))))
; Axiom rb3
(axiom (forall N node (not (and (member_fi N) (member_fa N)))))
; Axiom rb4
(axiom (forall N node (not (and (member_fs N) (member_fa N)))))


; Conjecture rb_tp_relay_impl4
(conjecture (forall A quorum_a (or (not (and (rb.correct rb.tp_relay.n2) (not (rb.sent_msg_proj rb.tp_relay.n2)))) (exists M node (and (member_a M A) (not (rb.rcv_msg M rb.tp_relay.n2)))))))

(model P0
  ((@node_0 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_0 @quorum_a_0)
  (member_b @node_0 @quorum_b_0)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_0)
)
(model N1
  ((@node_0 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_0 @quorum_a_0)
  (member_b @node_0 @quorum_b_0)
  (rb.correct @node_0)
  (rb.rcv_msg @node_0 @node_0)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_0)
)
(model N2
  ((@node_0 node) (@node_1 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_1 @quorum_a_0)
  (member_b @node_1 @quorum_b_0)
  (member_fa @node_0)
  (rb.correct @node_1)
  (rb.rcv_msg @node_0 @node_0)
  (rb.rcv_msg @node_0 @node_1)
  (rb.rcv_msg @node_1 @node_0)
  (rb.rcv_msg @node_1 @node_1)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_1)
)
(model P3
  ((@node_0 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_0 @quorum_a_0)
  (member_b @node_0 @quorum_b_0)
  (rb.correct @node_0)
  (rb.sent_msg_proj @node_0)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_0)
)
(model N4
  ((@node_0 node) (@node_1 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_1 @quorum_a_0)
  (member_b @node_1 @quorum_b_0)
  (member_fa @node_0)
  (rb.correct @node_0)
  (rb.correct @node_1)
  (rb.rcv_msg @node_1 @node_0)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_0)
)
(model N5
  ((@node_0 node) (@node_1 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_1 @quorum_a_0)
  (member_b @node_1 @quorum_b_0)
  (member_fa @node_0)
  (rb.correct @node_0)
  (rb.correct @node_1)
  (rb.rcv_msg @node_0 @node_0)
  (rb.rcv_msg @node_0 @node_1)
  (rb.rcv_msg @node_1 @node_0)
  (rb.rcv_msg @node_1 @node_1)
  (rb.sent_msg_proj @node_1)
  (= rb.tp_correctness.n0 @node_1)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_0)
)
(model N6
  ((@node_0 node) (@node_1 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_1 @quorum_a_0)
  (member_b @node_1 @quorum_b_0)
  (member_fa @node_0)
  (rb.correct @node_0)
  (rb.correct @node_1)
  (rb.rcv_msg @node_0 @node_0)
  (rb.rcv_msg @node_0 @node_1)
  (rb.rcv_msg @node_1 @node_0)
  (rb.rcv_msg @node_1 @node_1)
  (rb.sent_msg_proj @node_1)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_1)
  (= rb.tp_relay.n2 @node_0)
)
(model P7
  ((@node_0 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_0 @quorum_a_0)
  (member_b @node_0 @quorum_b_0)
  (rb.correct @node_0)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_0)
)
(model P8
  ((@node_0 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_0 @quorum_a_0)
  (member_b @node_0 @quorum_b_0)
  (rb.rcv_msg @node_0 @node_0)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_0)
)
(model N9
  ((@node_0 node) (@node_1 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_1 @quorum_a_0)
  (member_b @node_1 @quorum_b_0)
  (member_fa @node_0)
  (rb.correct @node_0)
  (rb.rcv_msg @node_1 @node_0)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_0)
)
(model P10
  ((@node_0 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b))
  (member_a @node_0 @quorum_a_0)
  (member_b @node_0 @quorum_b_0)
  (rb.correct @node_0)
  (rb.rcv_msg @node_0 @node_0)
  (rb.sent_msg_proj @node_0)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_0)
