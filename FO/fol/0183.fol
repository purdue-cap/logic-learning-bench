; File: examples/fol/learning_switch.pyv

; Sig
(sort node)
(relation pending node node node node)
(relation table node node node)
; End sig

; Axioms

; Conjecture c3
(conjecture (forall T node (forall X node (forall Y node (forall Z node (or (not (and (table T X Y) (table T X Z))) (or (table T Y Z) (table T Z Y))))))))

(model P0
  ((@node_0 node) (@packet_0 packet))
  (pending @packet_0 @node_0 @node_0)
  (route.dom @node_0 @node_0)
  (= (dst @packet_0) @node_0)
  (= (src @packet_0) @node_0)
)
(model N1
  ((@node_0 node) (@node_1 node) (@packet_0 packet))
  (pending @packet_0 @node_0 @node_0)
  (pending @packet_0 @node_0 @node_1)
  (pending @packet_0 @node_1 @node_0)
  (pending @packet_0 @node_1 @node_1)
  (= (dst @packet_0) @node_0)
  (= (src @packet_0) @node_1)
)
(model N2
  ((@node_0 node) (@node_1 node) (@packet_0 packet))
  (pending @packet_0 @node_0 @node_0)
  (pending @packet_0 @node_0 @node_1)
  (pending @packet_0 @node_1 @node_0)
  (pending @packet_0 @node_1 @node_1)
  (route.dom @node_0 @node_0)
  (= (dst @packet_0) @node_0)
  (= (src @packet_0) @node_1)
)
(model N3
  ((@node_0 node) (@node_1 node) (@packet_0 packet))
  (pending @packet_0 @node_0 @node_0)
  (pending @packet_0 @node_0 @node_1)
  (pending @packet_0 @node_1 @node_0)
  (pending @packet_0 @node_1 @node_1)
  (= (dst @packet_0) @node_0)
  (= (src @packet_0) @node_0)
)
(model N4
  ((@node_0 node) (@node_1 node) (@packet_0 packet))
  (pending @packet_0 @node_0 @node_0)
  (pending @packet_0 @node_0 @node_1)
  (pending @packet_0 @node_1 @node_0)
  (pending @packet_0 @node_1 @node_1)
  (route.dom @node_0 @node_0)
  (= (dst @packet_0) @node_0)
  (= (src @packet_0) @node_0)
)
(model N5
  ((@node_0 node) (@node_1 node) (@packet_0 packet))
  (pending @packet_0 @node_0 @node_0)
  (pending @packet_0 @node_0 @node_1)
  (pending @packet_0 @node_1 @node_0)
  (pending @packet_0 @node_1 @node_1)
  (route.dom @node_0 @node_0)
  (route.dom @node_1 @node_0)
  (route.dom @node_1 @node_1)
  (= (dst @packet_0) @node_0)
  (= (src @packet_0) @node_0)
)
(model P6
  ((@node_0 node) (@node_1 node) (@packet_0 packet))
  (pending @packet_0 @node_0 @node_0)
  (pending @packet_0 @node_0 @node_1)
  (pending @packet_0 @node_1 @node_0)
  (pending @packet_0 @node_1 @node_1)
  (route.dom @node_0 @node_0)
  (route.dom @node_0 @node_1)
  (route.dom @node_1 @node_0)
  (route.dom @node_1 @node_1)
  (= (dst @packet_0) @node_0)
  (= (src @packet_0) @node_1)
)
(model N7
  ((@node_0 node) (@node_1 node) (@packet_0 packet))
  (pending @packet_0 @node_0 @node_0)
  (pending @packet_0 @node_0 @node_1)
  (pending @packet_0 @node_1 @node_0)
  (pending @packet_0 @node_1 @node_1)
  (route.dom @node_1 @node_0)
  (route.dom @node_1 @node_1)
  (= (dst @packet_0) @node_1)
  (= (src @packet_0) @node_0)
)
(model N8
  ((@node_0 node) (@node_1 node) (@packet_0 packet) (@packet_1 packet))
  (pending @packet_0 @node_0 @node_0)
  (pending @packet_0 @node_0 @node_1)
  (pending @packet_0 @node_1 @node_0)
  (pending @packet_0 @node_1 @node_1)
  (pending @packet_1 @node_0 @node_0)
  (pending @packet_1 @node_0 @node_1)
  (pending @packet_1 @node_1 @node_0)
  (pending @packet_1 @node_1 @node_1)
  (route.dom @node_1 @node_0)
  (route.dom @node_1 @node_1)
  (= (dst @packet_0) @node_0)
  (= (dst @packet_1) @node_0)
  (= (src @packet_0) @node_0)
  (= (src @packet_1) @node_1)
)
(model P9
  ((@node_0 node) (@packet_0 packet))
  (pending @packet_0 @node_0 @node_0)
  (= (dst @packet_0) @node_0)
  (= (src @packet_0) @node_0)
)
