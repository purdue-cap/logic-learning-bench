; File: good-ivy-examples/oopsla17-paxos/stoppable_paxos_epr.ivy

; Sig
(sort inst)
(sort node)
(sort quorum)
(sort round)
(sort value)
(sort votemap)
(relation active round)
(relation decision node inst round value)
(relation inst_le inst inst)
(relation joined_round node round)
(relation le round round)
(relation left_round node round)
(function maxr votemap inst round)
(function maxv votemap inst value)
(relation member node quorum)
(constant none round)
(relation one_a round)
(relation one_b_msg node round votemap)
(relation proposal inst round value)
(constant stop value)
(relation vote node inst round value)
; End sig

; Axiom a
(axiom (forall X round (le X X)))
; Axiom a0
(axiom (forall X round (forall Z round (forall Y round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom a1
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom a2
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))
; Axiom a3
(axiom (forall X inst (inst_le X X)))
; Axiom a4
(axiom (forall Z inst (forall Y inst (forall X inst (or (not (and (inst_le X Y) (inst_le Y Z))) (inst_le X Z))))))
; Axiom a5
(axiom (forall Y inst (forall X inst (or (not (and (inst_le X Y) (inst_le Y X))) (= X Y)))))
; Axiom a6
(axiom (forall Y inst (forall X inst (or (inst_le X Y) (inst_le Y X)))))
; Axiom a7
(axiom (forall Q2 quorum (forall Q1 quorum (exists N node (and (member N Q1) (member N Q2))))))


; Conjecture c7
(conjecture (forall M votemap (forall N node (forall R round (forall VOTHER value (forall I inst (forall ROTHER round (or (not (and (and (and (one_b_msg N R M) (not (= (maxr M I) none))) (not (le R ROTHER))) (not (le ROTHER (maxr M I))))) (not (vote N I ROTHER VOTHER))))))))))



(model P0
  ((@uc_quorum_0 quorum) (@uc_inst_0 inst) (@uc_node_0 node) (@uc_value_0 value) (@uc_round_0 round) (@uc_votemap_0 votemap))
  (= none @uc_round_0)
  (= stop @uc_value_0)
  (inst_le @uc_inst_0 @uc_inst_0)
  (le @uc_round_0 @uc_round_0)
  (member @uc_node_0 @uc_quorum_0)
  (one_b_msg @uc_node_0 @uc_round_0 @uc_votemap_0)
  (vote @uc_node_0 @uc_inst_0 @uc_round_0 @uc_value_0)
  (= (maxr @uc_votemap_0 @uc_inst_0) @uc_round_0)
  (= (maxv @uc_votemap_0 @uc_inst_0) @uc_value_0)
)

(model N0
  ((@uc_quorum_0 quorum) (@uc_inst_0 inst) (@uc_node_0 node) (@uc_value_0 value) (@uc_round_0 round) (@uc_round_1 round) (@uc_round_2 round) (@uc_votemap_0 votemap))
  (= none @uc_round_1)
  (= stop @uc_value_0)
  (inst_le @uc_inst_0 @uc_inst_0)
  (le @uc_round_0 @uc_round_0)
  (le @uc_round_1 @uc_round_0)
  (le @uc_round_1 @uc_round_1)
  (le @uc_round_2 @uc_round_0)
  (le @uc_round_2 @uc_round_1)
  (le @uc_round_2 @uc_round_2)
  (member @uc_node_0 @uc_quorum_0)
  (one_b_msg @uc_node_0 @uc_round_0 @uc_votemap_0)
  (one_b_msg @uc_node_0 @uc_round_1 @uc_votemap_0)
  (one_b_msg @uc_node_0 @uc_round_2 @uc_votemap_0)
  (vote @uc_node_0 @uc_inst_0 @uc_round_0 @uc_value_0)
  (vote @uc_node_0 @uc_inst_0 @uc_round_1 @uc_value_0)
  (vote @uc_node_0 @uc_inst_0 @uc_round_2 @uc_value_0)
  (= (maxr @uc_votemap_0 @uc_inst_0) @uc_round_2)
  (= (maxv @uc_votemap_0 @uc_inst_0) @uc_value_0)
)

(model N1
  ((@uc_quorum_0 quorum) (@uc_inst_0 inst) (@uc_node_0 node) (@uc_value_0 value) (@uc_round_0 round) (@uc_round_1 round) (@uc_round_2 round) (@uc_round_3 round) (@uc_votemap_0 votemap))
  (= none @uc_round_0)
  (= stop @uc_value_0)
  (inst_le @uc_inst_0 @uc_inst_0)
  (le @uc_round_0 @uc_round_0)
  (le @uc_round_0 @uc_round_1)
  (le @uc_round_0 @uc_round_2)
  (le @uc_round_0 @uc_round_3)
  (le @uc_round_1 @uc_round_1)
  (le @uc_round_2 @uc_round_1)
  (le @uc_round_2 @uc_round_2)
  (le @uc_round_3 @uc_round_1)
  (le @uc_round_3 @uc_round_2)
  (le @uc_round_3 @uc_round_3)
  (member @uc_node_0 @uc_quorum_0)
  (one_b_msg @uc_node_0 @uc_round_0 @uc_votemap_0)
  (one_b_msg @uc_node_0 @uc_round_1 @uc_votemap_0)
  (one_b_msg @uc_node_0 @uc_round_2 @uc_votemap_0)
  (one_b_msg @uc_node_0 @uc_round_3 @uc_votemap_0)
  (vote @uc_node_0 @uc_inst_0 @uc_round_0 @uc_value_0)
  (vote @uc_node_0 @uc_inst_0 @uc_round_1 @uc_value_0)
  (vote @uc_node_0 @uc_inst_0 @uc_round_2 @uc_value_0)
  (vote @uc_node_0 @uc_inst_0 @uc_round_3 @uc_value_0)
  (= (maxr @uc_votemap_0 @uc_inst_0) @uc_round_3)
  (= (maxv @uc_votemap_0 @uc_inst_0) @uc_value_0)
)

(model P1
  ((@uc_quorum_0 quorum) (@uc_inst_0 inst) (@uc_node_0 node) (@uc_value_0 value) (@uc_round_0 round) (@uc_round_1 round) (@uc_votemap_0 votemap))
  (= none @uc_round_0)
