; File: good-ivy-examples/toy/lockserv.ivy

; Sig
(sort node)
(relation grant_msg node)
(relation holds_lock node)
(relation lock_msg node)
(relation server_holds_lock )
(relation unlock_msg node)
; End sig



; Conjecture conj8
(conjecture (forall N node (not (and (holds_lock N) (server_holds_lock)))))

(model P0
  ((@node_0 node))

)
(model P1
  ((@node_0 node))
  (server_holds_lock)
)
(model N2
  ((@node_0 node))
  (holds_lock @node_0)
  (server_holds_lock)
)
(model N3
  ((@node_0 node) (@node_1 node))
  (holds_lock @node_1)
  (server_holds_lock)
)
(model P4
  ((@node_0 node))
  (holds_lock @node_0)
)

(constraint P0 P1 (not N2) (not N3) P4)
