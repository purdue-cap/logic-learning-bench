; File: good-ivy-examples/oopsla17-paxos/vertical_paxos_epr_unverified_optimization.ivy

; Sig
(sort config)
(sort node)
(sort quorum)
(sort round)
(sort value)
(relation configure_round_msg round config)
(relation decision node round value)
(relation irrelevant_msg round)
(relation joined_round node round)
(relation le round round)
(relation left_rnd node round)
(constant master_minrel round)
(relation member node quorum)
(relation minrelof config round)
(constant none round)
(relation one_a round round)
(relation one_b_max_vote node round round value)
(relation proposal round value)
(function quorum_of_round round quorum)
(relation quorumin quorum config)
(relation vote node round value)
; End sig

; Axiom a
(axiom (forall X round (le X X)))
; Axiom a0
(axiom (forall X round (forall Z round (forall Y round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom a1
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom a2
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))
; Axiom a3
(axiom (forall C config (forall Q2 quorum (forall Q1 quorum (or (not (and (quorumin Q1 C) (quorumin Q2 C))) (exists N node (and (member N Q1) (member N Q2))))))))


; Conjecture c8
(conjecture (forall R round (forall V value (or (not (exists N node (decision N R V))) (exists C config (exists Q quorum (and (and (configure_round_msg R C) (quorumin Q C)) (forall N node (or (not (member N Q)) (vote N R V))))))))))



(model P0
  ((@uc_node_0 node) (@uc_quorum_0 quorum) (@uc_value_0 value) (@uc_round_0 round) (@uc_config_0 config))
  (= master_minrel @uc_round_0)
  (= none @uc_round_0)
  (configure_round_msg @uc_round_0 @uc_config_0)
  (le @uc_round_0 @uc_round_0)
  (member @uc_node_0 @uc_quorum_0)
  (vote @uc_node_0 @uc_round_0 @uc_value_0)
  (= (quorum_of_round @uc_round_0) @uc_quorum_0)
)

(model N0
  ((@uc_node_0 node) (@uc_quorum_0 quorum) (@uc_value_0 value) (@uc_round_0 round) (@uc_config_0 config))
  (= master_minrel @uc_round_0)
  (= none @uc_round_0)
  (configure_round_msg @uc_round_0 @uc_config_0)
  (decision @uc_node_0 @uc_round_0 @uc_value_0)
  (le @uc_round_0 @uc_round_0)
  (member @uc_node_0 @uc_quorum_0)
  (= (quorum_of_round @uc_round_0) @uc_quorum_0)
)

(model N1
  ((@uc_node_0 node) (@uc_quorum_0 quorum) (@uc_value_0 value) (@uc_round_0 round) (@uc_config_0 config))
  (= master_minrel @uc_round_0)
  (= none @uc_round_0)
  (decision @uc_node_0 @uc_round_0 @uc_value_0)
  (le @uc_round_0 @uc_round_0)
  (member @uc_node_0 @uc_quorum_0)
  (vote @uc_node_0 @uc_round_0 @uc_value_0)
  (= (quorum_of_round @uc_round_0) @uc_quorum_0)
)

(model N2
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_quorum_0 quorum) (@uc_value_0 value) (@uc_round_0 round) (@uc_config_0 config))
  (= master_minrel @uc_round_0)
  (= none @uc_round_0)
  (configure_round_msg @uc_round_0 @uc_config_0)
  (decision @uc_node_0 @uc_round_0 @uc_value_0)
  (le @uc_round_0 @uc_round_0)
  (member @uc_node_0 @uc_quorum_0)
  (member @uc_node_1 @uc_quorum_0)
  (= (quorum_of_round @uc_round_0) @uc_quorum_0)
)

(model N3
  ((@uc_node_0 node) (@uc_quorum_0 quorum) (@uc_value_0 value) (@uc_round_0 round) (@uc_round_1 round) (@uc_config_0 config))
  (= master_minrel @uc_round_0)
  (= none @uc_round_0)
  (configure_round_msg @uc_round_0 @uc_config_0)
  (configure_round_msg @uc_round_1 @uc_config_0)
  (decision @uc_node_0 @uc_round_1 @uc_value_0)
  (le @uc_round_0 @uc_round_0)
  (le @uc_round_1 @uc_round_0)
  (le @uc_round_1 @uc_round_1)
  (member @uc_node_0 @uc_quorum_0)
  (= (quorum_of_round @uc_round_0) @uc_quorum_0)
  (= (quorum_of_round @uc_round_1) @uc_quorum_0)
)

(model N4
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_quorum_0 quorum) (@uc_value_0 value) (@uc_round_0 round) (@uc_config_0 config))
  (= master_minrel @uc_round_0)
  (= none @uc_round_0)
  (configure_round_msg @uc_round_0 @uc_config_0)
  (decision @uc_node_1 @uc_round_0 @uc_value_0)
  (le @uc_round_0 @uc_round_0)
  (member @uc_node_0 @uc_quorum_0)
  (member @uc_node_1 @uc_quorum_0)
  (vote @uc_node_0 @uc_round_0 @uc_value_0)
  (= (quorum_of_round @uc_round_0) @uc_quorum_0)
)

(model N5
  ((@uc_node_0 node) (@uc_quorum_0 quorum) (@uc_value_0 value) (@uc_round_0 round) (@uc_round_1 round) (@uc_config_0 config))
  (= master_minrel @uc_round_0)
  (= none @uc_round_0)
  (configure_round_msg @uc_round_0 @uc_config_0)
  (configure_round_msg @uc_round_1 @uc_config_0)
  (decision @uc_node_0 @uc_round_1 @uc_value_0)
  (le @uc_round_0 @uc_round_0)
  (le @uc_round_1 @uc_round_0)
  (le @uc_round_1 @uc_round_1)
  (member @uc_node_0 @uc_quorum_0)
  (vote @uc_node_0 @uc_round_0 @uc_value_0)
  (= (quorum_of_round @uc_round_0) @uc_quorum_0)
  (= (quorum_of_round @uc_round_1) @uc_quorum_0)
)

(constraint P0 (not N0) (not N1) (not N2) (not N3) (not N4) (not N5))
