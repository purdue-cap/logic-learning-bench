; Sig
(sort tlb.pageentry)
(sort tlb.pmap)
(sort tlb.processor)
(relation tlb.actionlock tlb.processor)
(relation tlb.actionneeded tlb.processor)
(relation tlb.active tlb.processor)
(relation tlb.currentcpu tlb.processor tlb.processor)
(relation tlb.error )
