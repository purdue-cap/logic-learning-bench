; File: examples/fol/consensus_epr.pyv

; Sig
(sort node)
(sort quorum)
(sort value)
(relation decided node value)
(relation leader node)
(relation member node quorum)
(relation vote_msg node node)
(relation vote_request_msg node node)
(relation voted node)
(relation votes node node)
; End sig

; Axioms
(axiom (forall Q1 quorum (forall Q2 quorum (exists N node (and (member N Q1) (member N Q2))))))

; Conjecture c5
(conjecture (exists Q quorum (forall N node (forall M node (or (not (and (leader N) (member M Q))) (votes N M))))))



(model P0
  ((@uc_node_0 node) (@uc_quorum_0 quorum) (@uc_value_0 value))
  (leader @uc_node_0)
  (member @uc_node_0 @uc_quorum_0)
  (votes @uc_node_0 @uc_node_0)
)

(model N0
  ((@uc_node_0 node) (@uc_quorum_0 quorum) (@uc_value_0 value))
  (leader @uc_node_0)
  (member @uc_node_0 @uc_quorum_0)
)

(model N1
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_quorum_0 quorum) (@uc_value_0 value))
  (leader @uc_node_0)
  (leader @uc_node_1)
  (member @uc_node_0 @uc_quorum_0)
  (member @uc_node_1 @uc_quorum_0)
  (votes @uc_node_0 @uc_node_0)
)

(model N2
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_quorum_0 quorum) (@uc_value_0 value))
  (leader @uc_node_0)
  (leader @uc_node_1)
  (member @uc_node_0 @uc_quorum_0)
  (member @uc_node_1 @uc_quorum_0)
  (votes @uc_node_0 @uc_node_0)
  (votes @uc_node_0 @uc_node_1)
  (votes @uc_node_1 @uc_node_1)
)

(model P1
  ((@uc_node_0 node) (@uc_quorum_0 quorum) (@uc_value_0 value))
  (member @uc_node_0 @uc_quorum_0)
)

(model P2
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_quorum_0 quorum) (@uc_value_0 value))
  (leader @uc_node_0)
  (member @uc_node_1 @uc_quorum_0)
  (votes @uc_node_0 @uc_node_1)
)

(model N3
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_quorum_0 quorum) (@uc_value_0 value))
  (leader @uc_node_0)
  (member @uc_node_0 @uc_quorum_0)
  (member @uc_node_1 @uc_quorum_0)
)

(model N4
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_quorum_0 quorum) (@uc_value_0 value))
  (leader @uc_node_1)
  (member @uc_node_0 @uc_quorum_0)
  (member @uc_node_1 @uc_quorum_0)
  (votes @uc_node_0 @uc_node_0)
  (votes @uc_node_0 @uc_node_1)
  (votes @uc_node_1 @uc_node_0)
)

(model N5
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_quorum_0 quorum) (@uc_value_0 value))
  (leader @uc_node_1)
  (member @uc_node_0 @uc_quorum_0)
  (member @uc_node_1 @uc_quorum_0)
  (votes @uc_node_1 @uc_node_0)
)

(constraint P0 P1 P2 (not N0) (not N1) (not N2) (not N3) (not N4) (not N5))
