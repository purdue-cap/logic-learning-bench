; File: good-ivy-examples/pldi16/leader_election_ring_btw_nonreflexive.ivy

; Sig
(sort id)
(sort node)
(function idn node id)
(relation le id id)
(relation leader node)
(relation pending id node)
(relation ring.btw node node node)
; End sig

; Axiom ring
(axiom (forall W node (forall Y node (forall X node (forall Z node (or (not (and (ring.btw W X Y) (ring.btw W Y Z))) (ring.btw W X Z)))))))
; Axiom ring0
(axiom (forall W node (forall Y node (forall X node (or (not (ring.btw W X Y)) (not (ring.btw W Y X)))))))
; Axiom ring1
(axiom (forall W node (forall Y node (forall X node (or (or (or (or (ring.btw W X Y) (ring.btw W Y X)) (= W X)) (= W Y)) (= X Y))))))
; Axiom ring2
(axiom (forall Y node (forall X node (forall Z node (or (not (ring.btw X Y Z)) (ring.btw Y Z X))))))
; Axiom a
(axiom (forall X id (le X X)))
; Axiom a0
(axiom (forall X id (forall Z id (forall Y id (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom a1
(axiom (forall X id (forall Y id (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom a2
(axiom (forall X id (forall Y id (or (le X Y) (le Y X)))))
; Axiom a3
(axiom (forall Y node (forall X node (or (not (= (idn X) (idn Y))) (= X Y)))))


; Conjecture c1
(conjecture (forall N0 node (forall N1 node (forall N2 node (not (and (and (le (idn N2) (idn N0)) (pending (idn N2) N1)) (ring.btw N0 N1 N2)))))))

(model P0
  ((@id_0 id) (@node_0 node))
  (le @id_0 @id_0)
  (pending @id_0 @node_0)
  (= (idn @node_0) @id_0)
)
(model N1
  ((@id_0 id) (@id_1 id) (@id_2 id) (@node_0 node) (@node_1 node) (@node_2 node))
  (le @id_0 @id_0)
  (le @id_0 @id_2)
  (le @id_1 @id_0)
  (le @id_1 @id_1)
  (le @id_1 @id_2)
  (le @id_2 @id_2)
  (pending @id_0 @node_0)
  (pending @id_0 @node_1)
  (pending @id_0 @node_2)
  (pending @id_1 @node_0)
  (pending @id_1 @node_1)
  (pending @id_1 @node_2)
  (pending @id_2 @node_0)
  (pending @id_2 @node_1)
  (pending @id_2 @node_2)
  (ring.btw @node_0 @node_2 @node_1)
  (ring.btw @node_1 @node_0 @node_2)
  (ring.btw @node_2 @node_1 @node_0)
  (= (idn @node_0) @id_1)
  (= (idn @node_1) @id_2)
  (= (idn @node_2) @id_0)
)
(model P2
  ((@id_0 id) (@id_1 id) (@node_0 node))
  (le @id_0 @id_0)
  (le @id_0 @id_1)
  (le @id_1 @id_1)
  (pending @id_0 @node_0)
  (pending @id_1 @node_0)
  (= (idn @node_0) @id_0)
)
(model P3
  ((@id_0 id) (@id_1 id) (@node_0 node) (@node_1 node))
  (le @id_0 @id_0)
  (le @id_0 @id_1)
  (le @id_1 @id_1)
  (pending @id_0 @node_0)
  (pending @id_0 @node_1)
  (pending @id_1 @node_0)
  (pending @id_1 @node_1)
  (= (idn @node_0) @id_0)
  (= (idn @node_1) @id_1)
)
(model P4
  ((@id_0 id) (@id_1 id) (@id_2 id) (@node_0 node))
  (le @id_0 @id_0)
  (le @id_0 @id_1)
  (le @id_1 @id_1)
  (le @id_2 @id_0)
  (le @id_2 @id_1)
  (le @id_2 @id_2)
  (pending @id_0 @node_0)
  (pending @id_1 @node_0)
  (pending @id_2 @node_0)
  (= (idn @node_0) @id_1)
)
(model P5
  ((@id_0 id) (@id_1 id) (@id_2 id) (@node_0 node) (@node_1 node) (@node_2 node))
  (le @id_0 @id_0)
  (le @id_0 @id_1)
  (le @id_0 @id_2)
  (le @id_1 @id_1)
  (le @id_2 @id_1)
  (le @id_2 @id_2)
  (pending @id_0 @node_0)
  (pending @id_0 @node_1)
  (pending @id_1 @node_0)
  (pending @id_1 @node_1)
  (pending @id_1 @node_2)
  (pending @id_2 @node_1)
  (pending @id_2 @node_2)
  (ring.btw @node_0 @node_1 @node_2)
  (ring.btw @node_1 @node_2 @node_0)
  (ring.btw @node_2 @node_0 @node_1)
  (= (idn @node_0) @id_0)
  (= (idn @node_1) @id_2)
  (= (idn @node_2) @id_1)
)
(model N6
  ((@id_0 id) (@id_1 id) (@id_2 id) (@node_0 node) (@node_1 node) (@node_2 node))
  (le @id_0 @id_0)
  (le @id_0 @id_1)
  (le @id_1 @id_1)
  (le @id_2 @id_0)
  (le @id_2 @id_1)
  (le @id_2 @id_2)
  (pending @id_0 @node_0)
  (pending @id_0 @node_1)
  (pending @id_0 @node_2)
  (pending @id_1 @node_2)
  (pending @id_2 @node_0)
  (pending @id_2 @node_1)
  (pending @id_2 @node_2)
  (ring.btw @node_0 @node_2 @node_1)
  (ring.btw @node_1 @node_0 @node_2)
  (ring.btw @node_2 @node_1 @node_0)
  (= (idn @node_0) @id_0)
  (= (idn @node_1) @id_2)
  (= (idn @node_2) @id_1)
)
(model N7
  ((@id_0 id) (@id_1 id) (@id_2 id) (@node_0 node) (@node_1 node) (@node_2 node))
  (le @id_0 @id_0)
  (le @id_0 @id_2)
  (le @id_1 @id_0)
  (le @id_1 @id_1)
  (le @id_1 @id_2)
  (le @id_2 @id_2)
  (pending @id_0 @node_0)
  (pending @id_0 @node_1)
  (pending @id_1 @node_0)
  (pending @id_1 @node_1)
  (pending @id_2 @node_0)
  (pending @id_2 @node_1)
  (pending @id_2 @node_2)
  (ring.btw @node_0 @node_2 @node_1)
  (ring.btw @node_1 @node_0 @node_2)
  (ring.btw @node_2 @node_1 @node_0)
  (= (idn @node_0) @id_0)
  (= (idn @node_1) @id_1)
  (= (idn @node_2) @id_2)
)
(model N8
  ((@id_0 id) (@id_1 id) (@id_2 id) (@node_0 node) (@node_1 node) (@node_2 node))
  (le @id_0 @id_0)
  (le @id_1 @id_0)
  (le @id_1 @id_1)
  (le @id_1 @id_2)
  (le @id_2 @id_0)
  (le @id_2 @id_2)
  (pending @id_0 @node_0)
  (pending @id_0 @node_1)
  (pending @id_0 @node_2)
  (pending @id_1 @node_0)
  (pending @id_1 @node_1)
  (pending @id_1 @node_2)
  (pending @id_2 @node_1)
  (pending @id_2 @node_2)
  (ring.btw @node_0 @node_2 @node_1)
  (ring.btw @node_1 @node_0 @node_2)
  (ring.btw @node_2 @node_1 @node_0)
  (= (idn @node_0) @id_1)
  (= (idn @node_1) @id_2)
  (= (idn @node_2) @id_0)
)
(model N9
  ((@id_0 id) (@id_1 id) (@id_2 id) (@node_0 node) (@node_1 node) (@node_2 node))
  (le @id_0 @id_0)
  (le @id_1 @id_0)
  (le @id_1 @id_1)
  (le @id_2 @id_0)
  (le @id_2 @id_1)
  (le @id_2 @id_2)
  (pending @id_0 @node_0)
  (pending @id_0 @node_1)
  (pending @id_0 @node_2)
  (pending @id_1 @node_0)
  (pending @id_1 @node_1)
  (pending @id_1 @node_2)
  (pending @id_2 @node_1)
  (ring.btw @node_0 @node_2 @node_1)
  (ring.btw @node_1 @node_0 @node_2)
  (ring.btw @node_2 @node_1 @node_0)
  (= (idn @node_0) @id_1)
  (= (idn @node_1) @id_2)
  (= (idn @node_2) @id_0)
)

(constraint P0 (not N1) P2 P3 P4 P5 (not N6) (not N7) (not N8) (not N9))
