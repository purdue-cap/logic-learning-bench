; File: examples/fol/learning_switch.pyv

; Sig
(sort node)
(relation pending node node node node)
(relation table node node node)
; End sig

; Axioms

; Conjecture c2
(conjecture (forall T node (forall X node (forall Y node (or (not (and (table T X Y) (table T Y X))) (= X Y))))))



(model P0
  ((@uc_node_0 node))
  (table @uc_node_0 @uc_node_0 @uc_node_0)
)

(model N0
  ((@uc_node_0 node) (@uc_node_1 node))
  (table @uc_node_0 @uc_node_0 @uc_node_0)
  (table @uc_node_0 @uc_node_0 @uc_node_1)
  (table @uc_node_0 @uc_node_1 @uc_node_0)
  (table @uc_node_0 @uc_node_1 @uc_node_1)
  (table @uc_node_1 @uc_node_0 @uc_node_0)
  (table @uc_node_1 @uc_node_0 @uc_node_1)
  (table @uc_node_1 @uc_node_1 @uc_node_0)
  (table @uc_node_1 @uc_node_1 @uc_node_1)
)

(model P1
  ((@uc_node_0 node) (@uc_node_1 node))
  (table @uc_node_0 @uc_node_0 @uc_node_0)
  (table @uc_node_0 @uc_node_1 @uc_node_1)
  (table @uc_node_1 @uc_node_0 @uc_node_0)
  (table @uc_node_1 @uc_node_1 @uc_node_1)
)

(model N1
  ((@uc_node_0 node) (@uc_node_1 node))
  (table @uc_node_0 @uc_node_0 @uc_node_1)
  (table @uc_node_0 @uc_node_1 @uc_node_0)
)

(model N2
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_node_2 node))
  (table @uc_node_0 @uc_node_0 @uc_node_0)
  (table @uc_node_0 @uc_node_1 @uc_node_0)
  (table @uc_node_0 @uc_node_1 @uc_node_1)
  (table @uc_node_0 @uc_node_1 @uc_node_2)
  (table @uc_node_0 @uc_node_2 @uc_node_0)
  (table @uc_node_0 @uc_node_2 @uc_node_1)
  (table @uc_node_0 @uc_node_2 @uc_node_2)
  (table @uc_node_1 @uc_node_0 @uc_node_0)
  (table @uc_node_1 @uc_node_0 @uc_node_1)
  (table @uc_node_1 @uc_node_0 @uc_node_2)
  (table @uc_node_1 @uc_node_1 @uc_node_1)
  (table @uc_node_1 @uc_node_2 @uc_node_0)
  (table @uc_node_1 @uc_node_2 @uc_node_1)
  (table @uc_node_1 @uc_node_2 @uc_node_2)
  (table @uc_node_2 @uc_node_0 @uc_node_0)
  (table @uc_node_2 @uc_node_0 @uc_node_1)
  (table @uc_node_2 @uc_node_0 @uc_node_2)
  (table @uc_node_2 @uc_node_1 @uc_node_0)
  (table @uc_node_2 @uc_node_1 @uc_node_1)
  (table @uc_node_2 @uc_node_1 @uc_node_2)
  (table @uc_node_2 @uc_node_2 @uc_node_2)
)

(model N3
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_node_2 node))
  (table @uc_node_0 @uc_node_0 @uc_node_0)
  (table @uc_node_0 @uc_node_0 @uc_node_1)
  (table @uc_node_0 @uc_node_0 @uc_node_2)
  (table @uc_node_0 @uc_node_1 @uc_node_1)
  (table @uc_node_0 @uc_node_1 @uc_node_2)
  (table @uc_node_0 @uc_node_2 @uc_node_1)
  (table @uc_node_0 @uc_node_2 @uc_node_2)
  (table @uc_node_1 @uc_node_0 @uc_node_0)
  (table @uc_node_1 @uc_node_0 @uc_node_2)
  (table @uc_node_1 @uc_node_1 @uc_node_0)
  (table @uc_node_1 @uc_node_1 @uc_node_1)
  (table @uc_node_1 @uc_node_1 @uc_node_2)
  (table @uc_node_1 @uc_node_2 @uc_node_0)
  (table @uc_node_1 @uc_node_2 @uc_node_2)
  (table @uc_node_2 @uc_node_0 @uc_node_0)
  (table @uc_node_2 @uc_node_0 @uc_node_1)
  (table @uc_node_2 @uc_node_1 @uc_node_0)
  (table @uc_node_2 @uc_node_1 @uc_node_1)
  (table @uc_node_2 @uc_node_2 @uc_node_0)
  (table @uc_node_2 @uc_node_2 @uc_node_1)
  (table @uc_node_2 @uc_node_2 @uc_node_2)
)

(model N4
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_node_2 node))
  (table @uc_node_0 @uc_node_0 @uc_node_0)
  (table @uc_node_0 @uc_node_0 @uc_node_1)
  (table @uc_node_0 @uc_node_0 @uc_node_2)
  (table @uc_node_0 @uc_node_1 @uc_node_1)
  (table @uc_node_0 @uc_node_1 @uc_node_2)
  (table @uc_node_0 @uc_node_2 @uc_node_1)
  (table @uc_node_0 @uc_node_2 @uc_node_2)
  (table @uc_node_1 @uc_node_0 @uc_node_0)
  (table @uc_node_1 @uc_node_0 @uc_node_1)
  (table @uc_node_1 @uc_node_0 @uc_node_2)
  (table @uc_node_1 @uc_node_1 @uc_node_1)
  (table @uc_node_1 @uc_node_1 @uc_node_2)
  (table @uc_node_1 @uc_node_2 @uc_node_0)
  (table @uc_node_1 @uc_node_2 @uc_node_1)
  (table @uc_node_1 @uc_node_2 @uc_node_2)
  (table @uc_node_2 @uc_node_0 @uc_node_0)
  (table @uc_node_2 @uc_node_0 @uc_node_1)
  (table @uc_node_2 @uc_node_0 @uc_node_2)
  (table @uc_node_2 @uc_node_1 @uc_node_0)
  (table @uc_node_2 @uc_node_1 @uc_node_1)
  (table @uc_node_2 @uc_node_1 @uc_node_2)
  (table @uc_node_2 @uc_node_2 @uc_node_1)
  (table @uc_node_2 @uc_node_2 @uc_node_2)
)

(model N5
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_node_2 node))
  (table @uc_node_0 @uc_node_0 @uc_node_0)
  (table @uc_node_0 @uc_node_1 @uc_node_1)
  (table @uc_node_0 @uc_node_1 @uc_node_2)
  (table @uc_node_0 @uc_node_2 @uc_node_1)
  (table @uc_node_0 @uc_node_2 @uc_node_2)
  (table @uc_node_1 @uc_node_0 @uc_node_0)
  (table @uc_node_1 @uc_node_0 @uc_node_2)
  (table @uc_node_1 @uc_node_1 @uc_node_1)
  (table @uc_node_1 @uc_node_2 @uc_node_0)
  (table @uc_node_1 @uc_node_2 @uc_node_2)
  (table @uc_node_2 @uc_node_0 @uc_node_0)
  (table @uc_node_2 @uc_node_0 @uc_node_1)
  (table @uc_node_2 @uc_node_1 @uc_node_0)
  (table @uc_node_2 @uc_node_1 @uc_node_1)
  (table @uc_node_2 @uc_node_2 @uc_node_2)
)

(constraint P0 P1 (not N0) (not N1) (not N2) (not N3) (not N4) (not N5))
