; File: examples/fol/bosco_3t_safety.pyv

; Sig
(sort node)
(sort quorum_a)
(sort quorum_b)
(sort quorum_c)
(sort value)
(relation dec node value)
(relation done node)
(relation input node value)
(relation member_a node quorum_a)
(relation member_b node quorum_b)
(relation member_c node quorum_c)
(relation member_f node)
(relation rcv_msg node node value)
(relation rcv_msg_proj node node)
(relation sent_msg node node value)
(relation sent_msg_proj node node)
(relation und_cons node value)
(relation und_cons_dec value)
; End sig

; Axioms
(axiom (forall A quorum_a (forall B quorum_b (exists C quorum_c (forall N node (or (not (member_c N C)) (and (member_a N A) (member_b N B) (not (member_f N)))))))))
(axiom (forall B quorum_b (forall C quorum_c (exists N node (and (member_b N B) (member_c N C) (not (member_f N)))))))
(axiom (forall N node (forall V1 value (forall V2 value (or (not (and (not (member_f N)) (input N V1) (input N V2))) (= V1 V2))))))

; Conjecture c1
(conjecture (forall N1 node (forall N2 node (forall V value (or (not (rcv_msg N1 N2 V)) (rcv_msg_proj N1 N2))))))



(model P0
  ((@uc_node_0 node) (@uc_quorum_a_0 quorum_a) (@uc_value_0 value) (@uc_quorum_c_0 quorum_c) (@uc_quorum_b_0 quorum_b))
  (input @uc_node_0 @uc_value_0)
  (member_a @uc_node_0 @uc_quorum_a_0)
  (member_b @uc_node_0 @uc_quorum_b_0)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (rcv_msg @uc_node_0 @uc_node_0 @uc_value_0)
  (rcv_msg_proj @uc_node_0 @uc_node_0)
)

(model N0
  ((@uc_node_0 node) (@uc_quorum_a_0 quorum_a) (@uc_value_0 value) (@uc_quorum_c_0 quorum_c) (@uc_quorum_b_0 quorum_b))
  (input @uc_node_0 @uc_value_0)
  (member_a @uc_node_0 @uc_quorum_a_0)
  (member_b @uc_node_0 @uc_quorum_b_0)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (rcv_msg @uc_node_0 @uc_node_0 @uc_value_0)
)

(model N1
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_quorum_a_0 quorum_a) (@uc_value_0 value) (@uc_quorum_c_0 quorum_c) (@uc_quorum_b_0 quorum_b))
  (input @uc_node_0 @uc_value_0)
  (input @uc_node_1 @uc_value_0)
  (member_a @uc_node_0 @uc_quorum_a_0)
  (member_a @uc_node_1 @uc_quorum_a_0)
  (member_b @uc_node_0 @uc_quorum_b_0)
  (member_b @uc_node_1 @uc_quorum_b_0)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (member_c @uc_node_1 @uc_quorum_c_0)
  (rcv_msg @uc_node_0 @uc_node_0 @uc_value_0)
  (rcv_msg @uc_node_0 @uc_node_1 @uc_value_0)
  (rcv_msg @uc_node_1 @uc_node_0 @uc_value_0)
  (rcv_msg @uc_node_1 @uc_node_1 @uc_value_0)
  (rcv_msg_proj @uc_node_1 @uc_node_1)
)

(model N2
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_quorum_a_0 quorum_a) (@uc_value_0 value) (@uc_quorum_c_0 quorum_c) (@uc_quorum_b_0 quorum_b))
  (input @uc_node_0 @uc_value_0)
  (input @uc_node_1 @uc_value_0)
  (member_a @uc_node_0 @uc_quorum_a_0)
  (member_a @uc_node_1 @uc_quorum_a_0)
  (member_b @uc_node_0 @uc_quorum_b_0)
  (member_b @uc_node_1 @uc_quorum_b_0)
  (member_c @uc_node_1 @uc_quorum_c_0)
  (member_f @uc_node_0)
  (rcv_msg @uc_node_0 @uc_node_0 @uc_value_0)
  (rcv_msg @uc_node_0 @uc_node_1 @uc_value_0)
  (rcv_msg @uc_node_1 @uc_node_0 @uc_value_0)
  (rcv_msg @uc_node_1 @uc_node_1 @uc_value_0)
  (rcv_msg_proj @uc_node_0 @uc_node_0)
  (rcv_msg_proj @uc_node_0 @uc_node_1)
  (rcv_msg_proj @uc_node_1 @uc_node_1)
)

(model P1
  ((@uc_node_0 node) (@uc_quorum_a_0 quorum_a) (@uc_value_0 value) (@uc_quorum_c_0 quorum_c) (@uc_quorum_b_0 quorum_b))
  (input @uc_node_0 @uc_value_0)
  (member_a @uc_node_0 @uc_quorum_a_0)
  (member_b @uc_node_0 @uc_quorum_b_0)
  (member_c @uc_node_0 @uc_quorum_c_0)
)

(model N3
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_quorum_a_0 quorum_a) (@uc_value_0 value) (@uc_quorum_c_0 quorum_c) (@uc_quorum_b_0 quorum_b))
  (input @uc_node_0 @uc_value_0)
  (input @uc_node_1 @uc_value_0)
  (member_a @uc_node_0 @uc_quorum_a_0)
  (member_a @uc_node_1 @uc_quorum_a_0)
  (member_b @uc_node_0 @uc_quorum_b_0)
  (member_b @uc_node_1 @uc_quorum_b_0)
  (member_c @uc_node_1 @uc_quorum_c_0)
  (rcv_msg @uc_node_0 @uc_node_0 @uc_value_0)
  (rcv_msg @uc_node_0 @uc_node_1 @uc_value_0)
  (rcv_msg @uc_node_1 @uc_node_0 @uc_value_0)
  (rcv_msg_proj @uc_node_0 @uc_node_0)
  (rcv_msg_proj @uc_node_0 @uc_node_1)
  (rcv_msg_proj @uc_node_1 @uc_node_1)
)

(model N4
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_quorum_a_0 quorum_a) (@uc_value_0 value) (@uc_quorum_c_0 quorum_c) (@uc_quorum_b_0 quorum_b))
  (input @uc_node_0 @uc_value_0)
  (input @uc_node_1 @uc_value_0)
  (member_a @uc_node_0 @uc_quorum_a_0)
  (member_a @uc_node_1 @uc_quorum_a_0)
  (member_b @uc_node_0 @uc_quorum_b_0)
  (member_b @uc_node_1 @uc_quorum_b_0)
  (member_c @uc_node_1 @uc_quorum_c_0)
  (rcv_msg @uc_node_0 @uc_node_0 @uc_value_0)
  (rcv_msg @uc_node_0 @uc_node_1 @uc_value_0)
  (rcv_msg @uc_node_1 @uc_node_0 @uc_value_0)
  (rcv_msg_proj @uc_node_0 @uc_node_0)
  (rcv_msg_proj @uc_node_0 @uc_node_1)
)

(constraint P0 P1 (not N0) (not N1) (not N2) (not N3) (not N4))
