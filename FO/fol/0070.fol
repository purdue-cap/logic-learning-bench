; File: good-ivy-examples/fol-thresholds/bosco_oded_7t_safety.ivy

; Sig
(sort node)
(sort quorum_a)
(sort quorum_b)
(sort quorum_c)
(sort value)
(relation dec node value)
(relation done node)
(relation input node value)
(relation member_a node quorum_a)
(relation member_b node quorum_b)
(relation member_c node quorum_c)
(relation member_f node)
(relation rcv_msg node node value)
(relation rcv_msg_proj node node)
(relation sent_msg node node value)
(relation sent_msg_proj node node)
(relation und_cons node value)
(relation und_cons_dec value)
; End sig

; Axiom a
(axiom (forall B quorum_b (forall A quorum_a (exists C quorum_c (forall N node (or (not (member_c N C)) (and (and (member_a N A) (member_b N B)) (not (member_f N)))))))))
; Axiom a0
(axiom (forall C quorum_c (forall B quorum_b (exists N node (and (and (member_b N B) (member_c N C)) (not (member_f N)))))))
; Axiom a1
(axiom (forall A quorum_a (exists B quorum_b (forall N node (or (not (member_b N B)) (and (member_a N A) (not (member_f N))))))))
; Axiom a2
(axiom (forall N node (forall V1 value (forall V2 value (or (not (and (and (not (member_f N)) (input N V1)) (input N V2))) (= V1 V2))))))


; Conjecture c12
(conjecture (forall N node (forall V value (or (not (and (and (not (member_f N)) (done N)) (not (und_cons N V)))) (not (exists B quorum_b (forall M node (or (not (and (member_b M B) (not (member_f M)))) (sent_msg M M V)))))))))

(model P0
  ((@node_0 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b) (@quorum_c_0 quorum_c) (@value_0 value))
  (done @node_0)
  (input @node_0 @value_0)
  (member_a @node_0 @quorum_a_0)
  (member_b @node_0 @quorum_b_0)
  (member_c @node_0 @quorum_c_0)
  (sent_msg @node_0 @node_0 @value_0)
  (und_cons @node_0 @value_0)
)
(model N1
  ((@node_0 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b) (@quorum_c_0 quorum_c) (@value_0 value))
  (done @node_0)
  (input @node_0 @value_0)
  (member_a @node_0 @quorum_a_0)
  (member_b @node_0 @quorum_b_0)
  (member_c @node_0 @quorum_c_0)
  (sent_msg @node_0 @node_0 @value_0)
)
(model N2
  ((@node_0 node) (@node_1 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b) (@quorum_c_0 quorum_c) (@value_0 value))
  (done @node_0)
  (done @node_1)
  (input @node_0 @value_0)
  (input @node_1 @value_0)
  (member_a @node_0 @quorum_a_0)
  (member_a @node_1 @quorum_a_0)
  (member_b @node_0 @quorum_b_0)
  (member_b @node_1 @quorum_b_0)
  (member_c @node_0 @quorum_c_0)
  (member_c @node_1 @quorum_c_0)
  (sent_msg @node_0 @node_0 @value_0)
  (sent_msg @node_0 @node_1 @value_0)
  (sent_msg @node_1 @node_0 @value_0)
  (sent_msg @node_1 @node_1 @value_0)
  (und_cons @node_0 @value_0)
)
(model N3
  ((@node_0 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b) (@quorum_c_0 quorum_c) (@value_0 value) (@value_1 value))
  (done @node_0)
  (input @node_0 @value_0)
  (member_a @node_0 @quorum_a_0)
  (member_b @node_0 @quorum_b_0)
  (member_c @node_0 @quorum_c_0)
  (sent_msg @node_0 @node_0 @value_0)
  (sent_msg @node_0 @node_0 @value_1)
  (und_cons @node_0 @value_1)
)
(model P4
  ((@node_0 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b) (@quorum_c_0 quorum_c) (@value_0 value))
  (input @node_0 @value_0)
  (member_a @node_0 @quorum_a_0)
  (member_b @node_0 @quorum_b_0)
  (member_c @node_0 @quorum_c_0)
  (sent_msg @node_0 @node_0 @value_0)
)
(model P5
  ((@node_0 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b) (@quorum_c_0 quorum_c) (@value_0 value))
  (done @node_0)
  (input @node_0 @value_0)
  (member_a @node_0 @quorum_a_0)
  (member_b @node_0 @quorum_b_0)
  (member_c @node_0 @quorum_c_0)
)
(model N6
  ((@node_0 node) (@node_1 node) (@quorum_a_0 quorum_a) (@quorum_b_0 quorum_b) (@quorum_c_0 quorum_c) (@value_0 value))
  (done @node_0)
  (input @node_0 @value_0)
  (input @node_1 @value_0)
  (member_a @node_0 @quorum_a_0)
  (member_a @node_1 @quorum_a_0)
  (member_b @node_1 @quorum_b_0)
  (member_c @node_1 @quorum_c_0)
  (sent_msg @node_1 @node_1 @value_0)
)

(constraint P0 (not N1) (not N2) (not N3) P4 P5 (not N6))
