(function tlb.userpmap tlb.processor tlb.pmap)
(function tlb.writepmap tlb.processor tlb.pmap)
; End sig



; Conjecture tlb21
(conjecture (forall C tlb.processor (or (not (and (not (= (tlb.tlb C) (tlb.pentry (tlb.userpmap C)))) (not (tlb.pc_b1 C)))) (or (or (tlb.interrupt C) (or (or (or (tlb.pc_r1 C) (tlb.pc_r2 C)) (tlb.pc_r3 C)) (tlb.pc_r5 C))) (and (tlb.pc_i12 C) (= (tlb.writepmap C) (tlb.userpmap C)))))))



