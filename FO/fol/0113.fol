  (tlb.pc_b1 @uc_tlb.processor_0)
  (tlb.pc_i4 @uc_tlb.processor_0)
  (tlb.pc_i5 @uc_tlb.processor_0)
  (tlb.pc_i6 @uc_tlb.processor_0)
  (tlb.pc_r5 @uc_tlb.processor_0)
  (tlb.pc_r6 @uc_tlb.processor_0)
  (tlb.todo @uc_tlb.processor_0 @uc_tlb.processor_0)
  (= (tlb.pentry @uc_tlb.pmap_0) @uc_tlb.pageentry_0)
  (= (tlb.tlb @uc_tlb.processor_0) @uc_tlb.pageentry_0)
  (= (tlb.userpmap @uc_tlb.processor_0) @uc_tlb.pmap_0)
  (= (tlb.writepmap @uc_tlb.processor_0) @uc_tlb.pmap_0)
)

