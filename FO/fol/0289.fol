; File: examples/fol/ticket.pyv

; Sig
(sort thread)
(sort ticket)
(constant next_ticket ticket)
(constant service ticket)
(constant zero ticket)
(relation le ticket ticket)
(relation m thread ticket)
(relation pc1 thread)
(relation pc2 thread)
(relation pc3 thread)
; End sig

; Axioms
(axiom (forall X ticket (le X X)))
(axiom (forall X ticket (forall Y ticket (forall Z ticket (or (not (and (le X Y) (le Y Z))) (le X Z))))))
(axiom (forall X ticket (forall Y ticket (or (not (and (le X Y) (le Y X))) (= X Y)))))
(axiom (forall X ticket (forall Y ticket (or (le X Y) (le Y X)))))
(axiom (forall X ticket (le zero X)))

; Conjecture c12
(conjecture (forall T1 thread (forall T2 thread (not (and (not (pc1 T1)) (not (pc1 T2)) (m T1 zero) (m T2 zero) (not (= T1 T2)))))))



(model P0
  ((@uc_ticket_0 ticket) (@uc_thread_0 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
  (m @uc_thread_0 @uc_ticket_0)
  (pc1 @uc_thread_0)
)

(model N0
  ((@uc_ticket_0 ticket) (@uc_thread_0 thread) (@uc_thread_1 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
  (m @uc_thread_0 @uc_ticket_0)
  (m @uc_thread_1 @uc_ticket_0)
)

(model N1
  ((@uc_ticket_0 ticket) (@uc_thread_0 thread) (@uc_thread_1 thread) (@uc_thread_2 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
  (m @uc_thread_0 @uc_ticket_0)
  (m @uc_thread_1 @uc_ticket_0)
  (m @uc_thread_2 @uc_ticket_0)
  (pc1 @uc_thread_0)
)

(model P1
  ((@uc_ticket_0 ticket) (@uc_thread_0 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
  (m @uc_thread_0 @uc_ticket_0)
)

(model P2
  ((@uc_ticket_0 ticket) (@uc_thread_0 thread) (@uc_thread_1 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
  (m @uc_thread_0 @uc_ticket_0)
  (m @uc_thread_1 @uc_ticket_0)
  (pc1 @uc_thread_0)
  (pc1 @uc_thread_1)
)

(model P3
  ((@uc_ticket_0 ticket) (@uc_thread_0 thread) (@uc_thread_1 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
)

(model N2
  ((@uc_ticket_0 ticket) (@uc_ticket_1 ticket) (@uc_thread_0 thread) (@uc_thread_1 thread))
  (= next_ticket @uc_ticket_1)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_1)
  (le @uc_ticket_1 @uc_ticket_1)
  (m @uc_thread_0 @uc_ticket_0)
  (m @uc_thread_1 @uc_ticket_0)
)

(model N3
  ((@uc_ticket_0 ticket) (@uc_ticket_1 ticket) (@uc_thread_0 thread) (@uc_thread_1 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_1)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_1)
  (le @uc_ticket_1 @uc_ticket_1)
  (m @uc_thread_0 @uc_ticket_0)
  (m @uc_thread_1 @uc_ticket_0)
)

(constraint P0 P1 P2 P3 (not N0) (not N1) (not N2) (not N3))
