; File: examples/fol/ticket.pyv

; Sig
(sort thread)
(sort ticket)
(constant next_ticket ticket)
(constant service ticket)
(constant zero ticket)
(relation le ticket ticket)
(relation m thread ticket)
(relation pc1 thread)
(relation pc2 thread)
(relation pc3 thread)
; End sig

; Axioms
(axiom (forall X ticket (le X X)))
(axiom (forall X ticket (forall Y ticket (forall Z ticket (or (not (and (le X Y) (le Y Z))) (le X Z))))))
(axiom (forall X ticket (forall Y ticket (or (not (and (le X Y) (le Y X))) (= X Y)))))
(axiom (forall X ticket (forall Y ticket (or (le X Y) (le Y X)))))
(axiom (forall X ticket (le zero X)))

; Conjecture c4
(conjecture (forall T thread (forall K1 ticket (forall K2 ticket (or (not (and (m T K1) (m T K2))) (= K1 K2))))))



(model P0
  ((@uc_ticket_0 ticket) (@uc_thread_0 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
  (m @uc_thread_0 @uc_ticket_0)
)

(model N0
  ((@uc_ticket_0 ticket) (@uc_ticket_1 ticket) (@uc_thread_0 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_1)
  (le @uc_ticket_0 @uc_ticket_0)
  (le @uc_ticket_1 @uc_ticket_0)
  (le @uc_ticket_1 @uc_ticket_1)
  (m @uc_thread_0 @uc_ticket_0)
  (m @uc_thread_0 @uc_ticket_1)
)

(model N1
  ((@uc_ticket_0 ticket) (@uc_ticket_1 ticket) (@uc_thread_0 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_1)
  (= zero @uc_ticket_1)
  (le @uc_ticket_0 @uc_ticket_0)
  (le @uc_ticket_1 @uc_ticket_0)
  (le @uc_ticket_1 @uc_ticket_1)
  (m @uc_thread_0 @uc_ticket_0)
  (m @uc_thread_0 @uc_ticket_1)
)

(model N2
  ((@uc_ticket_0 ticket) (@uc_ticket_1 ticket) (@uc_thread_0 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_1)
  (le @uc_ticket_1 @uc_ticket_1)
  (m @uc_thread_0 @uc_ticket_0)
  (m @uc_thread_0 @uc_ticket_1)
)

(model P1
  ((@uc_ticket_0 ticket) (@uc_ticket_1 ticket) (@uc_thread_0 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_1)
  (le @uc_ticket_0 @uc_ticket_0)
  (le @uc_ticket_1 @uc_ticket_0)
  (le @uc_ticket_1 @uc_ticket_1)
)

(model N3
  ((@uc_ticket_0 ticket) (@uc_ticket_1 ticket) (@uc_thread_0 thread) (@uc_thread_1 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_1)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_1)
  (le @uc_ticket_1 @uc_ticket_1)
  (m @uc_thread_0 @uc_ticket_0)
  (m @uc_thread_0 @uc_ticket_1)
)

(model P2
  ((@uc_ticket_0 ticket) (@uc_ticket_1 ticket) (@uc_thread_0 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_1)
  (le @uc_ticket_0 @uc_ticket_0)
  (le @uc_ticket_1 @uc_ticket_0)
  (le @uc_ticket_1 @uc_ticket_1)
  (m @uc_thread_0 @uc_ticket_1)
)

(model N4
  ((@uc_ticket_0 ticket) (@uc_ticket_1 ticket) (@uc_ticket_2 ticket) (@uc_thread_0 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_1)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_1)
  (le @uc_ticket_0 @uc_ticket_2)
  (le @uc_ticket_1 @uc_ticket_1)
  (le @uc_ticket_2 @uc_ticket_1)
  (le @uc_ticket_2 @uc_ticket_2)
  (m @uc_thread_0 @uc_ticket_0)
  (m @uc_thread_0 @uc_ticket_2)
)

(model P3
  ((@uc_ticket_0 ticket) (@uc_ticket_1 ticket) (@uc_thread_0 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_1)
  (le @uc_ticket_1 @uc_ticket_1)
  (m @uc_thread_0 @uc_ticket_1)
)

(model N5
  ((@uc_ticket_0 ticket) (@uc_ticket_1 ticket) (@uc_ticket_2 ticket) (@uc_thread_0 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_1)
  (le @uc_ticket_0 @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_2)
  (le @uc_ticket_1 @uc_ticket_0)
  (le @uc_ticket_1 @uc_ticket_1)
  (le @uc_ticket_1 @uc_ticket_2)
  (le @uc_ticket_2 @uc_ticket_2)
  (m @uc_thread_0 @uc_ticket_1)
  (m @uc_thread_0 @uc_ticket_2)
)

(model N6
  ((@uc_ticket_0 ticket) (@uc_ticket_1 ticket) (@uc_ticket_2 ticket) (@uc_thread_0 thread))
  (= next_ticket @uc_ticket_0)
  (= service @uc_ticket_0)
  (= zero @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_0)
  (le @uc_ticket_0 @uc_ticket_1)
  (le @uc_ticket_0 @uc_ticket_2)
  (le @uc_ticket_1 @uc_ticket_1)
  (le @uc_ticket_2 @uc_ticket_1)
  (le @uc_ticket_2 @uc_ticket_2)
  (m @uc_thread_0 @uc_ticket_1)
  (m @uc_thread_0 @uc_ticket_2)
)

(constraint P0 P1 P2 P3 (not N0) (not N1) (not N2) (not N3) (not N4) (not N5) (not N6))
