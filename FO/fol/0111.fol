; Conjecture tlb13
(conjecture (forall P tlb.processor (or (and (tlb.active P) (or (or (or (or (or (or (tlb.pc_b1 P) (tlb.pc_m2 P)) (tlb.pc_m3 P)) (tlb.pc_m5 P)) (tlb.pc_i1 P)) (tlb.pc_r1 P)) (tlb.pc_r2 P))) (and (not (tlb.active P)) (not (or (or (or (or (or (or (tlb.pc_b1 P) (tlb.pc_m2 P)) (tlb.pc_m3 P)) (tlb.pc_m5 P)) (tlb.pc_i1 P)) (tlb.pc_r1 P)) (tlb.pc_r2 P)))))))



