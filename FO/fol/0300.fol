; File: good-ivy-examples/toy/toy_lock_inv.ivy

; Sig
(sort epoch)
(sort node)
(function ep node epoch)
(relation held node)
(relation le epoch epoch)
(relation locked epoch node)
(relation transfer epoch node)
(constant zero epoch)
; End sig

; Axiom axiom1
(axiom (forall X epoch (le X X)))
; Axiom axiom2
(axiom (forall Y epoch (forall Z epoch (forall X epoch (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom axiom3
(axiom (forall Y epoch (forall X epoch (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom axiom4
(axiom (forall Y epoch (forall X epoch (or (le X Y) (le Y X)))))
; Axiom axiom5
(axiom (forall X epoch (le zero X)))


; Conjecture conj12
(conjecture (forall N node (forall E epoch (forall M node (or (not (and (transfer E N) (not (le E (ep N))))) (not (le E (ep M))))))))

(model P0
  ((@epoch_0 epoch) (@node_0 node))
  (le @epoch_0 @epoch_0)
  (transfer @epoch_0 @node_0)
  (= zero @epoch_0)
  (= (ep @node_0) @epoch_0)
)
(model N1
  ((@epoch_0 epoch) (@epoch_1 epoch) (@node_0 node) (@node_1 node))
  (le @epoch_0 @epoch_0)
  (le @epoch_0 @epoch_1)
  (le @epoch_1 @epoch_1)
  (transfer @epoch_0 @node_0)
  (transfer @epoch_0 @node_1)
  (transfer @epoch_1 @node_0)
  (transfer @epoch_1 @node_1)
  (= zero @epoch_0)
  (= (ep @node_0) @epoch_0)
  (= (ep @node_1) @epoch_1)
)
(model P2
  ((@epoch_0 epoch) (@epoch_1 epoch) (@node_0 node))
  (le @epoch_0 @epoch_0)
  (le @epoch_0 @epoch_1)
  (le @epoch_1 @epoch_1)
  (transfer @epoch_0 @node_0)
  (transfer @epoch_1 @node_0)
  (= zero @epoch_0)
  (= (ep @node_0) @epoch_1)
)
(model P3
  ((@epoch_0 epoch) (@epoch_1 epoch) (@node_0 node) (@node_1 node))
  (le @epoch_0 @epoch_0)
  (le @epoch_0 @epoch_1)
  (le @epoch_1 @epoch_1)
  (transfer @epoch_0 @node_0)
  (transfer @epoch_0 @node_1)
  (transfer @epoch_1 @node_0)
  (= zero @epoch_0)
  (= (ep @node_0) @epoch_1)
  (= (ep @node_1) @epoch_0)
)
(model N4
  ((@epoch_0 epoch) (@epoch_1 epoch) (@node_0 node) (@node_1 node))
  (le @epoch_0 @epoch_0)
  (le @epoch_1 @epoch_0)
  (le @epoch_1 @epoch_1)
  (transfer @epoch_0 @node_0)
  (= zero @epoch_1)
  (= (ep @node_0) @epoch_1)
  (= (ep @node_1) @epoch_0)
)
(model N5
  ((@epoch_0 epoch) (@epoch_1 epoch) (@epoch_2 epoch) (@node_0 node) (@node_1 node))
  (le @epoch_0 @epoch_0)
  (le @epoch_0 @epoch_1)
  (le @epoch_1 @epoch_1)
  (le @epoch_2 @epoch_0)
  (le @epoch_2 @epoch_1)
  (le @epoch_2 @epoch_2)
  (transfer @epoch_0 @node_0)
  (= zero @epoch_2)
  (= (ep @node_0) @epoch_2)
  (= (ep @node_1) @epoch_1)
)
(model P6
  ((@epoch_0 epoch) (@epoch_1 epoch) (@node_0 node))
  (le @epoch_0 @epoch_0)
  (le @epoch_1 @epoch_0)
  (le @epoch_1 @epoch_1)
  (transfer @epoch_0 @node_0)
  (transfer @epoch_1 @node_0)
  (= zero @epoch_1)
  (= (ep @node_0) @epoch_1)
)
(model P7
  ((@epoch_0 epoch) (@epoch_1 epoch) (@epoch_2 epoch) (@node_0 node) (@node_1 node))
  (le @epoch_0 @epoch_0)
  (le @epoch_0 @epoch_1)
  (le @epoch_0 @epoch_2)
  (le @epoch_1 @epoch_1)
  (le @epoch_2 @epoch_1)
  (le @epoch_2 @epoch_2)
  (transfer @epoch_0 @node_0)
  (transfer @epoch_0 @node_1)
  (transfer @epoch_1 @node_0)
  (transfer @epoch_1 @node_1)
  (transfer @epoch_2 @node_1)
  (= zero @epoch_0)
  (= (ep @node_0) @epoch_0)
  (= (ep @node_1) @epoch_2)
)

(constraint P0 (not N1) P2 P3 (not N4) (not N5) P6 P7)
