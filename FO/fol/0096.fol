; File: good-ivy-examples/misc/chord-1s-nofail-liveness-epr-all-conjectures.ivy

; Sig
(sort chord.node)
(relation chord.bs.f chord.node chord.node)
(relation chord.bs.p chord.node chord.node chord.node)
(relation chord.live chord.node)
(relation chord.prd chord.node chord.node)
(relation chord.prd_proj chord.node)
(relation chord.ring.btw chord.node chord.node chord.node)
(relation chord.scheduled_rectify chord.node chord.node)
(relation chord.scheduled_stabilize chord.node chord.node)
(relation chord.stable )
(relation chord.started )
(constant chord.tp1.n0 chord.node)
; End sig

; Axiom chord_ring_cyclic
(axiom (forall Y chord.node (forall Z chord.node (forall X chord.node (or (not (chord.ring.btw X Y Z)) (chord.ring.btw Y Z X))))))
; Axiom chord_ring_transitive
(axiom (forall Y chord.node (forall W chord.node (forall Z chord.node (forall X chord.node (or (not (and (chord.ring.btw W X Y) (chord.ring.btw W Y Z))) (chord.ring.btw W X Z)))))))
; Axiom chord_ring_antisimmeric
(axiom (forall Y chord.node (forall Z chord.node (forall X chord.node (or (not (chord.ring.btw X Y Z)) (not (chord.ring.btw X Z Y)))))))
; Axiom chord_ring_total
(axiom (forall Y chord.node (forall Z chord.node (forall X chord.node (or (or (or (or (chord.ring.btw X Y Z) (chord.ring.btw X Z Y)) (= X Y)) (= X Z)) (= Y Z))))))


; Conjecture chord_bs0
(conjecture (forall Y chord.node (forall W chord.node (forall X chord.node (or (not (and (chord.bs.p W X Y) (chord.bs.p W Y X))) (= X Y))))))

(model P0
  ((@chord.node_0 chord.node))
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_0)
  (= chord.tp1.n0 @chord.node_0)
)
(model N1
  ((@chord.node_0 chord.node) (@chord.node_1 chord.node))
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_1)
  (chord.bs.p @chord.node_1 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_1)
  (= chord.tp1.n0 @chord.node_0)
)
(model P2
  ((@chord.node_0 chord.node) (@chord.node_1 chord.node))
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_1)
  (chord.bs.p @chord.node_1 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_1)
  (= chord.tp1.n0 @chord.node_1)
)
(model N3
  ((@chord.node_0 chord.node) (@chord.node_1 chord.node))
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_0)
  (= chord.tp1.n0 @chord.node_0)
)
(model N4
  ((@chord.node_0 chord.node) (@chord.node_1 chord.node))
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_1)
  (chord.bs.p @chord.node_1 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_0)
  (= chord.tp1.n0 @chord.node_1)
)
(model N5
  ((@chord.node_0 chord.node) (@chord.node_1 chord.node) (@chord.node_2 chord.node))
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_1)
  (chord.bs.p @chord.node_0 @chord.node_2 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_2 @chord.node_1)
  (chord.bs.p @chord.node_0 @chord.node_2 @chord.node_2)
  (chord.bs.p @chord.node_1 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_1)
  (chord.bs.p @chord.node_1 @chord.node_2 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_2 @chord.node_1)
  (chord.bs.p @chord.node_1 @chord.node_2 @chord.node_2)
  (chord.bs.p @chord.node_2 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_2 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_2 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_2 @chord.node_1 @chord.node_1)
  (chord.bs.p @chord.node_2 @chord.node_2 @chord.node_0)
  (chord.bs.p @chord.node_2 @chord.node_2 @chord.node_1)
  (chord.bs.p @chord.node_2 @chord.node_2 @chord.node_2)
  (chord.ring.btw @chord.node_0 @chord.node_1 @chord.node_2)
  (chord.ring.btw @chord.node_1 @chord.node_2 @chord.node_0)
  (chord.ring.btw @chord.node_2 @chord.node_0 @chord.node_1)
  (= chord.tp1.n0 @chord.node_2)
)
(model N6
  ((@chord.node_0 chord.node) (@chord.node_1 chord.node))
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_1)
  (chord.bs.p @chord.node_1 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_1)
  (= chord.tp1.n0 @chord.node_1)
)
(model N7
  ((@chord.node_0 chord.node) (@chord.node_1 chord.node) (@chord.node_2 chord.node))
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_2)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_1)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_2)
  (chord.bs.p @chord.node_0 @chord.node_2 @chord.node_1)
  (chord.bs.p @chord.node_0 @chord.node_2 @chord.node_2)
  (chord.bs.p @chord.node_1 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_0 @chord.node_2)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_1)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_2)
  (chord.bs.p @chord.node_1 @chord.node_2 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_2 @chord.node_2)
  (chord.bs.p @chord.node_2 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_2 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_2 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_2 @chord.node_1 @chord.node_1)
  (chord.bs.p @chord.node_2 @chord.node_2 @chord.node_0)
  (chord.bs.p @chord.node_2 @chord.node_2 @chord.node_1)
  (chord.bs.p @chord.node_2 @chord.node_2 @chord.node_2)
  (chord.ring.btw @chord.node_0 @chord.node_2 @chord.node_1)
  (chord.ring.btw @chord.node_1 @chord.node_0 @chord.node_2)
  (chord.ring.btw @chord.node_2 @chord.node_1 @chord.node_0)
  (= chord.tp1.n0 @chord.node_0)
)
(model N8
  ((@chord.node_0 chord.node) (@chord.node_1 chord.node) (@chord.node_2 chord.node))
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_0 @chord.node_0 @chord.node_2)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_1)
  (chord.bs.p @chord.node_0 @chord.node_1 @chord.node_2)
  (chord.bs.p @chord.node_0 @chord.node_2 @chord.node_2)
  (chord.bs.p @chord.node_1 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_1 @chord.node_0 @chord.node_2)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_1)
  (chord.bs.p @chord.node_1 @chord.node_1 @chord.node_2)
  (chord.bs.p @chord.node_1 @chord.node_2 @chord.node_2)
  (chord.bs.p @chord.node_2 @chord.node_0 @chord.node_0)
  (chord.bs.p @chord.node_2 @chord.node_0 @chord.node_1)
  (chord.bs.p @chord.node_2 @chord.node_0 @chord.node_2)
  (chord.bs.p @chord.node_2 @chord.node_1 @chord.node_0)
  (chord.bs.p @chord.node_2 @chord.node_1 @chord.node_1)
  (chord.bs.p @chord.node_2 @chord.node_1 @chord.node_2)
  (chord.bs.p @chord.node_2 @chord.node_2 @chord.node_2)
  (chord.ring.btw @chord.node_0 @chord.node_1 @chord.node_2)
  (chord.ring.btw @chord.node_1 @chord.node_2 @chord.node_0)
  (chord.ring.btw @chord.node_2 @chord.node_0 @chord.node_1)
  (= chord.tp1.n0 @chord.node_0)
)

(constraint P0 (not N1) P2 (not N3) (not N4) (not N5) (not N6) (not N7) (not N8))
