; File: examples/fol/learning_switch.pyv

; Sig
(sort node)
(relation pending node node node node)
(relation table node node node)
; End sig

; Axioms

; Conjecture c0
(conjecture (forall T node (forall X node (table T X X))))

(model P0
  ((@node_0 node) (@uc_packet_0 packet))
  (route.dom @node_0 @node_0)
  (route.tc @node_0 @node_0 @node_0)
  (= (dst @uc_packet_0) @node_0)
  (= (src @uc_packet_0) @node_0)
)
(model N1
  ((@node_0 node) (@node_1 node) (@packet_0 packet))
  (route.tc @node_0 @node_0 @node_0)
  (route.tc @node_0 @node_0 @node_1)
  (route.tc @node_0 @node_1 @node_0)
  (route.tc @node_0 @node_1 @node_1)
  (route.tc @node_1 @node_0 @node_0)
  (route.tc @node_1 @node_0 @node_1)
  (route.tc @node_1 @node_1 @node_0)
  (route.tc @node_1 @node_1 @node_1)
  (= (dst @packet_0) @node_0)
  (= (src @packet_0) @node_0)
)
(model N2
  ((@node_0 node) (@node_1 node) (@uc_packet_0 packet))
  (route.dom @node_0 @node_0)
  (route.tc @node_0 @node_0 @node_0)
  (route.tc @node_0 @node_0 @node_1)
  (route.tc @node_0 @node_1 @node_0)
  (route.tc @node_0 @node_1 @node_1)
  (route.tc @node_1 @node_0 @node_0)
  (route.tc @node_1 @node_0 @node_1)
  (route.tc @node_1 @node_1 @node_0)
  (route.tc @node_1 @node_1 @node_1)
  (= (dst @uc_packet_0) @node_0)
  (= (src @uc_packet_0) @node_0)
)
(model N3
  ((@node_0 node) (@node_1 node) (@uc_packet_0 packet))
  (route.dom @node_0 @node_0)
  (route.dom @node_0 @node_1)
  (route.dom @node_1 @node_1)
  (route.tc @node_0 @node_0 @node_0)
  (route.tc @node_0 @node_0 @node_1)
  (route.tc @node_0 @node_1 @node_0)
  (route.tc @node_0 @node_1 @node_1)
  (route.tc @node_1 @node_0 @node_0)
  (route.tc @node_1 @node_0 @node_1)
  (route.tc @node_1 @node_1 @node_0)
  (route.tc @node_1 @node_1 @node_1)
  (= (dst @uc_packet_0) @node_0)
  (= (src @uc_packet_0) @node_0)
)
(model P4
  ((@node_0 node) (@node_1 node) (@uc_packet_0 packet))
  (route.dom @node_0 @node_0)
  (route.dom @node_0 @node_1)
  (route.dom @node_1 @node_0)
  (route.dom @node_1 @node_1)
  (route.tc @node_0 @node_0 @node_0)
  (route.tc @node_0 @node_0 @node_1)
  (route.tc @node_0 @node_1 @node_0)
  (route.tc @node_0 @node_1 @node_1)
  (route.tc @node_1 @node_0 @node_0)
  (route.tc @node_1 @node_0 @node_1)
  (route.tc @node_1 @node_1 @node_0)
  (route.tc @node_1 @node_1 @node_1)
  (= (dst @uc_packet_0) @node_0)
  (= (src @uc_packet_0) @node_0)
)
(model N5
  ((@node_0 node) (@node_1 node) (@packet_0 packet))
  (route.dom @node_0 @node_0)
  (route.dom @node_0 @node_1)
  (route.dom @node_1 @node_1)
  (route.tc @node_0 @node_0 @node_0)
  (route.tc @node_0 @node_0 @node_1)
