(model P8
  ((@node_0 node) (@node_1 node) (@uc_packet_0 packet))
  (route.dom @node_0 @node_0)
  (route.dom @node_0 @node_1)
  (route.dom @node_1 @node_1)
  (route.tc @node_0 @node_0 @node_0)
  (route.tc @node_0 @node_0 @node_1)
  (route.tc @node_0 @node_1 @node_0)
  (route.tc @node_0 @node_1 @node_1)
  (route.tc @node_1 @node_0 @node_0)
  (route.tc @node_1 @node_1 @node_0)
  (route.tc @node_1 @node_1 @node_1)
  (= (dst @uc_packet_0) @node_0)
