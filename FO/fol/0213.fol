; File: examples/fol/lockserv.pyv

; Sig
(sort node)
(relation grant_msg node)
(relation holds_lock node)
(relation lock_msg node)
(relation server_holds_lock )
(relation unlock_msg node)
; End sig

; Axioms

; Conjecture c6
(conjecture (forall N node (not (and (holds_lock N) (server_holds_lock )))))



(model P0
  ((@uc_node_0 node))

)

(model P1
  ((@uc_node_0 node))
  (server_holds_lock )
)

(model N0
  ((@uc_node_0 node))
  (holds_lock @uc_node_0)
  (server_holds_lock )
)

(model N1
  ((@uc_node_0 node) (@uc_node_1 node))
  (holds_lock @uc_node_1)
  (server_holds_lock )
)

(model P2
  ((@uc_node_0 node))
  (holds_lock @uc_node_0)
)

(constraint P0 P1 P2 (not N0) (not N1))
