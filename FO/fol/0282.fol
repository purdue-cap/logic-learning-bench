; File: examples/fol/sharded_kv.pyv

; Sig
(sort key)
(sort node)
(sort value)
(relation owner node key)
(relation table node key value)
(relation transfer_msg node key value)
; End sig

; Axioms

; Conjecture keys_unique
(conjecture (forall N1 node (forall K key (forall V1 value (forall N2 node (forall V2 value (or (not (and (table N1 K V1) (table N2 K V2))) (and (= N1 N2) (= V1 V2)))))))))



(model P0
  ((@uc_value_0 value) (@uc_node_0 node) (@uc_key_0 key))
  (table @uc_node_0 @uc_key_0 @uc_value_0)
)

(model N0
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_value_0 value) (@uc_key_0 key))
  (table @uc_node_0 @uc_key_0 @uc_value_0)
  (table @uc_node_1 @uc_key_0 @uc_value_0)
)

(model N1
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_value_1 value) (@uc_key_0 key))
  (table @uc_node_0 @uc_key_0 @uc_value_0)
  (table @uc_node_0 @uc_key_0 @uc_value_1)
)

(constraint P0 (not N0) (not N1))
