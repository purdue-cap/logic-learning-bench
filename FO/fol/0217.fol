; File: examples/fol/paxos_epr.pyv

; Sig
(sort node)
(sort quorum)
(sort round)
(sort value)
(constant none round)
(relation decision round value)
(relation le round round)
(relation left_round node round)
(relation member node quorum)
(relation one_a round)
(relation one_b node round)
(relation proposal round value)
(relation vote node round value)
; End sig

; Axioms
(axiom (forall X round (le X X)))
(axiom (forall X round (forall Y round (forall Z round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))
(axiom (forall Q1 quorum (forall Q2 quorum (exists N node (and (member N Q1) (member N Q2))))))

; Conjecture c1
(conjecture (forall R round (forall V1 value (forall V2 value (or (not (and (proposal R V1) (proposal R V2))) (= V1 V2))))))



(model P0
  ((@uc_value_0 value) (@uc_quorum_0 quorum) (@uc_round_0 round) (@uc_node_0 node))
  (= none @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (member @uc_node_0 @uc_quorum_0)
  (proposal @uc_round_0 @uc_value_0)
)

(model N0
  ((@uc_value_0 value) (@uc_value_1 value) (@uc_quorum_0 quorum) (@uc_round_0 round) (@uc_node_0 node))
  (= none @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (member @uc_node_0 @uc_quorum_0)
  (proposal @uc_round_0 @uc_value_0)
  (proposal @uc_round_0 @uc_value_1)
)

(model P1
  ((@uc_value_0 value) (@uc_value_1 value) (@uc_quorum_0 quorum) (@uc_round_0 round) (@uc_node_0 node))
  (= none @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (member @uc_node_0 @uc_quorum_0)
)

(model N1
  ((@uc_value_0 value) (@uc_value_1 value) (@uc_quorum_0 quorum) (@uc_round_0 round) (@uc_round_1 round) (@uc_node_0 node))
  (= none @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (le @uc_round_1 @uc_round_0)
  (le @uc_round_1 @uc_round_1)
  (member @uc_node_0 @uc_quorum_0)
  (proposal @uc_round_1 @uc_value_0)
  (proposal @uc_round_1 @uc_value_1)
)

(constraint P0 P1 (not N0) (not N1))
