; File: good-ivy-examples/oopsla17-paxos/fast_paxos_epr.ivy

; Sig
(sort c_quorum)
(sort f_quorum)
(sort node)
(sort round)
(sort value)
(relation any_msg round)
(relation c_member node c_quorum)
(relation decision node round value)
(relation f_member node f_quorum)
(relation fast round)
(relation le round round)
(relation left_rnd node round)
(constant none round)
(relation one_a round)
(relation one_b node round)
(relation one_b_max_vote node round round value)
(relation proposal round value)
(relation vote node round value)
; End sig

; Axiom a
(axiom (forall X round (le X X)))
; Axiom a0
(axiom (forall X round (forall Z round (forall Y round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom a1
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom a2
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))
; Axiom a3
(axiom (forall Q1 c_quorum (forall Q2 c_quorum (exists N node (and (c_member N Q1) (c_member N Q2))))))
; Axiom a4
(axiom (forall Q1 c_quorum (forall Q3 f_quorum (forall Q2 f_quorum (exists N node (and (and (c_member N Q1) (f_member N Q2)) (f_member N Q3)))))))


; Conjecture c12
(conjecture (forall N node (forall RMAX round (forall R round (forall V value (forall VOTHER value (forall ROTHER round (or (not (and (and (and (one_b_max_vote N R RMAX V) (not (= RMAX none))) (not (le R ROTHER))) (not (le ROTHER RMAX)))) (not (vote N ROTHER VOTHER))))))))))



(model P0
  ((@uc_c_quorum_0 c_quorum) (@uc_node_0 node) (@uc_f_quorum_0 f_quorum) (@uc_round_0 round) (@uc_value_0 value))
  (= none @uc_round_0)
  (c_member @uc_node_0 @uc_c_quorum_0)
  (f_member @uc_node_0 @uc_f_quorum_0)
  (le @uc_round_0 @uc_round_0)
  (one_b_max_vote @uc_node_0 @uc_round_0 @uc_round_0 @uc_value_0)
  (vote @uc_node_0 @uc_round_0 @uc_value_0)
)

(model N0
  ((@uc_c_quorum_0 c_quorum) (@uc_node_0 node) (@uc_f_quorum_0 f_quorum) (@uc_round_0 round) (@uc_round_1 round) (@uc_round_2 round) (@uc_value_0 value))
  (= none @uc_round_2)
  (c_member @uc_node_0 @uc_c_quorum_0)
  (f_member @uc_node_0 @uc_f_quorum_0)
  (le @uc_round_0 @uc_round_0)
  (le @uc_round_0 @uc_round_1)
  (le @uc_round_0 @uc_round_2)
  (le @uc_round_1 @uc_round_1)
  (le @uc_round_2 @uc_round_1)
  (le @uc_round_2 @uc_round_2)
  (one_b_max_vote @uc_node_0 @uc_round_0 @uc_round_0 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_0 @uc_round_1 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_0 @uc_round_2 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_1 @uc_round_0 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_1 @uc_round_1 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_1 @uc_round_2 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_2 @uc_round_0 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_2 @uc_round_1 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_2 @uc_round_2 @uc_value_0)
  (vote @uc_node_0 @uc_round_0 @uc_value_0)
  (vote @uc_node_0 @uc_round_1 @uc_value_0)
  (vote @uc_node_0 @uc_round_2 @uc_value_0)
)

(model P1
  ((@uc_c_quorum_0 c_quorum) (@uc_node_0 node) (@uc_f_quorum_0 f_quorum) (@uc_round_0 round) (@uc_round_1 round) (@uc_value_0 value))
  (= none @uc_round_0)
  (c_member @uc_node_0 @uc_c_quorum_0)
  (f_member @uc_node_0 @uc_f_quorum_0)
  (le @uc_round_0 @uc_round_0)
  (le @uc_round_1 @uc_round_0)
  (le @uc_round_1 @uc_round_1)
  (one_b_max_vote @uc_node_0 @uc_round_0 @uc_round_0 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_0 @uc_round_1 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_1 @uc_round_0 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_1 @uc_round_1 @uc_value_0)
  (vote @uc_node_0 @uc_round_0 @uc_value_0)
  (vote @uc_node_0 @uc_round_1 @uc_value_0)
)

(model N1
  ((@uc_c_quorum_0 c_quorum) (@uc_node_0 node) (@uc_f_quorum_0 f_quorum) (@uc_round_0 round) (@uc_round_1 round) (@uc_round_2 round) (@uc_value_0 value))
  (= none @uc_round_1)
  (c_member @uc_node_0 @uc_c_quorum_0)
  (f_member @uc_node_0 @uc_f_quorum_0)
  (le @uc_round_0 @uc_round_0)
  (le @uc_round_0 @uc_round_1)
  (le @uc_round_0 @uc_round_2)
  (le @uc_round_1 @uc_round_1)
  (le @uc_round_2 @uc_round_1)
  (le @uc_round_2 @uc_round_2)
  (one_b_max_vote @uc_node_0 @uc_round_0 @uc_round_0 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_0 @uc_round_1 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_0 @uc_round_2 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_1 @uc_round_0 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_1 @uc_round_1 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_1 @uc_round_2 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_2 @uc_round_0 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_2 @uc_round_1 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_2 @uc_round_2 @uc_value_0)
  (vote @uc_node_0 @uc_round_0 @uc_value_0)
  (vote @uc_node_0 @uc_round_1 @uc_value_0)
  (vote @uc_node_0 @uc_round_2 @uc_value_0)
)

(model P2
  ((@uc_c_quorum_0 c_quorum) (@uc_node_0 node) (@uc_f_quorum_0 f_quorum) (@uc_round_0 round) (@uc_round_1 round) (@uc_round_2 round) (@uc_value_0 value))
  (= none @uc_round_0)
  (c_member @uc_node_0 @uc_c_quorum_0)
  (f_member @uc_node_0 @uc_f_quorum_0)
  (le @uc_round_0 @uc_round_0)
  (le @uc_round_1 @uc_round_0)
  (le @uc_round_1 @uc_round_1)
  (le @uc_round_1 @uc_round_2)
  (le @uc_round_2 @uc_round_0)
  (le @uc_round_2 @uc_round_2)
  (one_b_max_vote @uc_node_0 @uc_round_0 @uc_round_0 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_0 @uc_round_2 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_1 @uc_round_0 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_1 @uc_round_1 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_1 @uc_round_2 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_2 @uc_round_0 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_2 @uc_round_1 @uc_value_0)
  (one_b_max_vote @uc_node_0 @uc_round_2 @uc_round_2 @uc_value_0)
  (vote @uc_node_0 @uc_round_0 @uc_value_0)
  (vote @uc_node_0 @uc_round_1 @uc_value_0)
  (vote @uc_node_0 @uc_round_2 @uc_value_0)
)

(constraint P0 P1 P2 (not N0) (not N1))
