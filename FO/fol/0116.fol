(relation tlb.plock tlb.pmap)
(relation tlb.scheduled tlb.processor)
(function tlb.tlb tlb.processor tlb.pageentry)
(relation tlb.todo tlb.processor tlb.processor)
(constant tlb.tp1.sk0 tlb.processor)
(constant tlb.tp1.sk1 tlb.processor)
(constant tlb.tp1.sk2 tlb.pmap)
(function tlb.userpmap tlb.processor tlb.pmap)
(function tlb.writepmap tlb.processor tlb.pmap)
; End sig



; Conjecture tlb18
(conjecture (forall C tlb.processor (forall P tlb.processor (or (not (and (and (and (tlb.pc_i3 P) (not (tlb.todo P C))) (not (tlb.pc_b1 C))) (= (tlb.userpmap C) (tlb.writepmap P)))) (or (or (tlb.interrupt C) (= P C)) (or (or (tlb.pc_r1 C) (tlb.pc_r2 C)) (tlb.pc_r3 C)))))))



(model P0
  ((@uc_tlb.pmap_0 tlb.pmap) (@uc_tlb.processor_0 tlb.processor) (@uc_tlb.pageentry_0 tlb.pageentry))
  (= tlb.tp1.sk0 @uc_tlb.processor_0)
  (= tlb.tp1.sk1 @uc_tlb.processor_0)
  (= tlb.tp1.sk2 @uc_tlb.pmap_0)
  (tlb.interrupt @uc_tlb.processor_0)
