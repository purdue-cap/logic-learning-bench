; File: examples/fol/lockserv.pyv

; Sig
(sort node)
(relation grant_msg node)
(relation holds_lock node)
(relation lock_msg node)
(relation server_holds_lock )
(relation unlock_msg node)
; End sig

; Axioms

; Conjecture c4
(conjecture (forall N1 node (forall N2 node (not (and (grant_msg N1) (unlock_msg N2))))))



(model P0
  ((@uc_node_0 node))

)

(model N0
  ((@uc_node_0 node))
  (grant_msg @uc_node_0)
  (unlock_msg @uc_node_0)
)

(model N1
  ((@uc_node_0 node) (@uc_node_1 node))
  (grant_msg @uc_node_0)
  (unlock_msg @uc_node_0)
  (unlock_msg @uc_node_1)
)

(model N2
  ((@uc_node_0 node) (@uc_node_1 node))
  (grant_msg @uc_node_0)
  (grant_msg @uc_node_1)
  (unlock_msg @uc_node_1)
)

(model P1
  ((@uc_node_0 node))
  (grant_msg @uc_node_0)
)

(model P2
  ((@uc_node_0 node))
  (unlock_msg @uc_node_0)
)

(model N3
  ((@uc_node_0 node) (@uc_node_1 node))
  (grant_msg @uc_node_0)
  (unlock_msg @uc_node_1)
)

(constraint P0 P1 P2 (not N0) (not N1) (not N2) (not N3))
