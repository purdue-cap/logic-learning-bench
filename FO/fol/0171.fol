; File: examples/fol/client_server_db_ae.pyv

; Sig
(sort db_request_id)
(sort node)
(sort request)
(sort response)
(relation db_request_sent db_request_id request)
(relation db_response_sent db_request_id response)
(relation match request response)
(relation request_sent node request)
(relation response_received node response)
(relation response_sent node response)
(relation t db_request_id node)
; End sig

; Axioms

; Conjecture c4
(conjecture (forall I db_request_id (forall N1 node (forall N2 node (or (not (and (t I N1) (t I N2))) (= N1 N2))))))



(model P0
  ((@uc_db_request_id_0 db_request_id) (@uc_node_0 node) (@uc_response_0 response) (@uc_request_0 request))
  (t @uc_db_request_id_0 @uc_node_0)
)

(model N0
  ((@uc_request_0 request) (@uc_db_request_id_0 db_request_id) (@uc_node_0 node) (@uc_node_1 node) (@uc_response_0 response))
  (t @uc_db_request_id_0 @uc_node_0)
  (t @uc_db_request_id_0 @uc_node_1)
)

(model P1
  ((@uc_db_request_id_0 db_request_id) (@uc_node_0 node) (@uc_node_1 node) (@uc_response_0 response) (@uc_request_0 request))

)

(constraint P0 P1 (not N0))
