; File: good-ivy-examples/toy/lockserv.ivy

; Sig
(sort node)
(relation grant_msg node)
(relation holds_lock node)
(relation lock_msg node)
(relation server_holds_lock )
(relation unlock_msg node)
; End sig



; Conjecture conj4
(conjecture (forall N1 node (forall N2 node (not (and (holds_lock N1) (grant_msg N2))))))

(model P0
  ((@node_0 node))

)
(model N1
  ((@node_0 node))
  (grant_msg @node_0)
  (holds_lock @node_0)
)
(model N2
  ((@node_0 node) (@node_1 node))
  (grant_msg @node_1)
  (holds_lock @node_0)
  (holds_lock @node_1)
)
(model N3
  ((@node_0 node) (@node_1 node))
  (grant_msg @node_0)
  (grant_msg @node_1)
  (holds_lock @node_1)
)
(model P4
  ((@node_0 node))
  (holds_lock @node_0)
)
(model P5
  ((@node_0 node))
  (grant_msg @node_0)
)
(model N6
  ((@node_0 node) (@node_1 node))
  (grant_msg @node_1)
  (holds_lock @node_0)
)

(constraint P0 (not N1) (not N2) (not N3) P4 P5 (not N6))
