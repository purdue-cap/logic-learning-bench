; File: good-ivy-examples/toy/lockserv.ivy

; Sig
(sort node)
(relation grant_msg node)
(relation holds_lock node)
(relation lock_msg node)
(relation server_holds_lock )
(relation unlock_msg node)
; End sig



; Conjecture conj3
(conjecture (forall N1 node (forall N2 node (or (not (and (unlock_msg N1) (unlock_msg N2))) (= N1 N2)))))

(model P0
  ((@node_0 node))
  (unlock_msg @node_0)
)
(model N1
  ((@node_0 node) (@node_1 node))
  (unlock_msg @node_0)
  (unlock_msg @node_1)
)
(model P2
  ((@node_0 node) (@node_1 node))

)

(constraint P0 (not N1) P2)
