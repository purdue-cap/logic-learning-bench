; File: examples/fol/client_server_ae.pyv

; Sig
(sort node)
(sort request)
(sort response)
(relation match request response)
(relation request_sent node request)
(relation response_received node response)
(relation response_sent node response)
; End sig

; Axioms

; Conjecture c1
(conjecture (forall N node (forall P response (or (not (response_sent N P)) (exists R request (and (request_sent N R) (match R P)))))))



(model P0
  ((@uc_response_0 response) (@uc_request_0 request) (@uc_node_0 node))
  (match @uc_request_0 @uc_response_0)
  (request_sent @uc_node_0 @uc_request_0)
)

(model N0
  ((@uc_request_0 request) (@uc_response_0 response) (@uc_node_0 node))
  (match @uc_request_0 @uc_response_0)
  (response_sent @uc_node_0 @uc_response_0)
)

(model N1
  ((@uc_request_0 request) (@uc_response_0 response) (@uc_node_0 node))
  (request_sent @uc_node_0 @uc_request_0)
  (response_sent @uc_node_0 @uc_response_0)
)

(model N2
  ((@uc_response_0 response) (@uc_request_0 request) (@uc_node_0 node) (@uc_node_1 node))
  (match @uc_request_0 @uc_response_0)
  (request_sent @uc_node_0 @uc_request_0)
  (response_sent @uc_node_1 @uc_response_0)
)

(model N3
  ((@uc_response_0 response) (@uc_response_1 response) (@uc_request_0 request) (@uc_node_0 node))
  (match @uc_request_0 @uc_response_0)
  (match @uc_request_0 @uc_response_1)
  (response_sent @uc_node_0 @uc_response_1)
)

(model P1
  ((@uc_response_0 response) (@uc_request_0 request) (@uc_node_0 node))
  (match @uc_request_0 @uc_response_0)
  (request_sent @uc_node_0 @uc_request_0)
  (response_sent @uc_node_0 @uc_response_0)
)

(constraint P0 P1 (not N0) (not N1) (not N2) (not N3))
