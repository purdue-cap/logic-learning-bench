; File: good-ivy-examples/oopsla17-paxos/fast_paxos_epr.ivy

; Sig
(sort c_quorum)
(sort f_quorum)
(sort node)
(sort round)
(sort value)
(relation any_msg round)
(relation c_member node c_quorum)
(relation decision node round value)
(relation f_member node f_quorum)
(relation fast round)
(relation le round round)
(relation left_rnd node round)
(constant none round)
(relation one_a round)
(relation one_b node round)
(relation one_b_max_vote node round round value)
(relation proposal round value)
(relation vote node round value)
; End sig

; Axiom a
(axiom (forall X round (le X X)))
; Axiom a0
(axiom (forall X round (forall Z round (forall Y round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom a1
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom a2
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))
; Axiom a3
(axiom (forall Q1 c_quorum (forall Q2 c_quorum (exists N node (and (c_member N Q1) (c_member N Q2))))))
; Axiom a4
(axiom (forall Q1 c_quorum (forall Q3 f_quorum (forall Q2 f_quorum (exists N node (and (and (c_member N Q1) (f_member N Q2)) (f_member N Q3)))))))


; Conjecture c5
(conjecture (forall N node (forall R round (forall V value (or (not (and (fast R) (vote N R V))) (or (proposal R V) (any_msg R)))))))

(model P0
  ((@c_quorum_0 c_quorum) (@f_quorum_0 f_quorum) (@node_0 node) (@round_0 round) (@value_0 value))
  (any_msg @round_0)
  (c_member @node_0 @c_quorum_0)
  (f_member @node_0 @f_quorum_0)
  (fast @round_0)
  (le @round_0 @round_0)
  (proposal @round_0 @value_0)
  (vote @node_0 @round_0 @value_0)
  (= none @round_0)
)
(model N1
  ((@c_quorum_0 c_quorum) (@f_quorum_0 f_quorum) (@node_0 node) (@round_0 round) (@round_1 round) (@value_0 value))
  (any_msg @round_0)
  (c_member @node_0 @c_quorum_0)
  (f_member @node_0 @f_quorum_0)
  (fast @round_0)
  (fast @round_1)
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (vote @node_0 @round_0 @value_0)
  (vote @node_0 @round_1 @value_0)
  (= none @round_0)
)
(model N2
  ((@c_quorum_0 c_quorum) (@f_quorum_0 f_quorum) (@node_0 node) (@round_0 round) (@round_1 round) (@value_0 value))
  (c_member @node_0 @c_quorum_0)
  (f_member @node_0 @f_quorum_0)
  (fast @round_0)
  (fast @round_1)
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (proposal @round_0 @value_0)
  (vote @node_0 @round_0 @value_0)
  (vote @node_0 @round_1 @value_0)
  (= none @round_0)
)
(model N3
  ((@c_quorum_0 c_quorum) (@f_quorum_0 f_quorum) (@node_0 node) (@round_0 round) (@value_0 value))
  (c_member @node_0 @c_quorum_0)
  (f_member @node_0 @f_quorum_0)
  (fast @round_0)
  (le @round_0 @round_0)
  (vote @node_0 @round_0 @value_0)
  (= none @round_0)
)
(model P4
  ((@c_quorum_0 c_quorum) (@f_quorum_0 f_quorum) (@node_0 node) (@round_0 round) (@value_0 value))
  (c_member @node_0 @c_quorum_0)
  (f_member @node_0 @f_quorum_0)
  (fast @round_0)
  (le @round_0 @round_0)
  (proposal @round_0 @value_0)
  (vote @node_0 @round_0 @value_0)
  (= none @round_0)
)
(model N5
  ((@c_quorum_0 c_quorum) (@f_quorum_0 f_quorum) (@node_0 node) (@round_0 round) (@value_0 value) (@value_1 value))
  (c_member @node_0 @c_quorum_0)
  (f_member @node_0 @f_quorum_0)
  (fast @round_0)
  (le @round_0 @round_0)
  (proposal @round_0 @value_1)
  (vote @node_0 @round_0 @value_0)
  (vote @node_0 @round_0 @value_1)
  (= none @round_0)
)
(model P6
  ((@c_quorum_0 c_quorum) (@f_quorum_0 f_quorum) (@node_0 node) (@round_0 round) (@value_0 value))
  (any_msg @round_0)
  (c_member @node_0 @c_quorum_0)
  (f_member @node_0 @f_quorum_0)
  (fast @round_0)
  (le @round_0 @round_0)
  (vote @node_0 @round_0 @value_0)
  (= none @round_0)
)
(model P7
  ((@c_quorum_0 c_quorum) (@f_quorum_0 f_quorum) (@node_0 node) (@round_0 round) (@value_0 value))
  (c_member @node_0 @c_quorum_0)
  (f_member @node_0 @f_quorum_0)
  (le @round_0 @round_0)
