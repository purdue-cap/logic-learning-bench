(model P9
  ((@c_quorum_0 c_quorum) (@f_quorum_0 f_quorum) (@node_0 node) (@round_0 round) (@value_0 value))
  (c_member @node_0 @c_quorum_0)
  (f_member @node_0 @f_quorum_0)
  (fast @round_0)
  (le @round_0 @round_0)
  (= none @round_0)
)

(constraint P0 (not N1) (not N2) (not N3) P4 (not N5) P6 P7 (not N8) P9)
