)
(model N8
  ((@c_quorum_0 c_quorum) (@f_quorum_0 f_quorum) (@node_0 node) (@round_0 round) (@round_1 round) (@value_0 value))
  (c_member @node_0 @c_quorum_0)
  (f_member @node_0 @f_quorum_0)
  (fast @round_1)
  (le @round_0 @round_0)
  (le @round_0 @round_1)
  (le @round_1 @round_1)
  (vote @node_0 @round_0 @value_0)
  (vote @node_0 @round_1 @value_0)
  (= none @round_0)
