; Conjecture tlb10
(conjecture (forall C tlb.processor (or (not (and (tlb.actionlock C) (not (or (or (tlb.pc_r5 C) (tlb.pc_r6 C)) (tlb.pc_r7 C))))) (tlb.plock (tlb.userpmap C)))))



