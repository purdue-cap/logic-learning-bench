; File: examples/fol/sharded_kv.pyv

; Sig
(sort key)
(sort node)
(sort value)
(relation owner node key)
(relation table node key value)
(relation transfer_msg node key value)
; End sig

; Axioms

; Conjecture c0
(conjecture (forall N1 node (forall K key (forall N2 node (or (not (and (owner N1 K) (owner N2 K))) (= N1 N2))))))



(model P0
  ((@uc_node_0 node) (@uc_key_0 key) (@uc_value_0 value))
  (owner @uc_node_0 @uc_key_0)
)

(model N0
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_key_0 key) (@uc_value_0 value))
  (owner @uc_node_0 @uc_key_0)
  (owner @uc_node_1 @uc_key_0)
)

(model P1
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_key_0 key) (@uc_value_0 value))

)

(constraint P0 P1 (not N0))
