; File: good-ivy-examples/fol-thresholds/byz_paxos.ivy

; Sig
(sort node)
(sort quorum_c)
(sort quorum_w)
(sort round)
(sort value)
(relation decision node round value)
(relation le round round)
(relation left_rnd node round)
(relation member_b node)
(relation member_c node quorum_c)
(relation member_w node quorum_w)
(constant none round)
(relation one_a round)
(relation one_b node round)
(relation prepare node round value)
(relation proposal round value)
(relation rcved_one_b node round node)
(relation vote node round value)
; End sig

; Axiom axiom1
(axiom (forall X round (le X X)))
; Axiom axiom2
(axiom (forall X round (forall Z round (forall Y round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom axiom3
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom axiom4
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))
; Axiom axiom5
(axiom (forall Q1 quorum_c (forall Q2 quorum_c (exists N node (and (not (member_b N)) (member_c N Q1) (member_c N Q2))))))
; Axiom axiom6
(axiom (forall W quorum_w (exists N node (and (not (member_b N)) (member_w N W)))))


; Conjecture conj14
(conjecture (forall N node (forall R2 round (forall R1 round (or (not (and (not (member_b N)) (one_b N R2) (not (le R2 R1)))) (left_rnd N R1))))))

(model P0
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (left_rnd @node_0 @round_0)
  (member_c @node_0 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (one_b @node_0 @round_0)
  (= none @round_0)
)
(model N1
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (member_c @node_0 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (one_b @node_0 @round_0)
  (one_b @node_0 @round_1)
  (= none @round_0)
)
(model N2
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (member_c @node_0 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (one_b @node_0 @round_0)
  (one_b @node_0 @round_1)
  (= none @round_0)
)
(model N3
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (member_c @node_0 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (one_b @node_0 @round_0)
  (one_b @node_0 @round_1)
  (= none @round_1)
)
(model P4
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_0 @round_1)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (left_rnd @node_0 @round_1)
  (member_c @node_0 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (one_b @node_0 @round_0)
  (one_b @node_0 @round_1)
  (= none @round_1)
)
(model N5
  ((@node_0 node) (@node_1 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (left_rnd @node_1 @round_1)
  (member_c @node_0 @quorum_c_0)
  (member_c @node_1 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (member_w @node_1 @quorum_w_0)
  (one_b @node_0 @round_0)
  (one_b @node_0 @round_1)
  (one_b @node_1 @round_0)
  (one_b @node_1 @round_1)
  (= none @round_0)
)
(model N6
  ((@node_0 node) (@node_1 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (left_rnd @node_1 @round_0)
  (left_rnd @node_1 @round_1)
  (member_c @node_0 @quorum_c_0)
  (member_c @node_1 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (member_w @node_1 @quorum_w_0)
  (one_b @node_0 @round_0)
  (one_b @node_0 @round_1)
  (one_b @node_1 @round_0)
  (one_b @node_1 @round_1)
  (= none @round_0)
)
(model P7
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (member_c @node_0 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (one_b @node_0 @round_0)
  (= none @round_0)
)
(model N8
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (member_c @node_0 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (one_b @node_0 @round_0)
  (one_b @node_0 @round_1)
  (= none @round_1)
)

(constraint P0 (not N1) (not N2) (not N3) P4 (not N5) (not N6) P7 (not N8))
