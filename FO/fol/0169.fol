; File: examples/fol/client_server_db_ae.pyv

; Sig
(sort db_request_id)
(sort node)
(sort request)
(sort response)
(relation db_request_sent db_request_id request)
(relation db_response_sent db_request_id response)
(relation match request response)
(relation request_sent node request)
(relation response_received node response)
(relation response_sent node response)
(relation t db_request_id node)
; End sig

; Axioms

; Conjecture c2
(conjecture (forall I db_request_id (forall R request (or (not (db_request_sent I R)) (exists N node (and (t I N) (request_sent N R)))))))



(model P0
  ((@uc_request_0 request) (@uc_node_0 node) (@uc_db_request_id_0 db_request_id) (@uc_response_0 response))
  (request_sent @uc_node_0 @uc_request_0)
  (t @uc_db_request_id_0 @uc_node_0)
)

(model N0
  ((@uc_node_0 node) (@uc_request_0 request) (@uc_db_request_id_0 db_request_id) (@uc_response_0 response))
  (db_request_sent @uc_db_request_id_0 @uc_request_0)
  (request_sent @uc_node_0 @uc_request_0)
)

(model N1
  ((@uc_node_0 node) (@uc_request_0 request) (@uc_db_request_id_0 db_request_id) (@uc_response_0 response))
  (db_request_sent @uc_db_request_id_0 @uc_request_0)
  (t @uc_db_request_id_0 @uc_node_0)
)

(model N2
  ((@uc_request_0 request) (@uc_request_1 request) (@uc_node_0 node) (@uc_db_request_id_0 db_request_id) (@uc_response_0 response))
  (db_request_sent @uc_db_request_id_0 @uc_request_1)
  (request_sent @uc_node_0 @uc_request_0)
  (request_sent @uc_node_0 @uc_request_1)
)

(model N3
  ((@uc_request_0 request) (@uc_node_0 node) (@uc_db_request_id_0 db_request_id) (@uc_db_request_id_1 db_request_id) (@uc_response_0 response))
  (db_request_sent @uc_db_request_id_1 @uc_request_0)
  (request_sent @uc_node_0 @uc_request_0)
)

(model P1
  ((@uc_request_0 request) (@uc_node_0 node) (@uc_db_request_id_0 db_request_id) (@uc_response_0 response))
  (db_request_sent @uc_db_request_id_0 @uc_request_0)
  (request_sent @uc_node_0 @uc_request_0)
  (t @uc_db_request_id_0 @uc_node_0)
)

(constraint P0 P1 (not N0) (not N1) (not N2) (not N3))
