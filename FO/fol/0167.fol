  (rb.rcv_msg @node_0 @node_0)
  (rb.rcv_msg @node_0 @node_1)
  (rb.rcv_msg @node_1 @node_0)
  (rb.rcv_msg @node_1 @node_1)
  (rb.sent_msg @node_1 @node_0)
  (rb.sent_msg @node_1 @node_1)
  (= rb.tp_correctness.n0 @node_0)
  (= rb.tp_relay.n1 @node_0)
  (= rb.tp_relay.n2 @node_1)
)
