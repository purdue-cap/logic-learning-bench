; File: good-ivy-examples/oopsla17-paxos/multi_paxos_epr.ivy

; Sig
(sort inst)
(sort node)
(sort quorum)
(sort round)
(sort value)
(sort votemap)
(relation active round)
(relation decision node inst round value)
(relation joined_round node round)
(relation le round round)
(relation left_round node round)
(function maxr votemap inst round)
(function maxv votemap inst value)
(relation member node quorum)
(constant none round)
(relation one_a round)
(relation one_b_msg node round votemap)
(relation proposal inst round value)
(relation vote node inst round value)
; End sig

; Axiom a
(axiom (forall X round (le X X)))
; Axiom a0
(axiom (forall X round (forall Z round (forall Y round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom a1
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom a2
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))
; Axiom a3
(axiom (forall Q2 quorum (forall Q1 quorum (exists N node (and (member N Q1) (member N Q2))))))


; Conjecture c9
(conjecture (forall N node (forall R2 round (forall R1 round (or (not (and (joined_round N R2) (not (le R2 R1)))) (left_round N R1))))))

(model P0
  ((@uc_inst_0 inst) (@node_0 node) (@quorum_0 quorum) (@round_0 round) (@uc_value_0 value) (@uc_votemap_0 votemap))
  (joined_round @node_0 @round_0)
  (le @round_0 @round_0)
  (left_round @node_0 @round_0)
  (member @node_0 @quorum_0)
  (= none @round_0)
  (= (maxr @uc_votemap_0 @uc_inst_0) @round_0)
  (= (maxv @uc_votemap_0 @uc_inst_0) @uc_value_0)
)
(model N1
  ((@uc_inst_0 inst) (@node_0 node) (@quorum_0 quorum) (@round_0 round) (@round_1 round) (@uc_value_0 value) (@uc_votemap_0 votemap))
  (joined_round @node_0 @round_0)
  (joined_round @node_0 @round_1)
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (member @node_0 @quorum_0)
  (= none @round_0)
  (= (maxr @uc_votemap_0 @uc_inst_0) @round_0)
  (= (maxv @uc_votemap_0 @uc_inst_0) @uc_value_0)
)
(model N2
  ((@uc_inst_0 inst) (@node_0 node) (@quorum_0 quorum) (@round_0 round) (@round_1 round) (@uc_value_0 value) (@uc_votemap_0 votemap))
  (joined_round @node_0 @round_0)
  (joined_round @node_0 @round_1)
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_round @node_0 @round_0)
  (member @node_0 @quorum_0)
  (= none @round_0)
  (= (maxr @uc_votemap_0 @uc_inst_0) @round_0)
  (= (maxv @uc_votemap_0 @uc_inst_0) @uc_value_0)
)
(model N3
  ((@uc_inst_0 inst) (@node_0 node) (@quorum_0 quorum) (@round_0 round) (@round_1 round) (@uc_value_0 value) (@uc_votemap_0 votemap))
  (joined_round @node_0 @round_0)
  (joined_round @node_0 @round_1)
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (member @node_0 @quorum_0)
  (= none @round_1)
  (= (maxr @uc_votemap_0 @uc_inst_0) @round_0)
  (= (maxv @uc_votemap_0 @uc_inst_0) @uc_value_0)
)
(model P4
  ((@uc_inst_0 inst) (@node_0 node) (@quorum_0 quorum) (@round_0 round) (@round_1 round) (@uc_value_0 value) (@uc_votemap_0 votemap))
  (joined_round @node_0 @round_0)
  (joined_round @node_0 @round_1)
  (le @round_0 @round_0)
  (le @round_0 @round_1)
  (le @round_1 @round_1)
  (left_round @node_0 @round_0)
  (left_round @node_0 @round_1)
  (member @node_0 @quorum_0)
  (= none @round_1)
  (= (maxr @uc_votemap_0 @uc_inst_0) @round_0)
  (= (maxv @uc_votemap_0 @uc_inst_0) @uc_value_0)
)
(model N5
  ((@uc_inst_0 inst) (@node_0 node) (@node_1 node) (@quorum_0 quorum) (@round_0 round) (@round_1 round) (@uc_value_0 value) (@uc_votemap_0 votemap))
  (joined_round @node_0 @round_0)
  (joined_round @node_0 @round_1)
  (joined_round @node_1 @round_0)
  (joined_round @node_1 @round_1)
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_round @node_0 @round_0)
  (left_round @node_1 @round_1)
  (member @node_0 @quorum_0)
  (member @node_1 @quorum_0)
  (= none @round_0)
  (= (maxr @uc_votemap_0 @uc_inst_0) @round_0)
  (= (maxv @uc_votemap_0 @uc_inst_0) @uc_value_0)
)
(model N6
  ((@uc_inst_0 inst) (@node_0 node) (@node_1 node) (@quorum_0 quorum) (@round_0 round) (@round_1 round) (@uc_value_0 value) (@uc_votemap_0 votemap))
  (joined_round @node_0 @round_0)
  (joined_round @node_0 @round_1)
  (joined_round @node_1 @round_0)
  (joined_round @node_1 @round_1)
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_round @node_0 @round_0)
  (left_round @node_1 @round_0)
  (left_round @node_1 @round_1)
  (member @node_0 @quorum_0)
  (member @node_1 @quorum_0)
  (= none @round_0)
  (= (maxr @uc_votemap_0 @uc_inst_0) @round_0)
  (= (maxv @uc_votemap_0 @uc_inst_0) @uc_value_0)
)
(model P7
  ((@uc_inst_0 inst) (@node_0 node) (@quorum_0 quorum) (@round_0 round) (@uc_value_0 value) (@uc_votemap_0 votemap))
  (joined_round @node_0 @round_0)
  (le @round_0 @round_0)
  (member @node_0 @quorum_0)
  (= none @round_0)
  (= (maxr @uc_votemap_0 @uc_inst_0) @round_0)
  (= (maxv @uc_votemap_0 @uc_inst_0) @uc_value_0)
)
(model N8
  ((@uc_inst_0 inst) (@node_0 node) (@quorum_0 quorum) (@round_0 round) (@round_1 round) (@uc_value_0 value) (@uc_votemap_0 votemap))
  (joined_round @node_0 @round_0)
  (joined_round @node_0 @round_1)
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_round @node_0 @round_0)
  (member @node_0 @quorum_0)
  (= none @round_1)
  (= (maxr @uc_votemap_0 @uc_inst_0) @round_0)
  (= (maxv @uc_votemap_0 @uc_inst_0) @uc_value_0)
)

(constraint P0 (not N1) (not N2) (not N3) P4 (not N5) (not N6) P7 (not N8))
