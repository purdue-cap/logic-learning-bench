  (= (abp.sender_array @uc_abp.index_t_0) @uc_abp.value_0)
)

(model P13
  ((@uc_abp.index_t_0 abp.index_t) (@uc_abp.data_msg_t_0 abp.data_msg_t) (@uc_abp.data_msg_t_1 abp.data_msg_t) (@uc_abp.value_0 abp.value) (@uc_abp.ack_msg_t_0 abp.ack_msg_t))
