  (abp.index.le @uc_abp.index_t_0 @uc_abp.index_t_0)
  (= (abp.d @uc_abp.data_msg_t_0) @uc_abp.value_0)
  (= (abp.d @uc_abp.data_msg_t_1) @uc_abp.value_0)
  (= (abp.receiver_array @uc_abp.index_t_0) @uc_abp.value_0)
  (= (abp.sender_array @uc_abp.index_t_0) @uc_abp.value_0)
)

(constraint P0 P1 P2 P3 P4 P5 P6 P7 P8 P9 P10 P11 P12 P13 (not N0) (not N1))
