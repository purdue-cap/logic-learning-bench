; File: good-ivy-examples/fol-thresholds/fast_paxos.ivy

; Sig
(sort node)
(sort quorum_c)
(sort quorum_f)
(sort round)
(sort value)
(relation any_msg round)
(relation decision node round value)
(relation fast round)
(relation le round round)
(relation left_rnd node round)
(relation member_c node quorum_c)
(relation member_f node quorum_f)
(constant none round)
(relation one_a round)
(relation one_b node round)
(relation proposal round value)
(relation s node)
(relation vote node round value)
; End sig

; Axiom a
(axiom (forall Q1 quorum_c (forall Q2 quorum_c (exists N node (and (member_c N Q1) (member_c N Q2))))))
; Axiom a0
(axiom (forall Q3 quorum_f (forall Q1 quorum_c (forall Q2 quorum_f (exists N node (and (and (member_c N Q1) (member_f N Q2)) (member_f N Q3)))))))
; Axiom a1
(axiom (forall X round (le X X)))
; Axiom a2
(axiom (forall X round (forall Z round (forall Y round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom a3
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom a4
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))


; Conjecture c6
(conjecture (forall R round (forall V value (not (and (any_msg R) (proposal R V))))))



(model P0
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_quorum_f_0 quorum_f) (@uc_round_0 round) (@uc_quorum_c_0 quorum_c))
  (= none @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (member_f @uc_node_0 @uc_quorum_f_0)
  (proposal @uc_round_0 @uc_value_0)
)

(model N0
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_quorum_f_0 quorum_f) (@uc_round_0 round) (@uc_round_1 round) (@uc_quorum_c_0 quorum_c))
  (= none @uc_round_0)
  (any_msg @uc_round_1)
  (le @uc_round_0 @uc_round_0)
  (le @uc_round_1 @uc_round_0)
  (le @uc_round_1 @uc_round_1)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (member_f @uc_node_0 @uc_quorum_f_0)
  (proposal @uc_round_0 @uc_value_0)
  (proposal @uc_round_1 @uc_value_0)
)

(model N1
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_quorum_f_0 quorum_f) (@uc_round_0 round) (@uc_quorum_c_0 quorum_c))
  (= none @uc_round_0)
  (any_msg @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (member_f @uc_node_0 @uc_quorum_f_0)
  (proposal @uc_round_0 @uc_value_0)
)

(model P1
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_quorum_f_0 quorum_f) (@uc_round_0 round) (@uc_quorum_c_0 quorum_c))
  (= none @uc_round_0)
  (any_msg @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (member_f @uc_node_0 @uc_quorum_f_0)
)

(model N2
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_value_1 value) (@uc_quorum_f_0 quorum_f) (@uc_round_0 round) (@uc_quorum_c_0 quorum_c))
  (= none @uc_round_0)
  (any_msg @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (member_f @uc_node_0 @uc_quorum_f_0)
  (proposal @uc_round_0 @uc_value_0)
)

(constraint P0 P1 (not N0) (not N1) (not N2))
