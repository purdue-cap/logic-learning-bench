; Conjecture tlb11
(conjecture (forall C tlb.processor (forall P tlb.processor (or (not (and (and (tlb.actionlock C) (not (or (or (tlb.pc_r5 C) (tlb.pc_r6 C)) (tlb.pc_r7 C)))) (or (or (or (or (or (or (or (or (or (tlb.pc_i3 P) (tlb.pc_i4 P)) (tlb.pc_i5 P)) (tlb.pc_i6 P)) (tlb.pc_i7 P)) (tlb.pc_i8 P)) (tlb.pc_i9 P)) (tlb.pc_i11 P)) (tlb.pc_i12 P)) (tlb.pc_i14 P)))) (or (not (= (tlb.userpmap C) (tlb.writepmap P))) (and (tlb.currentcpu P C) (or (tlb.pc_i6 P) (tlb.pc_i7 P))))))))



