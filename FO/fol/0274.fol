; File: examples/fol/ring_id_not_dead.pyv

; Sig
(sort id)
(sort node)
(relation btw node node node)
(relation le id id)
(relation leader node)
(relation pending id node)
(relation sent node)
(function idn node id)
; End sig

; Axioms
(axiom (forall X id (le X X)))
(axiom (forall X id (forall Y id (forall Z id (or (not (and (le X Y) (le Y Z))) (le X Z))))))
(axiom (forall X id (forall Y id (or (not (and (le X Y) (le Y X))) (= X Y)))))
(axiom (forall X id (forall Y id (or (le X Y) (le Y X)))))
(axiom (forall W node (forall X node (forall Y node (forall Z node (or (not (and (btw W X Y) (btw W Y Z))) (btw W X Z)))))))
(axiom (forall W node (forall X node (forall Y node (or (not (btw W X Y)) (not (btw W Y X)))))))
(axiom (forall W node (forall X node (forall Y node (or (btw W X Y) (btw W Y X) (= W X) (= W Y) (= X Y))))))
(axiom (forall X node (forall Y node (forall Z node (or (not (btw X Y Z)) (btw Y Z X))))))
(axiom (forall X node (forall Y node (or (not (= (idn X) (idn Y))) (= X Y)))))
(axiom (exists N node (forall M node (le (idn M) (idn N)))))

; Conjecture leader_unique
(conjecture (forall X node (forall Y node (or (not (and (leader X) (leader Y))) (= X Y)))))



(model P0
  ((@uc_id_0 id) (@uc_node_0 node))
  (le @uc_id_0 @uc_id_0)
  (leader @uc_node_0)
  (= (idn @uc_node_0) @uc_id_0)
)

(model N0
  ((@uc_id_0 id) (@uc_id_1 id) (@uc_node_0 node) (@uc_node_1 node))
  (le @uc_id_0 @uc_id_0)
  (le @uc_id_1 @uc_id_0)
  (le @uc_id_1 @uc_id_1)
  (leader @uc_node_0)
  (leader @uc_node_1)
  (= (idn @uc_node_0) @uc_id_1)
  (= (idn @uc_node_1) @uc_id_0)
)

(model P1
  ((@uc_id_0 id) (@uc_id_1 id) (@uc_node_0 node) (@uc_node_1 node))
  (le @uc_id_0 @uc_id_0)
  (le @uc_id_1 @uc_id_0)
  (le @uc_id_1 @uc_id_1)
  (= (idn @uc_node_0) @uc_id_1)
  (= (idn @uc_node_1) @uc_id_0)
)

(model N1
  ((@uc_id_0 id) (@uc_id_1 id) (@uc_id_2 id) (@uc_node_0 node) (@uc_node_1 node) (@uc_node_2 node))
  (btw @uc_node_0 @uc_node_1 @uc_node_2)
  (btw @uc_node_1 @uc_node_2 @uc_node_0)
  (btw @uc_node_2 @uc_node_0 @uc_node_1)
  (le @uc_id_0 @uc_id_0)
  (le @uc_id_0 @uc_id_1)
  (le @uc_id_1 @uc_id_1)
  (le @uc_id_2 @uc_id_0)
  (le @uc_id_2 @uc_id_1)
  (le @uc_id_2 @uc_id_2)
  (leader @uc_node_0)
  (leader @uc_node_1)
  (= (idn @uc_node_0) @uc_id_1)
  (= (idn @uc_node_1) @uc_id_0)
  (= (idn @uc_node_2) @uc_id_2)
)

(constraint P0 P1 (not N0) (not N1))
