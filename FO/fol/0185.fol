; File: examples/fol/consensus_forall.pyv

; Sig
(sort node)
(sort quorum)
(sort value)
(constant voting_quorum quorum)
(relation decided node value)
(relation leader node)
(relation member node quorum)
(relation vote_msg node node)
(relation vote_request_msg node node)
(relation voted node)
(relation votes node node)
; End sig

; Axioms
(axiom (forall Q1 quorum (forall Q2 quorum (exists N node (and (member N Q1) (member N Q2))))))

; Conjecture c6
(conjecture (forall N node (forall V value (or (not (decided N V)) (leader N)))))



(model P0
  ((@uc_value_0 value) (@uc_quorum_0 quorum) (@uc_node_0 node))
  (= voting_quorum @uc_quorum_0)
  (decided @uc_node_0 @uc_value_0)
  (leader @uc_node_0)
  (member @uc_node_0 @uc_quorum_0)
)

(model N0
  ((@uc_value_0 value) (@uc_quorum_0 quorum) (@uc_node_0 node))
  (= voting_quorum @uc_quorum_0)
  (decided @uc_node_0 @uc_value_0)
  (member @uc_node_0 @uc_quorum_0)
)

(model N1
  ((@uc_value_0 value) (@uc_quorum_0 quorum) (@uc_node_0 node) (@uc_node_1 node))
  (= voting_quorum @uc_quorum_0)
  (decided @uc_node_0 @uc_value_0)
  (decided @uc_node_1 @uc_value_0)
  (leader @uc_node_1)
  (member @uc_node_0 @uc_quorum_0)
  (member @uc_node_1 @uc_quorum_0)
)

(model P1
  ((@uc_value_0 value) (@uc_quorum_0 quorum) (@uc_node_0 node))
  (= voting_quorum @uc_quorum_0)
  (member @uc_node_0 @uc_quorum_0)
)

(model N2
  ((@uc_value_0 value) (@uc_value_1 value) (@uc_quorum_0 quorum) (@uc_node_0 node))
  (= voting_quorum @uc_quorum_0)
  (decided @uc_node_0 @uc_value_1)
  (member @uc_node_0 @uc_quorum_0)
)

(constraint P0 P1 (not N0) (not N1) (not N2))
