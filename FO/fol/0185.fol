; File: good-ivy-examples/pldi16/learning_switch.ivy

; Sig
(sort node)
(sort packet)
(function dst packet node)
(relation link node node)
(relation pending packet node node)
(relation route.dom node node)
(relation route.tc node node node)
(function src packet node)
; End sig

; Axiom a
(axiom (forall X node (not (link X X))))
; Axiom a0
(axiom (forall Y node (forall X node (or (not (link X Y)) (link Y X)))))


; Conjecture route0
(conjecture (forall N node (forall Y node (forall X node (forall Z node (or (not (and (route.tc N X Y) (route.tc N Y Z))) (route.tc N X Z)))))))

(model P0
  ((@node_0 node) (@uc_packet_0 packet))
  (route.tc @node_0 @node_0 @node_0)
  (= (dst @uc_packet_0) @node_0)
  (= (src @uc_packet_0) @node_0)
)
(model N1
  ((@node_0 node) (@node_1 node) (@packet_0 packet))
  (route.tc @node_0 @node_0 @node_1)
  (route.tc @node_0 @node_1 @node_0)
  (= (dst @packet_0) @node_0)
  (= (src @packet_0) @node_0)
)
(model N2
  ((@node_0 node) (@node_1 node) (@uc_packet_0 packet))
  (route.tc @node_0 @node_0 @node_0)
  (route.tc @node_0 @node_0 @node_1)
  (route.tc @node_0 @node_1 @node_0)
  (= (dst @uc_packet_0) @node_0)
  (= (src @uc_packet_0) @node_0)
)
(model N3
  ((@node_0 node) (@node_1 node) (@uc_packet_0 packet))
  (route.tc @node_0 @node_0 @node_0)
  (route.tc @node_0 @node_0 @node_1)
  (route.tc @node_0 @node_1 @node_0)
  (route.tc @node_0 @node_1 @node_1)
  (route.tc @node_1 @node_0 @node_1)
  (route.tc @node_1 @node_1 @node_0)
  (route.tc @node_1 @node_1 @node_1)
  (= (dst @uc_packet_0) @node_0)
  (= (src @uc_packet_0) @node_0)
)
(model P4
  ((@node_0 node) (@node_1 node) (@uc_packet_0 packet))
  (route.tc @node_0 @node_0 @node_0)
  (route.tc @node_0 @node_0 @node_1)
  (route.tc @node_0 @node_1 @node_0)
  (route.tc @node_0 @node_1 @node_1)
  (route.tc @node_1 @node_0 @node_0)
  (route.tc @node_1 @node_0 @node_1)
  (route.tc @node_1 @node_1 @node_0)
  (route.tc @node_1 @node_1 @node_1)
  (= (dst @uc_packet_0) @node_0)
  (= (src @uc_packet_0) @node_0)
)
(model N5
  ((@node_0 node) (@node_1 node) (@packet_0 packet))
  (route.tc @node_0 @node_1 @node_1)
  (route.tc @node_1 @node_0 @node_1)
  (route.tc @node_1 @node_1 @node_0)
  (route.tc @node_1 @node_1 @node_1)
  (= (dst @packet_0) @node_1)
  (= (src @packet_0) @node_1)
)
(model N6
  ((@node_0 node) (@node_1 node) (@node_2 node) (@uc_packet_0 packet))
  (route.tc @node_0 @node_0 @node_0)
  (route.tc @node_0 @node_0 @node_1)
  (route.tc @node_0 @node_0 @node_2)
  (route.tc @node_0 @node_1 @node_0)
  (route.tc @node_0 @node_1 @node_1)
  (route.tc @node_0 @node_1 @node_2)
  (route.tc @node_0 @node_2 @node_0)
  (route.tc @node_0 @node_2 @node_1)
  (route.tc @node_0 @node_2 @node_2)
  (route.tc @node_1 @node_0 @node_0)
  (route.tc @node_1 @node_0 @node_1)
  (route.tc @node_1 @node_1 @node_0)
  (route.tc @node_1 @node_1 @node_1)
  (route.tc @node_1 @node_1 @node_2)
  (route.tc @node_1 @node_2 @node_0)
  (route.tc @node_1 @node_2 @node_1)
  (route.tc @node_1 @node_2 @node_2)
  (route.tc @node_2 @node_0 @node_0)
  (route.tc @node_2 @node_0 @node_1)
  (route.tc @node_2 @node_0 @node_2)
  (route.tc @node_2 @node_1 @node_0)
  (route.tc @node_2 @node_1 @node_1)
  (route.tc @node_2 @node_1 @node_2)
  (route.tc @node_2 @node_2 @node_0)
  (route.tc @node_2 @node_2 @node_1)
  (route.tc @node_2 @node_2 @node_2)
  (= (dst @uc_packet_0) @node_0)
  (= (src @uc_packet_0) @node_0)
)
(model N7
  ((@node_0 node) (@node_1 node) (@packet_0 packet))
  (route.tc @node_0 @node_1 @node_0)
  (route.tc @node_0 @node_1 @node_1)
  (route.tc @node_1 @node_0 @node_1)
  (route.tc @node_1 @node_1 @node_0)
  (route.tc @node_1 @node_1 @node_1)
  (= (dst @packet_0) @node_0)
  (= (src @packet_0) @node_1)
)
(model N8
  ((@node_0 node) (@node_1 node) (@packet_0 packet))
  (route.tc @node_0 @node_1 @node_0)
  (route.tc @node_0 @node_1 @node_1)
  (route.tc @node_1 @node_0 @node_1)
  (route.tc @node_1 @node_1 @node_0)
  (route.tc @node_1 @node_1 @node_1)
  (= (dst @packet_0) @node_1)
  (= (src @packet_0) @node_0)
)
(model P9
  ((@node_0 node) (@uc_packet_0 packet))
  (= (dst @uc_packet_0) @node_0)
  (= (src @uc_packet_0) @node_0)
)

(constraint P0 (not N1) (not N2) (not N3) P4 (not N5) (not N6) (not N7) (not N8) P9)
