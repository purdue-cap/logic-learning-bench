; End sig



; Conjecture tlb19
(conjecture (forall C tlb.processor (forall P tlb.processor (or (not (and (and (and (and (or (or (or (or (tlb.pc_i4 P) (tlb.pc_i5 P)) (tlb.pc_i6 P)) (tlb.pc_i7 P)) (tlb.pc_i8 P)) (not (tlb.todo P C))) (not (tlb.pc_b1 C))) (not (tlb.currentcpu P C))) (= (tlb.userpmap C) (tlb.writepmap P)))) (or (or (tlb.interrupt C) (= P C)) (or (or (tlb.pc_r1 C) (tlb.pc_r2 C)) (tlb.pc_r3 C)))))))



