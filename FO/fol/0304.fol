; File: examples/fol/toy_consensus_forall.pyv

; Sig
(sort node)
(sort quorum)
(sort value)
(constant voting_quorum quorum)
(relation decided value)
(relation member node quorum)
(relation vote node value)
(relation voted node)
; End sig

; Axioms
(axiom (forall Q1 quorum (forall Q2 quorum (exists N node (and (member N Q1) (member N Q2))))))

; Conjecture c1
(conjecture (forall N node (forall V value (or (not (vote N V)) (voted N)))))



(model P0
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_quorum_0 quorum))
  (= voting_quorum @uc_quorum_0)
  (member @uc_node_0 @uc_quorum_0)
  (vote @uc_node_0 @uc_value_0)
  (voted @uc_node_0)
)

(model N0
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_quorum_0 quorum))
  (= voting_quorum @uc_quorum_0)
  (member @uc_node_0 @uc_quorum_0)
  (vote @uc_node_0 @uc_value_0)
)

(model N1
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_value_0 value) (@uc_quorum_0 quorum))
  (= voting_quorum @uc_quorum_0)
  (member @uc_node_0 @uc_quorum_0)
  (member @uc_node_1 @uc_quorum_0)
  (vote @uc_node_0 @uc_value_0)
  (vote @uc_node_1 @uc_value_0)
  (voted @uc_node_1)
)

(model P1
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_quorum_0 quorum))
  (= voting_quorum @uc_quorum_0)
  (member @uc_node_0 @uc_quorum_0)
)

(model N2
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_value_1 value) (@uc_quorum_0 quorum))
  (= voting_quorum @uc_quorum_0)
  (member @uc_node_0 @uc_quorum_0)
  (vote @uc_node_0 @uc_value_1)
)

(constraint P0 P1 (not N0) (not N1) (not N2))
