  ((@uc_node_0 node) (@uc_node_1 node) (@uc_node_2 node) (@uc_quorum_b_0 quorum_b) (@uc_quorum_a_0 quorum_a))
  (accept @uc_node_0)
  (accept @uc_node_1)
  (member_a @uc_node_2 @uc_quorum_a_0)
  (member_b @uc_node_2 @uc_quorum_b_0)
