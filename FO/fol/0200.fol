(model P6
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_quorum_b_0 quorum_b) (@uc_quorum_a_0 quorum_a))
  (accept @uc_node_0)
  (accept @uc_node_1)
  (member_a @uc_node_0 @uc_quorum_a_0)
  (member_b @uc_node_0 @uc_quorum_b_0)
  (rcv_init @uc_node_1)
)

(constraint P0 P1 P2 P3 P4 P5 P6 (not N0) (not N1) (not N2) (not N3) (not N4) (not N5) (not N6) (not N7) (not N8))
