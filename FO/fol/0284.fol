; File: examples/fol/sharded_kv_no_lost_keys.pyv

; Sig
(sort key)
(sort node)
(sort value)
(relation owner node key)
(relation table node key value)
(relation transfer_msg node key value)
; End sig

; Axioms

; Conjecture c1
(conjecture (forall K key (or (exists N node (owner N K)) (exists N node (exists V value (transfer_msg N K V))))))



(model P0
  ((@uc_value_0 value) (@uc_node_0 node) (@uc_key_0 key))
  (owner @uc_node_0 @uc_key_0)
  (transfer_msg @uc_node_0 @uc_key_0 @uc_value_0)
)

(model N0
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_key_0 key))

)

(model P1
  ((@uc_value_0 value) (@uc_node_0 node) (@uc_key_0 key))
  (transfer_msg @uc_node_0 @uc_key_0 @uc_value_0)
)

(constraint P0 P1 (not N0))
