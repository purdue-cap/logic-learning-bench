; File: good-ivy-examples/fol-thresholds/byz_paxos.ivy

; Sig
(sort node)
(sort quorum_c)
(sort quorum_w)
(sort round)
(sort value)
(relation decision node round value)
(relation le round round)
(relation left_rnd node round)
(relation member_b node)
(relation member_c node quorum_c)
(relation member_w node quorum_w)
(constant none round)
(relation one_a round)
(relation one_b node round)
(relation prepare node round value)
(relation proposal round value)
(relation rcved_one_b node round node)
(relation vote node round value)
; End sig

; Axiom axiom1
(axiom (forall X round (le X X)))
; Axiom axiom2
(axiom (forall X round (forall Z round (forall Y round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom axiom3
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom axiom4
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))
; Axiom axiom5
(axiom (forall Q1 quorum_c (forall Q2 quorum_c (exists N node (and (not (member_b N)) (member_c N Q1) (member_c N Q2))))))
; Axiom axiom6
(axiom (forall W quorum_w (exists N node (and (not (member_b N)) (member_w N W)))))


; Conjecture conj9
(conjecture (forall N node (forall R round (forall M node (or (not (and (not (member_b N)) (not (member_b M)) (rcved_one_b N R M))) (one_b M R))))))



(model P0
  ((@uc_quorum_c_0 quorum_c) (@uc_quorum_w_0 quorum_w) (@uc_round_0 round) (@uc_node_0 node) (@uc_value_0 value))
  (= none @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (member_w @uc_node_0 @uc_quorum_w_0)
  (one_b @uc_node_0 @uc_round_0)
  (rcved_one_b @uc_node_0 @uc_round_0 @uc_node_0)
)

(model N0
  ((@uc_quorum_c_0 quorum_c) (@uc_quorum_w_0 quorum_w) (@uc_round_0 round) (@uc_node_0 node) (@uc_value_0 value))
  (= none @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (member_w @uc_node_0 @uc_quorum_w_0)
  (rcved_one_b @uc_node_0 @uc_round_0 @uc_node_0)
)

(model N1
  ((@uc_quorum_c_0 quorum_c) (@uc_quorum_w_0 quorum_w) (@uc_round_0 round) (@uc_node_0 node) (@uc_node_1 node) (@uc_value_0 value))
  (= none @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (member_c @uc_node_1 @uc_quorum_c_0)
  (member_w @uc_node_0 @uc_quorum_w_0)
  (member_w @uc_node_1 @uc_quorum_w_0)
  (one_b @uc_node_1 @uc_round_0)
  (rcved_one_b @uc_node_0 @uc_round_0 @uc_node_0)
  (rcved_one_b @uc_node_0 @uc_round_0 @uc_node_1)
  (rcved_one_b @uc_node_1 @uc_round_0 @uc_node_0)
  (rcved_one_b @uc_node_1 @uc_round_0 @uc_node_1)
)

(model N2
  ((@uc_quorum_c_0 quorum_c) (@uc_quorum_w_0 quorum_w) (@uc_round_0 round) (@uc_round_1 round) (@uc_node_0 node) (@uc_value_0 value))
  (= none @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (le @uc_round_1 @uc_round_0)
  (le @uc_round_1 @uc_round_1)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (member_w @uc_node_0 @uc_quorum_w_0)
  (one_b @uc_node_0 @uc_round_0)
  (rcved_one_b @uc_node_0 @uc_round_0 @uc_node_0)
  (rcved_one_b @uc_node_0 @uc_round_1 @uc_node_0)
)

(model P1
  ((@uc_quorum_c_0 quorum_c) (@uc_quorum_w_0 quorum_w) (@uc_round_0 round) (@uc_node_0 node) (@uc_value_0 value))
  (= none @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (member_w @uc_node_0 @uc_quorum_w_0)
)

(model N3
  ((@uc_quorum_c_0 quorum_c) (@uc_quorum_w_0 quorum_w) (@uc_round_0 round) (@uc_node_0 node) (@uc_node_1 node) (@uc_value_0 value))
  (= none @uc_round_0)
  (le @uc_round_0 @uc_round_0)
  (member_c @uc_node_0 @uc_quorum_c_0)
  (member_c @uc_node_1 @uc_quorum_c_0)
  (member_w @uc_node_0 @uc_quorum_w_0)
  (member_w @uc_node_1 @uc_quorum_w_0)
  (one_b @uc_node_1 @uc_round_0)
  (rcved_one_b @uc_node_0 @uc_round_0 @uc_node_1)
  (rcved_one_b @uc_node_1 @uc_round_0 @uc_node_0)
  (rcved_one_b @uc_node_1 @uc_round_0 @uc_node_1)
)

(constraint P0 P1 (not N0) (not N1) (not N2) (not N3))
