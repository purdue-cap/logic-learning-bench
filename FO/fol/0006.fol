; File: good-ivy-examples/liveness/alternating_bit_protocol.ivy

; Sig
(sort abp.ack_msg_t)
(sort abp.data_msg_t)
(sort abp.index_t)
(sort abp.value)
(relation abp.abit abp.ack_msg_t)
(relation abp.ack_msg.le abp.ack_msg_t abp.ack_msg_t)
(relation abp.ack_received )
(relation abp.ack_sent )
(constant abp.bot abp.value)
(function abp.d abp.data_msg_t abp.value)
(relation abp.data_msg.le abp.data_msg_t abp.data_msg_t)
(relation abp.data_received )
(relation abp.data_sent )
(relation abp.dbit abp.data_msg_t)
(relation abp.index.le abp.index_t abp.index_t)
(constant abp.index.zero abp.index_t)
(function abp.receiver_array abp.index_t abp.value)
(relation abp.receiver_bit )
(constant abp.receiver_i abp.index_t)
(relation abp.receiver_scheduled )
(function abp.sender_array abp.index_t abp.value)
(relation abp.sender_bit )
(constant abp.sender_gen_i abp.index_t)
(constant abp.sender_i abp.index_t)
(relation abp.sender_scheduled )
(constant abp.tp1.sk0 abp.index_t)
; End sig

; Axiom abp_index
(axiom (forall X abp.index_t (abp.index.le X X)))
; Axiom abp_index0
(axiom (forall Z abp.index_t (forall X abp.index_t (forall Y abp.index_t (or (not (and (abp.index.le X Y) (abp.index.le Y Z))) (abp.index.le X Z))))))
; Axiom abp_index1
(axiom (forall X abp.index_t (forall Y abp.index_t (or (not (and (abp.index.le X Y) (abp.index.le Y X))) (= X Y)))))
; Axiom abp_index2
(axiom (forall X abp.index_t (forall Y abp.index_t (or (abp.index.le X Y) (abp.index.le Y X)))))
; Axiom abp_index3
(axiom (forall X abp.index_t (abp.index.le abp.index.zero X)))


; Conjecture abp12
(conjecture (or (not (or (and (abp.sender_bit) (not (abp.receiver_bit))) (and (not (abp.sender_bit)) (not (not (abp.receiver_bit)))))) (and (not (abp.index.le abp.receiver_i abp.sender_i)) (forall I abp.index_t (or (not (not (abp.index.le I abp.sender_i))) (abp.index.le abp.receiver_i I))))))

(model P0
  ((@uc_abp.ack_msg_t_0 abp.ack_msg_t) (@uc_abp.data_msg_t_0 abp.data_msg_t) (@abp.index_t_0 abp.index_t) (@uc_abp.value_0 abp.value))
  (abp.index.le @abp.index_t_0 @abp.index_t_0)
  (= abp.bot @uc_abp.value_0)
  (= abp.index.zero @abp.index_t_0)
  (= abp.receiver_i @abp.index_t_0)
  (= abp.sender_gen_i @abp.index_t_0)
  (= abp.sender_i @abp.index_t_0)
  (= abp.tp1.sk0 @abp.index_t_0)
  (= (abp.d @uc_abp.data_msg_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_0) @uc_abp.value_0)
)
(model N1
  ((@uc_abp.ack_msg_t_0 abp.ack_msg_t) (@uc_abp.data_msg_t_0 abp.data_msg_t) (@abp.index_t_0 abp.index_t) (@uc_abp.value_0 abp.value))
  (abp.index.le @abp.index_t_0 @abp.index_t_0)
  (abp.sender_bit)
  (= abp.bot @uc_abp.value_0)
  (= abp.index.zero @abp.index_t_0)
  (= abp.receiver_i @abp.index_t_0)
  (= abp.sender_gen_i @abp.index_t_0)
  (= abp.sender_i @abp.index_t_0)
  (= abp.tp1.sk0 @abp.index_t_0)
  (= (abp.d @uc_abp.data_msg_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_0) @uc_abp.value_0)
)
(model N2
  ((@uc_abp.ack_msg_t_0 abp.ack_msg_t) (@uc_abp.data_msg_t_0 abp.data_msg_t) (@abp.index_t_0 abp.index_t) (@uc_abp.value_0 abp.value))
  (abp.index.le @abp.index_t_0 @abp.index_t_0)
  (abp.receiver_bit)
  (= abp.bot @uc_abp.value_0)
  (= abp.index.zero @abp.index_t_0)
  (= abp.receiver_i @abp.index_t_0)
  (= abp.sender_gen_i @abp.index_t_0)
  (= abp.sender_i @abp.index_t_0)
  (= abp.tp1.sk0 @abp.index_t_0)
  (= (abp.d @uc_abp.data_msg_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_0) @uc_abp.value_0)
)
(model P3
  ((@uc_abp.ack_msg_t_0 abp.ack_msg_t) (@uc_abp.data_msg_t_0 abp.data_msg_t) (@abp.index_t_0 abp.index_t) (@uc_abp.value_0 abp.value))
  (abp.index.le @abp.index_t_0 @abp.index_t_0)
  (abp.receiver_bit)
  (abp.sender_bit)
  (= abp.bot @uc_abp.value_0)
  (= abp.index.zero @abp.index_t_0)
  (= abp.receiver_i @abp.index_t_0)
  (= abp.sender_gen_i @abp.index_t_0)
  (= abp.sender_i @abp.index_t_0)
  (= abp.tp1.sk0 @abp.index_t_0)
  (= (abp.d @uc_abp.data_msg_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_0) @uc_abp.value_0)
)
(model P4
  ((@uc_abp.ack_msg_t_0 abp.ack_msg_t) (@uc_abp.data_msg_t_0 abp.data_msg_t) (@abp.index_t_0 abp.index_t) (@abp.index_t_1 abp.index_t) (@uc_abp.value_0 abp.value))
  (abp.index.le @abp.index_t_0 @abp.index_t_0)
  (abp.index.le @abp.index_t_1 @abp.index_t_0)
  (abp.index.le @abp.index_t_1 @abp.index_t_1)
  (abp.receiver_bit)
  (= abp.bot @uc_abp.value_0)
  (= abp.index.zero @abp.index_t_1)
  (= abp.receiver_i @abp.index_t_0)
  (= abp.sender_gen_i @abp.index_t_0)
  (= abp.sender_i @abp.index_t_1)
  (= abp.tp1.sk0 @abp.index_t_0)
  (= (abp.d @uc_abp.data_msg_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_1) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_1) @uc_abp.value_0)
)
(model N5
  ((@uc_abp.ack_msg_t_0 abp.ack_msg_t) (@uc_abp.data_msg_t_0 abp.data_msg_t) (@abp.index_t_0 abp.index_t) (@abp.index_t_1 abp.index_t) (@uc_abp.value_0 abp.value))
  (abp.index.le @abp.index_t_0 @abp.index_t_0)
  (abp.index.le @abp.index_t_0 @abp.index_t_1)
  (abp.index.le @abp.index_t_1 @abp.index_t_1)
  (abp.receiver_bit)
  (= abp.bot @uc_abp.value_0)
  (= abp.index.zero @abp.index_t_0)
  (= abp.receiver_i @abp.index_t_0)
  (= abp.sender_gen_i @abp.index_t_1)
  (= abp.sender_i @abp.index_t_0)
  (= abp.tp1.sk0 @abp.index_t_0)
  (= (abp.d @uc_abp.data_msg_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_1) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_1) @uc_abp.value_0)
)
(model N6
  ((@uc_abp.ack_msg_t_0 abp.ack_msg_t) (@uc_abp.data_msg_t_0 abp.data_msg_t) (@abp.index_t_0 abp.index_t) (@abp.index_t_1 abp.index_t) (@uc_abp.value_0 abp.value))
  (abp.index.le @abp.index_t_0 @abp.index_t_0)
  (abp.index.le @abp.index_t_0 @abp.index_t_1)
  (abp.index.le @abp.index_t_1 @abp.index_t_1)
  (abp.receiver_bit)
  (= abp.bot @uc_abp.value_0)
  (= abp.index.zero @abp.index_t_0)
  (= abp.receiver_i @abp.index_t_0)
  (= abp.sender_gen_i @abp.index_t_0)
  (= abp.sender_i @abp.index_t_0)
  (= abp.tp1.sk0 @abp.index_t_1)
  (= (abp.d @uc_abp.data_msg_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_1) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_1) @uc_abp.value_0)
)
(model N7
  ((@uc_abp.ack_msg_t_0 abp.ack_msg_t) (@uc_abp.data_msg_t_0 abp.data_msg_t) (@abp.index_t_0 abp.index_t) (@abp.index_t_1 abp.index_t) (@uc_abp.value_0 abp.value))
  (abp.index.le @abp.index_t_0 @abp.index_t_0)
  (abp.index.le @abp.index_t_1 @abp.index_t_0)
  (abp.index.le @abp.index_t_1 @abp.index_t_1)
  (abp.receiver_bit)
  (= abp.bot @uc_abp.value_0)
  (= abp.index.zero @abp.index_t_1)
  (= abp.receiver_i @abp.index_t_0)
  (= abp.sender_gen_i @abp.index_t_0)
  (= abp.sender_i @abp.index_t_0)
  (= abp.tp1.sk0 @abp.index_t_0)
  (= (abp.d @uc_abp.data_msg_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_1) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_1) @uc_abp.value_0)
)
(model N8
  ((@uc_abp.ack_msg_t_0 abp.ack_msg_t) (@uc_abp.data_msg_t_0 abp.data_msg_t) (@abp.index_t_0 abp.index_t) (@abp.index_t_1 abp.index_t) (@abp.index_t_2 abp.index_t) (@uc_abp.value_0 abp.value))
  (abp.index.le @abp.index_t_0 @abp.index_t_0)
  (abp.index.le @abp.index_t_1 @abp.index_t_0)
  (abp.index.le @abp.index_t_1 @abp.index_t_1)
  (abp.index.le @abp.index_t_2 @abp.index_t_0)
  (abp.index.le @abp.index_t_2 @abp.index_t_1)
  (abp.index.le @abp.index_t_2 @abp.index_t_2)
  (abp.receiver_bit)
  (= abp.bot @uc_abp.value_0)
  (= abp.index.zero @abp.index_t_2)
  (= abp.receiver_i @abp.index_t_0)
  (= abp.sender_gen_i @abp.index_t_0)
  (= abp.sender_i @abp.index_t_2)
  (= abp.tp1.sk0 @abp.index_t_0)
  (= (abp.d @uc_abp.data_msg_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_1) @uc_abp.value_0)
  (= (abp.receiver_array @abp.index_t_2) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_0) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_1) @uc_abp.value_0)
  (= (abp.sender_array @abp.index_t_2) @uc_abp.value_0)
)

(constraint P0 (not N1) (not N2) P3 P4 (not N5) (not N6) (not N7) (not N8))
