; File: examples/fol/client_server_db_ae.pyv

; Sig
(sort db_request_id)
(sort node)
(sort request)
(sort response)
(relation db_request_sent db_request_id request)
(relation db_response_sent db_request_id response)
(relation match request response)
(relation request_sent node request)
(relation response_received node response)
(relation response_sent node response)
(relation t db_request_id node)
; End sig

; Axioms

; Conjecture c3
(conjecture (forall I db_request_id (forall P response (or (not (db_response_sent I P)) (exists R request (and (db_request_sent I R) (match R P)))))))



(model P0
  ((@uc_response_0 response) (@uc_request_0 request) (@uc_db_request_id_0 db_request_id) (@uc_node_0 node))
  (db_request_sent @uc_db_request_id_0 @uc_request_0)
  (match @uc_request_0 @uc_response_0)
)

(model N0
  ((@uc_response_0 response) (@uc_request_0 request) (@uc_db_request_id_0 db_request_id) (@uc_node_0 node))
  (db_response_sent @uc_db_request_id_0 @uc_response_0)
  (match @uc_request_0 @uc_response_0)
)

(model N1
  ((@uc_request_0 request) (@uc_response_0 response) (@uc_db_request_id_0 db_request_id) (@uc_node_0 node))
  (db_request_sent @uc_db_request_id_0 @uc_request_0)
  (db_response_sent @uc_db_request_id_0 @uc_response_0)
)

(model N2
  ((@uc_response_0 response) (@uc_request_0 request) (@uc_db_request_id_0 db_request_id) (@uc_db_request_id_1 db_request_id) (@uc_node_0 node))
  (db_request_sent @uc_db_request_id_0 @uc_request_0)
  (db_response_sent @uc_db_request_id_1 @uc_response_0)
  (match @uc_request_0 @uc_response_0)
)

(model N3
  ((@uc_response_0 response) (@uc_response_1 response) (@uc_request_0 request) (@uc_db_request_id_0 db_request_id) (@uc_node_0 node))
  (db_response_sent @uc_db_request_id_0 @uc_response_0)
  (match @uc_request_0 @uc_response_0)
  (match @uc_request_0 @uc_response_1)
)

(model P1
  ((@uc_response_0 response) (@uc_request_0 request) (@uc_db_request_id_0 db_request_id) (@uc_node_0 node))
  (db_request_sent @uc_db_request_id_0 @uc_request_0)
  (db_response_sent @uc_db_request_id_0 @uc_response_0)
  (match @uc_request_0 @uc_response_0)
)

(constraint P0 P1 (not N0) (not N1) (not N2) (not N3))
