  ((@uc_abp.ack_msg_t_0 abp.ack_msg_t) (@abp.data_msg_t_0 abp.data_msg_t) (@abp.data_msg_t_1 abp.data_msg_t) (@abp.index_t_0 abp.index_t) (@abp.value_0 abp.value) (@abp.value_1 abp.value))
  (abp.data_msg.le @abp.data_msg_t_0 @abp.data_msg_t_0)
