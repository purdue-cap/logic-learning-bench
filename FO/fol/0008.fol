  (= abp.receiver_i @abp.index_t_0)
  (= abp.sender_gen_i @abp.index_t_1)
  (= abp.sender_i @abp.index_t_0)
  (= abp.tp1.sk0 @abp.index_t_0)
  (= (abp.d @abp.data_msg_t_0) @abp.value_0)
  (= (abp.receiver_array @abp.index_t_0) @abp.value_0)
  (= (abp.receiver_array @abp.index_t_1) @abp.value_0)
  (= (abp.sender_array @abp.index_t_0) @abp.value_1)
  (= (abp.sender_array @abp.index_t_1) @abp.value_0)
)
