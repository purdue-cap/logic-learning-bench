; File: examples/fol/sharded_kv.pyv

; Sig
(sort key)
(sort node)
(sort value)
(relation owner node key)
(relation table node key value)
(relation transfer_msg node key value)
; End sig

; Axioms

; Conjecture c1
(conjecture (forall N node (forall K key (forall V value (or (not (table N K V)) (owner N K))))))



(model P0
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_key_0 key))
  (owner @uc_node_0 @uc_key_0)
  (table @uc_node_0 @uc_key_0 @uc_value_0)
)

(model N0
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_key_0 key))
  (table @uc_node_0 @uc_key_0 @uc_value_0)
)

(model N1
  ((@uc_node_0 node) (@uc_node_1 node) (@uc_value_0 value) (@uc_key_0 key))
  (owner @uc_node_0 @uc_key_0)
  (table @uc_node_0 @uc_key_0 @uc_value_0)
  (table @uc_node_1 @uc_key_0 @uc_value_0)
)

(model N2
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_key_0 key) (@uc_key_1 key))
  (owner @uc_node_0 @uc_key_0)
  (table @uc_node_0 @uc_key_0 @uc_value_0)
  (table @uc_node_0 @uc_key_1 @uc_value_0)
)

(model P1
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_key_0 key))

)

(constraint P0 P1 (not N0) (not N1) (not N2))
