; File: good-ivy-examples/fol-thresholds/fast_paxos.ivy

; Sig
(sort node)
(sort quorum_c)
(sort quorum_f)
(sort round)
(sort value)
(relation any_msg round)
(relation decision node round value)
(relation fast round)
(relation le round round)
(relation left_rnd node round)
(relation member_c node quorum_c)
(relation member_f node quorum_f)
(constant none round)
(relation one_a round)
(relation one_b node round)
(relation proposal round value)
(relation s node)
(relation vote node round value)
; End sig

; Axiom a
(axiom (forall Q1 quorum_c (forall Q2 quorum_c (exists N node (and (member_c N Q1) (member_c N Q2))))))
; Axiom a0
(axiom (forall Q3 quorum_f (forall Q1 quorum_c (forall Q2 quorum_f (exists N node (and (and (member_c N Q1) (member_f N Q2)) (member_f N Q3)))))))
; Axiom a1
(axiom (forall X round (le X X)))
; Axiom a2
(axiom (forall X round (forall Z round (forall Y round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom a3
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom a4
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))


; Conjecture c9
(conjecture (forall V1 value (forall V2 value (forall R2 round (forall R1 round (forall Q quorum_f (or (not (and (and (fast R1) (not (le R2 R1))) (or (and (proposal R2 V2) (not (= V1 V2))) (any_msg R2)))) (exists N node (and (and (member_f N Q) (left_rnd N R1)) (not (vote N R1 V1)))))))))))

(model P0
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_f_0 quorum_f) (@round_0 round) (@value_0 value))
  (any_msg @round_0)
  (fast @round_0)
  (le @round_0 @round_0)
  (left_rnd @node_0 @round_0)
  (member_c @node_0 @quorum_c_0)
  (member_f @node_0 @quorum_f_0)
  (proposal @round_0 @value_0)
  (vote @node_0 @round_0 @value_0)
  (= none @round_0)
)
(model N1
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_f_0 quorum_f) (@round_0 round) (@round_1 round) (@value_0 value))
  (any_msg @round_0)
  (any_msg @round_1)
  (fast @round_0)
  (fast @round_1)
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (left_rnd @node_0 @round_1)
  (member_c @node_0 @quorum_c_0)
  (member_f @node_0 @quorum_f_0)
  (vote @node_0 @round_0 @value_0)
  (vote @node_0 @round_1 @value_0)
  (= none @round_0)
)
(model N2
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_f_0 quorum_f) (@round_0 round) (@round_1 round) (@value_0 value))
  (any_msg @round_0)
  (any_msg @round_1)
  (fast @round_0)
  (fast @round_1)
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (left_rnd @node_0 @round_1)
  (member_c @node_0 @quorum_c_0)
  (member_f @node_0 @quorum_f_0)
  (proposal @round_0 @value_0)
  (proposal @round_1 @value_0)
  (vote @node_0 @round_0 @value_0)
  (vote @node_0 @round_1 @value_0)
  (= none @round_0)
)
(model P3
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_f_0 quorum_f) (@round_0 round) (@round_1 round) (@value_0 value))
  (any_msg @round_0)
  (fast @round_0)
  (fast @round_1)
  (le @round_0 @round_0)
  (le @round_0 @round_1)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (left_rnd @node_0 @round_1)
  (member_c @node_0 @quorum_c_0)
  (member_f @node_0 @quorum_f_0)
  (proposal @round_0 @value_0)
  (proposal @round_1 @value_0)
  (vote @node_0 @round_0 @value_0)
  (vote @node_0 @round_1 @value_0)
  (= none @round_1)
)
(model N4
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_f_0 quorum_f) (@round_0 round) (@round_1 round) (@value_0 value))
  (any_msg @round_1)
  (fast @round_0)
  (fast @round_1)
  (le @round_0 @round_0)
  (le @round_0 @round_1)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (left_rnd @node_0 @round_1)
  (member_c @node_0 @quorum_c_0)
  (member_f @node_0 @quorum_f_0)
  (vote @node_0 @round_0 @value_0)
  (vote @node_0 @round_1 @value_0)
  (= none @round_0)
)
(model N5
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_f_0 quorum_f) (@round_0 round) (@round_1 round) (@value_0 value) (@value_1 value))
  (fast @round_0)
  (fast @round_1)
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (left_rnd @node_0 @round_1)
  (member_c @node_0 @quorum_c_0)
  (member_f @node_0 @quorum_f_0)
  (proposal @round_0 @value_0)
  (proposal @round_0 @value_1)
  (proposal @round_1 @value_0)
  (proposal @round_1 @value_1)
  (vote @node_0 @round_0 @value_0)
  (vote @node_0 @round_0 @value_1)
  (vote @node_0 @round_1 @value_0)
  (vote @node_0 @round_1 @value_1)
  (= none @round_0)
)

(constraint P0 (not N1) (not N2) P3 (not N4) (not N5))
