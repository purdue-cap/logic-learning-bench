; File: good-ivy-examples/oopsla17-paxos/flexible_paxos_epr.ivy

; Sig
(sort node)
(sort quorum_1)
(sort quorum_2)
(sort round)
(sort value)
(relation decision node round value)
(relation le round round)
(relation left_rnd node round)
(relation member_1 node quorum_1)
(relation member_2 node quorum_2)
(constant none round)
(relation one_a round)
(relation one_b node round)
(relation one_b_max_vote node round round value)
(relation proposal round value)
(relation vote node round value)
; End sig

; Axiom a
(axiom (forall X round (le X X)))
; Axiom a0
(axiom (forall X round (forall Z round (forall Y round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom a1
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom a2
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))
; Axiom a3
(axiom (forall Q2 quorum_2 (forall Q1 quorum_1 (exists N node (and (member_1 N Q1) (member_2 N Q2))))))


; Conjecture c9
(conjecture (forall N node (forall R2 round (forall R1 round (or (not (and (one_b N R2) (not (le R2 R1)))) (left_rnd N R1))))))

(model P0
  ((@node_0 node) (@quorum_1_0 quorum_1) (@quorum_2_0 quorum_2) (@round_0 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (left_rnd @node_0 @round_0)
  (member_1 @node_0 @quorum_1_0)
  (member_2 @node_0 @quorum_2_0)
  (one_b @node_0 @round_0)
  (= none @round_0)
)
(model N1
  ((@node_0 node) (@quorum_1_0 quorum_1) (@quorum_2_0 quorum_2) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (member_1 @node_0 @quorum_1_0)
  (member_2 @node_0 @quorum_2_0)
  (one_b @node_0 @round_0)
  (one_b @node_0 @round_1)
  (= none @round_0)
)
(model N2
  ((@node_0 node) (@quorum_1_0 quorum_1) (@quorum_2_0 quorum_2) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (member_1 @node_0 @quorum_1_0)
  (member_2 @node_0 @quorum_2_0)
  (one_b @node_0 @round_0)
  (one_b @node_0 @round_1)
  (= none @round_0)
)
(model P3
  ((@node_0 node) (@quorum_1_0 quorum_1) (@quorum_2_0 quorum_2) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_0 @round_1)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (left_rnd @node_0 @round_1)
  (member_1 @node_0 @quorum_1_0)
  (member_2 @node_0 @quorum_2_0)
  (one_b @node_0 @round_0)
  (one_b @node_0 @round_1)
  (= none @round_1)
)
(model N4
  ((@node_0 node) (@node_1 node) (@quorum_1_0 quorum_1) (@quorum_2_0 quorum_2) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (left_rnd @node_1 @round_1)
  (member_1 @node_0 @quorum_1_0)
  (member_1 @node_1 @quorum_1_0)
  (member_2 @node_0 @quorum_2_0)
  (member_2 @node_1 @quorum_2_0)
  (one_b @node_0 @round_0)
  (one_b @node_0 @round_1)
  (one_b @node_1 @round_0)
  (one_b @node_1 @round_1)
  (= none @round_0)
)
(model N5
  ((@node_0 node) (@node_1 node) (@quorum_1_0 quorum_1) (@quorum_2_0 quorum_2) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (left_rnd @node_1 @round_0)
  (left_rnd @node_1 @round_1)
  (member_1 @node_0 @quorum_1_0)
  (member_1 @node_1 @quorum_1_0)
  (member_2 @node_0 @quorum_2_0)
  (member_2 @node_1 @quorum_2_0)
  (one_b @node_0 @round_0)
  (one_b @node_0 @round_1)
  (one_b @node_1 @round_0)
  (one_b @node_1 @round_1)
  (= none @round_0)
)
(model P6
  ((@node_0 node) (@quorum_1_0 quorum_1) (@quorum_2_0 quorum_2) (@round_0 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (member_1 @node_0 @quorum_1_0)
  (member_2 @node_0 @quorum_2_0)
  (one_b @node_0 @round_0)
  (= none @round_0)
)
(model N7
  ((@node_0 node) (@quorum_1_0 quorum_1) (@quorum_2_0 quorum_2) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (left_rnd @node_0 @round_0)
  (member_1 @node_0 @quorum_1_0)
  (member_2 @node_0 @quorum_2_0)
  (one_b @node_0 @round_0)
  (one_b @node_0 @round_1)
  (= none @round_1)
)

(constraint P0 (not N1) (not N2) P3 (not N4) (not N5) P6 (not N7))
