; File: good-ivy-examples/oopsla17-paxos/flexible_paxos_epr.ivy

; Sig
(sort node)
(sort quorum_1)
(sort quorum_2)
(sort round)
(sort value)
(relation decision node round value)
(relation le round round)
(relation left_rnd node round)
(relation member_1 node quorum_1)
(relation member_2 node quorum_2)
(constant none round)
(relation one_a round)
(relation one_b node round)
(relation one_b_max_vote node round round value)
(relation proposal round value)
(relation vote node round value)
; End sig

; Axiom a
(axiom (forall X round (le X X)))
; Axiom a0
(axiom (forall X round (forall Z round (forall Y round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom a1
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom a2
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))
; Axiom a3
(axiom (forall Q2 quorum_2 (forall Q1 quorum_1 (exists N node (and (member_1 N Q1) (member_2 N Q2))))))


; Conjecture c
(conjecture (forall R1 round (forall V1 value (forall V2 value (forall R2 round (forall N1 node (forall N2 node (or (not (and (decision N1 R1 V1) (decision N2 R2 V2))) (= V1 V2)))))))))

(model P0
  ((@node_0 node) (@quorum_1_0 quorum_1) (@quorum_2_0 quorum_2) (@round_0 round) (@value_0 value))
  (decision @node_0 @round_0 @value_0)
  (le @round_0 @round_0)
  (member_1 @node_0 @quorum_1_0)
  (member_2 @node_0 @quorum_2_0)
  (= none @round_0)
)
(model N1
  ((@node_0 node) (@quorum_1_0 quorum_1) (@quorum_2_0 quorum_2) (@round_0 round) (@value_0 value) (@value_1 value))
  (decision @node_0 @round_0 @value_0)
  (decision @node_0 @round_0 @value_1)
  (le @round_0 @round_0)
  (member_1 @node_0 @quorum_1_0)
  (member_2 @node_0 @quorum_2_0)
  (= none @round_0)
)
(model P2
  ((@node_0 node) (@quorum_1_0 quorum_1) (@quorum_2_0 quorum_2) (@round_0 round) (@value_0 value) (@value_1 value))
  (le @round_0 @round_0)
  (member_1 @node_0 @quorum_1_0)
  (member_2 @node_0 @quorum_2_0)
  (= none @round_0)
)
(model N3
  ((@node_0 node) (@node_1 node) (@quorum_1_0 quorum_1) (@quorum_2_0 quorum_2) (@round_0 round) (@value_0 value) (@value_1 value))
  (decision @node_0 @round_0 @value_0)
  (decision @node_0 @round_0 @value_1)
  (le @round_0 @round_0)
  (member_1 @node_0 @quorum_1_0)
  (member_1 @node_1 @quorum_1_0)
  (member_2 @node_0 @quorum_2_0)
  (member_2 @node_1 @quorum_2_0)
  (= none @round_0)
)

(constraint P0 (not N1) P2 (not N3))
