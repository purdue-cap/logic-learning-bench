; File: examples/fol/toy_consensus_forall.pyv

; Sig
(sort node)
(sort quorum)
(sort value)
(constant voting_quorum quorum)
(relation decided value)
(relation member node quorum)
(relation vote node value)
(relation voted node)
; End sig

; Axioms
(axiom (forall Q1 quorum (forall Q2 quorum (exists N node (and (member N Q1) (member N Q2))))))

; Conjecture c0
(conjecture (forall V1 value (forall V2 value (or (not (and (decided V1) (decided V2))) (= V1 V2)))))



(model P0
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_quorum_0 quorum))
  (= voting_quorum @uc_quorum_0)
  (decided @uc_value_0)
  (member @uc_node_0 @uc_quorum_0)
)

(model N0
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_value_1 value) (@uc_quorum_0 quorum))
  (= voting_quorum @uc_quorum_0)
  (decided @uc_value_0)
  (decided @uc_value_1)
  (member @uc_node_0 @uc_quorum_0)
)

(model P1
  ((@uc_node_0 node) (@uc_value_0 value) (@uc_value_1 value) (@uc_quorum_0 quorum))
  (= voting_quorum @uc_quorum_0)
  (member @uc_node_0 @uc_quorum_0)
)

(constraint P0 P1 (not N0))
