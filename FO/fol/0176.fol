; File: examples/fol/consensus_epr.pyv

; Sig
(sort node)
(sort quorum)
(sort value)
(relation decided node value)
(relation leader node)
(relation member node quorum)
(relation vote_msg node node)
(relation vote_request_msg node node)
(relation voted node)
(relation votes node node)
; End sig

; Axioms
(axiom (forall Q1 quorum (forall Q2 quorum (exists N node (and (member N Q1) (member N Q2))))))

; Conjecture c4
(conjecture (forall N node (forall N1 node (or (not (vote_msg N N1)) (voted N)))))



(model P0
  ((@uc_quorum_0 quorum) (@uc_node_0 node) (@uc_value_0 value))
  (member @uc_node_0 @uc_quorum_0)
  (vote_msg @uc_node_0 @uc_node_0)
  (voted @uc_node_0)
)

(model N0
  ((@uc_quorum_0 quorum) (@uc_node_0 node) (@uc_value_0 value))
  (member @uc_node_0 @uc_quorum_0)
  (vote_msg @uc_node_0 @uc_node_0)
)

(model N1
  ((@uc_quorum_0 quorum) (@uc_node_0 node) (@uc_node_1 node) (@uc_value_0 value))
  (member @uc_node_0 @uc_quorum_0)
  (member @uc_node_1 @uc_quorum_0)
  (vote_msg @uc_node_0 @uc_node_0)
  (vote_msg @uc_node_0 @uc_node_1)
  (vote_msg @uc_node_1 @uc_node_0)
  (vote_msg @uc_node_1 @uc_node_1)
  (voted @uc_node_1)
)

(model P1
  ((@uc_quorum_0 quorum) (@uc_node_0 node) (@uc_value_0 value))
  (member @uc_node_0 @uc_quorum_0)
)

(model N2
  ((@uc_quorum_0 quorum) (@uc_node_0 node) (@uc_node_1 node) (@uc_value_0 value))
  (member @uc_node_0 @uc_quorum_0)
  (member @uc_node_1 @uc_quorum_0)
  (vote_msg @uc_node_0 @uc_node_0)
  (vote_msg @uc_node_0 @uc_node_1)
  (vote_msg @uc_node_1 @uc_node_0)
  (voted @uc_node_0)
)

(constraint P0 P1 (not N0) (not N1) (not N2))
