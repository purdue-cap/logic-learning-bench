; File: good-ivy-examples/fol-thresholds/byz_paxos.ivy

; Sig
(sort node)
(sort quorum_c)
(sort quorum_w)
(sort round)
(sort value)
(relation decision node round value)
(relation le round round)
(relation left_rnd node round)
(relation member_b node)
(relation member_c node quorum_c)
(relation member_w node quorum_w)
(constant none round)
(relation one_a round)
(relation one_b node round)
(relation prepare node round value)
(relation proposal round value)
(relation rcved_one_b node round node)
(relation vote node round value)
; End sig

; Axiom axiom1
(axiom (forall X round (le X X)))
; Axiom axiom2
(axiom (forall X round (forall Z round (forall Y round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom axiom3
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom axiom4
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))
; Axiom axiom5
(axiom (forall Q1 quorum_c (forall Q2 quorum_c (exists N node (and (not (member_b N)) (member_c N Q1) (member_c N Q2))))))
; Axiom axiom6
(axiom (forall W quorum_w (exists N node (and (not (member_b N)) (member_w N W)))))


; Conjecture conj12
(conjecture (forall N node (forall R round (forall V value (or (not (and (not (member_b N)) (decision N R V))) (exists Q quorum_c (forall N2 node (or (not (and (not (member_b N2)) (member_c N2 Q))) (vote N2 R V)))))))))

(model P0
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@value_0 value))
  (le @round_0 @round_0)
  (member_c @node_0 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (vote @node_0 @round_0 @value_0)
  (= none @round_0)
)
(model N1
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@value_0 value))
  (decision @node_0 @round_0 @value_0)
  (le @round_0 @round_0)
  (member_c @node_0 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (= none @round_0)
)
(model N2
  ((@node_0 node) (@node_1 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@value_0 value))
  (decision @node_1 @round_0 @value_0)
  (le @round_0 @round_0)
  (member_c @node_0 @quorum_c_0)
  (member_c @node_1 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (member_w @node_1 @quorum_w_0)
  (= none @round_0)
)
(model N3
  ((@node_0 node) (@node_1 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@value_0 value))
  (decision @node_0 @round_0 @value_0)
  (decision @node_1 @round_0 @value_0)
  (le @round_0 @round_0)
  (member_c @node_0 @quorum_c_0)
  (member_c @node_1 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (member_w @node_1 @quorum_w_0)
  (vote @node_0 @round_0 @value_0)
  (= none @round_0)
)
(model N4
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@round_1 round) (@value_0 value))
  (decision @node_0 @round_0 @value_0)
  (decision @node_0 @round_1 @value_0)
  (le @round_0 @round_0)
  (le @round_0 @round_1)
  (le @round_1 @round_1)
  (member_c @node_0 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (vote @node_0 @round_1 @value_0)
  (= none @round_1)
)
(model N5
  ((@node_0 node) (@quorum_c_0 quorum_c) (@quorum_w_0 quorum_w) (@round_0 round) (@round_1 round) (@value_0 value))
  (decision @node_0 @round_0 @value_0)
  (le @round_0 @round_0)
  (le @round_0 @round_1)
  (le @round_1 @round_1)
  (member_c @node_0 @quorum_c_0)
  (member_w @node_0 @quorum_w_0)
  (= none @round_1)
)

(constraint P0 (not N1) (not N2) (not N3) (not N4) (not N5))
