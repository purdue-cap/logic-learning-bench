        (exists ((P Bool)) (and (FO.x0.node.x1.node.Sem p n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 x1 P) (= result (not P))))
      )
      ((fol.ctx-x0-node-x1-node.and p q)
        (exists ((P Bool) (Q Bool)) (and (FO.x0.node.x1.node.Sem p n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 x1 P) (FO.x0.node.x1.node.Sem q n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 x1 Q) (= result (and P Q))))
      )
      ((fol.ctx-x0-node-x1-node.or p q)
        (exists ((P Bool) (Q Bool)) (and (FO.x0.node.x1.node.Sem p n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 x1 P) (FO.x0.node.x1.node.Sem q n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 x1 Q) (= result (or P Q))))
      )
      ((fol.ctx-x0-node-x1-node.forall.x0.node p)
        (exists ((V_x0_0 Int) (P_x0_0 Bool) (V_x0_1 Int) (P_x0_1 Bool)) (and (= V_x0_0 0) (= V_x0_1 1) (FO.x0.node.x1.node.Sem p n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 V_x0_0 x1 P_x0_0) (FO.x0.node.x1.node.Sem p n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 V_x0_1 x1 P_x0_1) (= result (and (or (not (< V_x0_0 n0)) P_x0_0) (or (not (< V_x0_1 n0)) P_x0_1)))))
      )
      ((fol.ctx-x0-node-x1-node.exists.x0.node p)
        (exists ((V_x0_0 Int) (P_x0_0 Bool) (V_x0_1 Int) (P_x0_1 Bool)) (and (= V_x0_0 0) (= V_x0_1 1) (FO.x0.node.x1.node.Sem p n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 V_x0_0 x1 P_x0_0) (FO.x0.node.x1.node.Sem p n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 V_x0_1 x1 P_x0_1) (= result (or (and (< V_x0_0 n0) P_x0_0) (and (< V_x0_1 n0) P_x0_1)))))
      )
      ((fol.ctx-x0-node-x1-node.forall.x1.node p)
        (exists ((V_x1_0 Int) (P_x1_0 Bool) (V_x1_1 Int) (P_x1_1 Bool)) (and (= V_x1_0 0) (= V_x1_1 1) (FO.x0.node.x1.node.Sem p n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 V_x1_0 P_x1_0) (FO.x0.node.x1.node.Sem p n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 V_x1_1 P_x1_1) (= result (and (or (not (< V_x1_0 n0)) P_x1_0) (or (not (< V_x1_1 n0)) P_x1_1)))))
      )
      ((fol.ctx-x0-node-x1-node.exists.x1.node p)
        (exists ((V_x1_0 Int) (P_x1_0 Bool) (V_x1_1 Int) (P_x1_1 Bool)) (and (= V_x1_0 0) (= V_x1_1 1) (FO.x0.node.x1.node.Sem p n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 V_x1_0 P_x1_0) (FO.x0.node.x1.node.Sem p n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 V_x1_1 P_x1_1) (= result (or (and (< V_x1_0 n0) P_x1_0) (and (< V_x1_1 n0) P_x1_1)))))
      )
      ((fol.ctx-x0-node-x1-node.eq.node lhs rhs)
        (exists ((L Int) (R Int)) (and (Term.x0.node.x1.node.node.Sem lhs n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 x1 L) (Term.x0.node.x1.node.node.Sem rhs n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 x1 R) (= result (= L R))))
      )
      ((fol.ctx-x0-node-x1-node.atom.allowed_in a0)
        (exists ((A0 Int)) (and (Term.x0.node.x1.node.node.Sem a0 n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 x1 A0) (= result (ite (= A0 0) r0_0 (ite (= A0 1) r0_1 false)))))
      )
      ((fol.ctx-x0-node-x1-node.atom.internal a0)
        (exists ((A0 Int)) (and (Term.x0.node.x1.node.node.Sem a0 n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 x1 A0) (= result (ite (= A0 0) r1_0 (ite (= A0 1) r1_1 false)))))
      )
      ((fol.ctx-x0-node-x1-node.atom.sent a0 a1)
        (exists ((A0 Int) (A1 Int)) (and (Term.x0.node.x1.node.node.Sem a0 n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 x1 A0) (Term.x0.node.x1.node.node.Sem a1 n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 x1 A1) (= result (ite (and (= A0 0) (= A1 0)) r2_0 (ite (and (= A0 0) (= A1 1)) r2_1 (ite (and (= A0 1) (= A1 0)) r2_2 (ite (and (= A0 1) (= A1 1)) r2_3 false)))))))
      )
    )) :input (n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 x1) :output (result))
    (! (match t (
      ((fol.ctx-x0-node.var.x0.node)
        (= value x0)
      )
    )) :input (n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0) :output (value))
    (! (match t (
      ((fol.ctx-x1-node.var.x1.node)
        (= value x1)
      )
    )) :input (n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x1) :output (value))
    (! (match t (
      ((fol.ctx-x0-node-x1-node.var.x0.node)
        (= value x0)
      )
      ((fol.ctx-x0-node-x1-node.var.x1.node)
        (= value x1)
      )
    )) :input (n0 r0_0 r0_1 r1_0 r1_1 r2_0 r2_1 r2_2 r2_3 x0 x1) :output (value))
  )
)

