(define-semantics
  ((FO.Sem (phi FO0) (asp FO.Asp)))
  ((match phi
     ((fol.0.true) true)
     ((fol.0.false) false)
     ((fol.0.not p) (not (FO.Sem p asp)))
     ((fol.0.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.0.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.0.forall.x0.node p)
      (forall ((v node))
        (FO.x0.node.Sem p (FO.Asp.x0.node v))))
     ((fol.0.exists.x0.node p)
      (exists ((v node))
        (FO.x0.node.Sem p (FO.Asp.x0.node v))))
     ((fol.0.forall.x0.quorum_a p)
      (forall ((v quorum_a))
        (FO.x0.quorum_a.Sem p (FO.Asp.x0.quorum_a v))))
     ((fol.0.exists.x0.quorum_a p)
      (exists ((v quorum_a))
        (FO.x0.quorum_a.Sem p (FO.Asp.x0.quorum_a v))))
     ((fol.0.forall.x0.quorum_b p)
      (forall ((v quorum_b))
        (FO.x0.quorum_b.Sem p (FO.Asp.x0.quorum_b v))))
     ((fol.0.exists.x0.quorum_b p)
      (exists ((v quorum_b))
        (FO.x0.quorum_b.Sem p (FO.Asp.x0.quorum_b v))))
     ((fol.0.forall.x0.quorum_c p)
      (forall ((v quorum_c))
        (FO.x0.quorum_c.Sem p (FO.Asp.x0.quorum_c v))))
     ((fol.0.exists.x0.quorum_c p)
      (exists ((v quorum_c))
        (FO.x0.quorum_c.Sem p (FO.Asp.x0.quorum_c v))))
     ((fol.0.forall.x0.value p)
      (forall ((v value))
        (FO.x0.value.Sem p (FO.Asp.x0.value v))))
     ((fol.0.exists.x0.value p)
      (exists ((v value))
        (FO.x0.value.Sem p (FO.Asp.x0.value v))))
     ((fol.0.forall.x1.node p)
      (forall ((v node))
        (FO.x1.node.Sem p (FO.Asp.x1.node v))))
     ((fol.0.exists.x1.node p)
      (exists ((v node))
        (FO.x1.node.Sem p (FO.Asp.x1.node v))))
