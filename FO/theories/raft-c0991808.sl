(declare-sort index 0)
(declare-sort log 0)
(declare-sort node 0)
(declare-sort option_index 0)
(declare-sort option_term 0)
(declare-sort quorum 0)
(declare-sort term 0)
(declare-sort value 0)
(declare-fun commit_index () index)
(declare-fun commit_log () log)
(declare-fun commit_quorum () quorum)
(declare-fun commit_term () term)
(declare-fun commit_value () value)
(declare-fun index_zero () index)
(declare-fun log0 () log)
(declare-fun none_index () option_index)
(declare-fun none_term () option_term)
(declare-fun term_zero () term)
(declare-fun current_log (node) log)
(declare-fun oi_index (option_index) index)
(declare-fun ot_term (option_term) term)
(declare-fun term_leader (term) node)
(declare-fun term_log (term) log)
(declare-fun value_at (log index) value)
(declare-fun voting_quorum (term) quorum)
(declare-fun append_msg (term option_index option_term index term value) Bool)
(declare-fun append_reply_msg (node term index term) Bool)
(declare-fun committed (index value) Bool)
(declare-fun current_term (node term) Bool)
(declare-fun index_le (index index) Bool)
(declare-fun index_used (log index) Bool)
(declare-fun is_none_index (option_index) Bool)
(declare-fun is_none_term (option_term) Bool)
(declare-fun leader (node term) Bool)
(declare-fun left_term (node term) Bool)
(declare-fun member (node quorum) Bool)
(declare-fun request_vote_msg (node term option_index option_term) Bool)
(declare-fun started (term) Bool)
(declare-fun term_at (log index term) Bool)
(declare-fun term_le (term term) Bool)
(declare-fun valid (log) Bool)
(declare-fun vote_msg (node term node) Bool)
(declare-fun voted (node term) Bool)

