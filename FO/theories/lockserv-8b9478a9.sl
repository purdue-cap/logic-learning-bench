 (((fol.0.true)
   (fol.0.false)
   (fol.0.not FO0)
   (fol.0.and FO0 FO0)
   (fol.0.or FO0 FO0)
   (fol.0.forall.x0.node Formula.x0.node)
   (fol.0.exists.x0.node Formula.x0.node)
   (fol.0.forall.x1.node Formula.x1.node)
   (fol.0.exists.x1.node Formula.x1.node)
   (fol.0.atom.server_holds_lock))
  ((fol.ctx-x0-node.true)
