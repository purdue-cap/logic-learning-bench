; Canonical Boolean algebraic axioms for pruning.
(declare-axiom (= (fol.0.and x y) (fol.0.and y x)))
(declare-axiom (= (fol.0.and (fol.0.and x y) z) (fol.0.and x (fol.0.and y z))))
(declare-axiom (= (fol.0.and x x) x))
(declare-axiom (= (fol.0.or x y) (fol.0.or y x)))
(declare-axiom (= (fol.0.or (fol.0.or x y) z) (fol.0.or x (fol.0.or y z))))
(declare-axiom (= (fol.0.or x x) x))
(declare-axiom (= (fol.ctx-x0-node.and x y) (fol.ctx-x0-node.and y x)))
(declare-axiom (= (fol.ctx-x0-node.and (fol.ctx-x0-node.and x y) z) (fol.ctx-x0-node.and x (fol.ctx-x0-node.and y z))))
(declare-axiom (= (fol.ctx-x0-node.and x x) x))
(declare-axiom (= (fol.ctx-x0-node.or x y) (fol.ctx-x0-node.or y x)))
(declare-axiom (= (fol.ctx-x0-node.or (fol.ctx-x0-node.or x y) z) (fol.ctx-x0-node.or x (fol.ctx-x0-node.or y z))))
(declare-axiom (= (fol.ctx-x0-node.or x x) x))
(declare-axiom (= (fol.ctx-x1-node.and x y) (fol.ctx-x1-node.and y x)))
(declare-axiom (= (fol.ctx-x1-node.and (fol.ctx-x1-node.and x y) z) (fol.ctx-x1-node.and x (fol.ctx-x1-node.and y z))))
(declare-axiom (= (fol.ctx-x1-node.and x x) x))
(declare-axiom (= (fol.ctx-x1-node.or x y) (fol.ctx-x1-node.or y x)))
(declare-axiom (= (fol.ctx-x1-node.or (fol.ctx-x1-node.or x y) z) (fol.ctx-x1-node.or x (fol.ctx-x1-node.or y z))))
(declare-axiom (= (fol.ctx-x1-node.or x x) x))
(declare-axiom (= (fol.ctx-x0-node-x1-node.and x y) (fol.ctx-x0-node-x1-node.and y x)))
(declare-axiom (= (fol.ctx-x0-node-x1-node.and (fol.ctx-x0-node-x1-node.and x y) z) (fol.ctx-x0-node-x1-node.and x (fol.ctx-x0-node-x1-node.and y z))))
(declare-axiom (= (fol.ctx-x0-node-x1-node.and x x) x))
(declare-axiom (= (fol.ctx-x0-node-x1-node.or x y) (fol.ctx-x0-node-x1-node.or y x)))
(declare-axiom (= (fol.ctx-x0-node-x1-node.or (fol.ctx-x0-node-x1-node.or x y) z) (fol.ctx-x0-node-x1-node.or x (fol.ctx-x0-node-x1-node.or y z))))
(declare-axiom (= (fol.ctx-x0-node-x1-node.or x x) x))


(define-aspects FO.Asp (record (model Model)))

(define-aspects FO.Asp.x0.node (record (model Model) (x0 node)))

(define-aspects FO.Asp.x1.node (record (model Model) (x1 node)))

(define-aspects FO.Asp.x0.node.x1.node (record (model Model) (x0 node) (x1 node)))

(define-semantics
  ((Term.x0.node.node.Sem (term Term.x0.node.node) (asp FO.Asp.x0.node)))
  :returns node
  ((match term
     ((fol.ctx-x0-node.var.x0.node) (x0 asp))
  )))

(define-semantics
  ((Term.x1.node.node.Sem (term Term.x1.node.node) (asp FO.Asp.x1.node)))
  :returns node
  ((match term
     ((fol.ctx-x1-node.var.x1.node) (x1 asp))
  )))

(define-semantics
  ((Term.x0.node.x1.node.node.Sem (term Term.x0.node.x1.node.node) (asp FO.Asp.x0.node.x1.node)))
  :returns node
  ((match term
     ((fol.ctx-x0-node-x1-node.var.x0.node) (x0 asp))
     ((fol.ctx-x0-node-x1-node.var.x1.node) (x1 asp))
  )))

(define-semantics
  ((FO.Sem (phi FO0) (asp FO.Asp)))
  ((match phi
     ((fol.0.true) true)
     ((fol.0.false) false)
     ((fol.0.not p) (not (FO.Sem p asp)))
     ((fol.0.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.0.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.0.forall.x0.node p)
      (forall ((v (univ (node (model asp)))))
        (FO.x0.node.Sem p (FO.Asp.x0.node (model asp) v))))
     ((fol.0.exists.x0.node p)
      (exists ((v (univ (node (model asp)))))
        (FO.x0.node.Sem p (FO.Asp.x0.node (model asp) v))))
     ((fol.0.forall.x1.node p)
      (forall ((v (univ (node (model asp)))))
        (FO.x1.node.Sem p (FO.Asp.x1.node (model asp) v))))
     ((fol.0.exists.x1.node p)
      (exists ((v (univ (node (model asp)))))
        (FO.x1.node.Sem p (FO.Asp.x1.node (model asp) v))))
     ((fol.0.atom.server_holds_lock) (server_holds_lock))
  )))

(define-semantics
  ((FO.x0.node.Sem (phi Formula.x0.node) (asp FO.Asp.x0.node)))
  ((match phi
     ((fol.ctx-x0-node.true) true)
     ((fol.ctx-x0-node.false) false)
     ((fol.ctx-x0-node.not p) (not (FO.x0.node.Sem p asp)))
     ((fol.ctx-x0-node.and p q) (and (FO.x0.node.Sem p asp) (FO.x0.node.Sem q asp)))
     ((fol.ctx-x0-node.or p q) (or (FO.x0.node.Sem p asp) (FO.x0.node.Sem q asp)))
     ((fol.ctx-x0-node.forall.x0.node p)
      (forall ((v (univ (node (model asp)))))
        (FO.x0.node.Sem p (FO.Asp.x0.node (model asp) v))))
     ((fol.ctx-x0-node.exists.x0.node p)
      (exists ((v (univ (node (model asp)))))
        (FO.x0.node.Sem p (FO.Asp.x0.node (model asp) v))))
     ((fol.ctx-x0-node.forall.x1.node p)
      (forall ((v (univ (node (model asp)))))
        (FO.x0.node.x1.node.Sem p (FO.Asp.x0.node.x1.node (model asp) (x0 asp) v))))
     ((fol.ctx-x0-node.exists.x1.node p)
      (exists ((v (univ (node (model asp)))))
        (FO.x0.node.x1.node.Sem p (FO.Asp.x0.node.x1.node (model asp) (x0 asp) v))))
     ((fol.ctx-x0-node.eq.node lhs rhs)
      (= (Term.x0.node.node.Sem lhs asp) (Term.x0.node.node.Sem rhs asp)))
     ((fol.ctx-x0-node.atom.grant_msg a0) (grant_msg (Term.x0.node.node.Sem a0 asp)))
     ((fol.ctx-x0-node.atom.holds_lock a0) (holds_lock (Term.x0.node.node.Sem a0 asp)))
     ((fol.ctx-x0-node.atom.lock_msg a0) (lock_msg (Term.x0.node.node.Sem a0 asp)))
     ((fol.ctx-x0-node.atom.server_holds_lock) (server_holds_lock))
     ((fol.ctx-x0-node.atom.unlock_msg a0) (unlock_msg (Term.x0.node.node.Sem a0 asp)))
  )))

(define-semantics
  ((FO.x1.node.Sem (phi Formula.x1.node) (asp FO.Asp.x1.node)))
  ((match phi
     ((fol.ctx-x1-node.true) true)
     ((fol.ctx-x1-node.false) false)
     ((fol.ctx-x1-node.not p) (not (FO.x1.node.Sem p asp)))
     ((fol.ctx-x1-node.and p q) (and (FO.x1.node.Sem p asp) (FO.x1.node.Sem q asp)))
     ((fol.ctx-x1-node.or p q) (or (FO.x1.node.Sem p asp) (FO.x1.node.Sem q asp)))
     ((fol.ctx-x1-node.forall.x0.node p)
      (forall ((v (univ (node (model asp)))))
        (FO.x0.node.x1.node.Sem p (FO.Asp.x0.node.x1.node (model asp) v (x1 asp)))))
     ((fol.ctx-x1-node.exists.x0.node p)
      (exists ((v (univ (node (model asp)))))
        (FO.x0.node.x1.node.Sem p (FO.Asp.x0.node.x1.node (model asp) v (x1 asp)))))
     ((fol.ctx-x1-node.forall.x1.node p)
      (forall ((v (univ (node (model asp)))))
        (FO.x1.node.Sem p (FO.Asp.x1.node (model asp) v))))
     ((fol.ctx-x1-node.exists.x1.node p)
      (exists ((v (univ (node (model asp)))))
        (FO.x1.node.Sem p (FO.Asp.x1.node (model asp) v))))
     ((fol.ctx-x1-node.eq.node lhs rhs)
      (= (Term.x1.node.node.Sem lhs asp) (Term.x1.node.node.Sem rhs asp)))
     ((fol.ctx-x1-node.atom.grant_msg a0) (grant_msg (Term.x1.node.node.Sem a0 asp)))
     ((fol.ctx-x1-node.atom.holds_lock a0) (holds_lock (Term.x1.node.node.Sem a0 asp)))
     ((fol.ctx-x1-node.atom.lock_msg a0) (lock_msg (Term.x1.node.node.Sem a0 asp)))
     ((fol.ctx-x1-node.atom.server_holds_lock) (server_holds_lock))
     ((fol.ctx-x1-node.atom.unlock_msg a0) (unlock_msg (Term.x1.node.node.Sem a0 asp)))
  )))

(define-semantics
  ((FO.x0.node.x1.node.Sem (phi Formula.x0.node.x1.node) (asp FO.Asp.x0.node.x1.node)))
  ((match phi
     ((fol.ctx-x0-node-x1-node.true) true)
     ((fol.ctx-x0-node-x1-node.false) false)
     ((fol.ctx-x0-node-x1-node.not p) (not (FO.x0.node.x1.node.Sem p asp)))
     ((fol.ctx-x0-node-x1-node.and p q) (and (FO.x0.node.x1.node.Sem p asp) (FO.x0.node.x1.node.Sem q asp)))
     ((fol.ctx-x0-node-x1-node.or p q) (or (FO.x0.node.x1.node.Sem p asp) (FO.x0.node.x1.node.Sem q asp)))
     ((fol.ctx-x0-node-x1-node.forall.x0.node p)
      (forall ((v (univ (node (model asp)))))
        (FO.x0.node.x1.node.Sem p (FO.Asp.x0.node.x1.node (model asp) v (x1 asp)))))
     ((fol.ctx-x0-node-x1-node.exists.x0.node p)
      (exists ((v (univ (node (model asp)))))
        (FO.x0.node.x1.node.Sem p (FO.Asp.x0.node.x1.node (model asp) v (x1 asp)))))
     ((fol.ctx-x0-node-x1-node.forall.x1.node p)
      (forall ((v (univ (node (model asp)))))
        (FO.x0.node.x1.node.Sem p (FO.Asp.x0.node.x1.node (model asp) (x0 asp) v))))
     ((fol.ctx-x0-node-x1-node.exists.x1.node p)
      (exists ((v (univ (node (model asp)))))
        (FO.x0.node.x1.node.Sem p (FO.Asp.x0.node.x1.node (model asp) (x0 asp) v))))
     ((fol.ctx-x0-node-x1-node.eq.node lhs rhs)
      (= (Term.x0.node.x1.node.node.Sem lhs asp) (Term.x0.node.x1.node.node.Sem rhs asp)))
     ((fol.ctx-x0-node-x1-node.atom.grant_msg a0) (grant_msg (Term.x0.node.x1.node.node.Sem a0 asp)))
     ((fol.ctx-x0-node-x1-node.atom.holds_lock a0) (holds_lock (Term.x0.node.x1.node.node.Sem a0 asp)))
     ((fol.ctx-x0-node-x1-node.atom.lock_msg a0) (lock_msg (Term.x0.node.x1.node.node.Sem a0 asp)))
     ((fol.ctx-x0-node-x1-node.atom.server_holds_lock) (server_holds_lock))
     ((fol.ctx-x0-node-x1-node.atom.unlock_msg a0) (unlock_msg (Term.x0.node.x1.node.node.Sem a0 asp)))
  )))
