(define-semantics
  ((FO.Sem (phi FO0) (asp FO.Asp)))
  ((match phi
     ((fol.0.true) true)
     ((fol.0.false) false)
     ((fol.0.not p) (not (FO.Sem p asp)))
     ((fol.0.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.0.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.0.forall.x0.id p)
      (forall ((v id))
        (FO.x0.id.Sem p (FO.Asp.x0.id v))))
     ((fol.0.exists.x0.id p)
      (exists ((v id))
        (FO.x0.id.Sem p (FO.Asp.x0.id v))))
     ((fol.0.forall.x0.node p)
      (forall ((v node))
        (FO.x0.node.Sem p (FO.Asp.x0.node v))))
     ((fol.0.exists.x0.node p)
      (exists ((v node))
        (FO.x0.node.Sem p (FO.Asp.x0.node v))))
     ((fol.0.forall.x1.id p)
      (forall ((v id))
        (FO.x1.id.Sem p (FO.Asp.x1.id v))))
     ((fol.0.exists.x1.id p)
      (exists ((v id))
        (FO.x1.id.Sem p (FO.Asp.x1.id v))))
     ((fol.0.forall.x1.node p)
      (forall ((v node))
        (FO.x1.node.Sem p (FO.Asp.x1.node v))))
     ((fol.0.exists.x1.node p)
      (exists ((v node))
        (FO.x1.node.Sem p (FO.Asp.x1.node v))))
  )))

