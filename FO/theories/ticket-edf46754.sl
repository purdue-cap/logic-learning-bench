     ((fol.ctx-x0-thread.atom.pc1 a0) (pc1 (Term.x0.thread.thread.Sem a0 asp)))
     ((fol.ctx-x0-thread.atom.pc2 a0) (pc2 (Term.x0.thread.thread.Sem a0 asp)))
     ((fol.ctx-x0-thread.atom.pc3 a0) (pc3 (Term.x0.thread.thread.Sem a0 asp)))
  )))

(define-semantics
