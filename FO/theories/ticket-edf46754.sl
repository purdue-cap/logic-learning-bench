(define-semantics
  ((FO.Sem (phi FO0) (asp FO.Asp)))
  ((match phi
     ((fol.0.true) true)
     ((fol.0.false) false)
     ((fol.0.not p) (not (FO.Sem p asp)))
     ((fol.0.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.0.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.0.forall.x0.thread p)
      (forall ((v (univ (thread (model asp)))))
        (FO.x0.thread.Sem p (FO.Asp.x0.thread (model asp) v))))
     ((fol.0.exists.x0.thread p)
      (exists ((v (univ (thread (model asp)))))
        (FO.x0.thread.Sem p (FO.Asp.x0.thread (model asp) v))))
     ((fol.0.forall.x0.ticket p)
      (forall ((v (univ (ticket (model asp)))))
        (FO.x0.ticket.Sem p (FO.Asp.x0.ticket (model asp) v))))
     ((fol.0.exists.x0.ticket p)
      (exists ((v (univ (ticket (model asp)))))
        (FO.x0.ticket.Sem p (FO.Asp.x0.ticket (model asp) v))))
     ((fol.0.forall.x1.thread p)
      (forall ((v (univ (thread (model asp)))))
        (FO.x1.thread.Sem p (FO.Asp.x1.thread (model asp) v))))
     ((fol.0.exists.x1.thread p)
      (exists ((v (univ (thread (model asp)))))
        (FO.x1.thread.Sem p (FO.Asp.x1.thread (model asp) v))))
     ((fol.0.forall.x1.ticket p)
      (forall ((v (univ (ticket (model asp)))))
        (FO.x1.ticket.Sem p (FO.Asp.x1.ticket (model asp) v))))
     ((fol.0.exists.x1.ticket p)
      (exists ((v (univ (ticket (model asp)))))
        (FO.x1.ticket.Sem p (FO.Asp.x1.ticket (model asp) v))))
     ((fol.0.eq.ticket lhs rhs)
      (= (Term.0.ticket.Sem lhs asp) (Term.0.ticket.Sem rhs asp)))
     ((fol.0.atom.le a0 a1) (le (Term.0.ticket.Sem a0 asp) (Term.0.ticket.Sem a1 asp)))
  )))

(define-semantics
  ((FO.x0.thread.Sem (phi Formula.x0.thread) (asp FO.Asp.x0.thread)))
