(define-semantics
  ((FO.Sem (phi FO0) (asp FO.Asp)))
  ((match phi
     ((fol.0.true) true)
     ((fol.0.false) false)
     ((fol.0.not p) (not (FO.Sem p asp)))
     ((fol.0.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.0.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.0.forall.x0.key p)
      (forall ((v (univ (key (model asp)))))
        (FO.x0.key.Sem p (FO.Asp.x0.key (model asp) v))))
     ((fol.0.exists.x0.key p)
      (exists ((v (univ (key (model asp)))))
        (FO.x0.key.Sem p (FO.Asp.x0.key (model asp) v))))
     ((fol.0.forall.x0.node p)
      (forall ((v (univ (node (model asp)))))
        (FO.x0.node.Sem p (FO.Asp.x0.node (model asp) v))))
     ((fol.0.exists.x0.node p)
      (exists ((v (univ (node (model asp)))))
        (FO.x0.node.Sem p (FO.Asp.x0.node (model asp) v))))
     ((fol.0.forall.x0.value p)
      (forall ((v (univ (value (model asp)))))
        (FO.x0.value.Sem p (FO.Asp.x0.value (model asp) v))))
     ((fol.0.exists.x0.value p)
      (exists ((v (univ (value (model asp)))))
        (FO.x0.value.Sem p (FO.Asp.x0.value (model asp) v))))
     ((fol.0.forall.x1.key p)
      (forall ((v (univ (key (model asp)))))
        (FO.x1.key.Sem p (FO.Asp.x1.key (model asp) v))))
     ((fol.0.exists.x1.key p)
      (exists ((v (univ (key (model asp)))))
        (FO.x1.key.Sem p (FO.Asp.x1.key (model asp) v))))
     ((fol.0.forall.x1.node p)
      (forall ((v (univ (node (model asp)))))
