  (interp-sort abp.ack_msg_t (@uc_abp.ack_msg_t_0 @uc_abp.ack_msg_t_1 @uc_abp.ack_msg_t_2))
  (interp-sort abp.data_msg_t (@uc_abp.data_msg_t_0))
  (interp-sort abp.index_t (@uc_abp.index_t_0))
  (interp-sort abp.value (@uc_abp.value_0))
  (interp-fun abp.bot (@uc_abp.value_0))
  (interp-fun abp.index.zero (@uc_abp.index_t_0))
  (interp-fun abp.receiver_i (@uc_abp.index_t_0))
  (interp-fun abp.sender_gen_i (@uc_abp.index_t_0))
  (interp-fun abp.sender_i (@uc_abp.index_t_0))
  (interp-fun abp.tp1.sk0 (@uc_abp.index_t_0))
  (interp-fun abp.d (match (
    ((@uc_abp.data_msg_t_0) @uc_abp.value_0)
    ((_) @uc_abp.value_0)
  )))
  (interp-fun abp.receiver_array (match (
    ((@uc_abp.index_t_0) @uc_abp.value_0)
    ((_) @uc_abp.value_0)
  )))
  (interp-fun abp.sender_array (match (
    ((@uc_abp.index_t_0) @uc_abp.value_0)
    ((_) @uc_abp.value_0)
  )))
  (interp-fun abp.abit (match (
    ((_) false)
  )))
  (interp-fun abp.ack_msg.le (match (
    ((@uc_abp.ack_msg_t_0 @uc_abp.ack_msg_t_2) true)
    ((@uc_abp.ack_msg_t_1 @uc_abp.ack_msg_t_0) true)
    ((@uc_abp.ack_msg_t_2 @uc_abp.ack_msg_t_1) true)
    ((_ _) false)
  )))
  (interp-fun abp.ack_received (false))
  (interp-fun abp.ack_sent (false))
  (interp-fun abp.data_msg.le (match (
    ((_ _) false)
  )))
  (interp-fun abp.data_received (false))
  (interp-fun abp.data_sent (false))
  (interp-fun abp.dbit (match (
    ((_) false)
  )))
  (interp-fun abp.index.le (match (
    ((@uc_abp.index_t_0 @uc_abp.index_t_0) true)
    ((_ _) false)
  )))
  (interp-fun abp.receiver_bit (false))
  (interp-fun abp.receiver_scheduled (false))
  (interp-fun abp.sender_bit (false))
  (interp-fun abp.sender_scheduled (false))
)

(synth-fun phi () FO0)

(constraint (with-model P0 (FO.Sem phi (FO.Asp))))
(constraint (with-model P1 (FO.Sem phi (FO.Asp))))
(constraint (with-model P2 (FO.Sem phi (FO.Asp))))
(constraint (with-model P3 (FO.Sem phi (FO.Asp))))
(constraint (not (with-model N0 (FO.Sem phi (FO.Asp)))))
(constraint (not (with-model N1 (FO.Sem phi (FO.Asp)))))
(constraint (not (with-model N2 (FO.Sem phi (FO.Asp)))))
(constraint (not (with-model N3 (FO.Sem phi (FO.Asp)))))
(constraint (not (with-model N4 (FO.Sem phi (FO.Asp)))))
(constraint (not (with-model N5 (FO.Sem phi (FO.Asp)))))

(check-synth)
