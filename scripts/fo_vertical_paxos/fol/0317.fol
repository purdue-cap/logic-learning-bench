; File: good-ivy-examples/oopsla17-paxos/vertical_paxos_epr_unverified_optimization.ivy

; Sig
(sort config)
(sort node)
(sort quorum)
(sort round)
(sort value)
(relation configure_round_msg round config)
(relation decision node round value)
(relation irrelevant_msg round)
(relation joined_round node round)
(relation le round round)
(relation left_rnd node round)
(constant master_minrel round)
(relation member node quorum)
(relation minrelof config round)
(constant none round)
(relation one_a round round)
(relation one_b_max_vote node round round value)
(relation proposal round value)
(function quorum_of_round round quorum)
(relation quorumin quorum config)
(relation vote node round value)
; End sig

; Axiom a
(axiom (forall X round (le X X)))
; Axiom a0
(axiom (forall X round (forall Z round (forall Y round (or (not (and (le X Y) (le Y Z))) (le X Z))))))
; Axiom a1
(axiom (forall X round (forall Y round (or (not (and (le X Y) (le Y X))) (= X Y)))))
; Axiom a2
(axiom (forall X round (forall Y round (or (le X Y) (le Y X)))))
; Axiom a3
(axiom (forall C config (forall Q2 quorum (forall Q1 quorum (or (not (and (quorumin Q1 C) (quorumin Q2 C))) (exists N node (and (member N Q1) (member N Q2))))))))


; Conjecture c6
(conjecture (forall C config (forall R2 round (forall R1 round (forall R3 round (or (not (and (or (= R2 master_minrel) (and (configure_round_msg R3 C) (minrelof C R2))) (not (le R2 R1)))) (irrelevant_msg R2)))))))

(model P0
  ((@config_0 config) (@node_0 node) (@quorum_0 quorum) (@round_0 round) (@uc_value_0 value))
  (configure_round_msg @round_0 @config_0)
  (irrelevant_msg @round_0)
  (le @round_0 @round_0)
  (member @node_0 @quorum_0)
  (minrelof @config_0 @round_0)
  (= master_minrel @round_0)
  (= none @round_0)
  (= (quorum_of_round @round_0) @quorum_0)
)
(model N1
  ((@config_0 config) (@node_0 node) (@quorum_0 quorum) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (configure_round_msg @round_0 @config_0)
  (configure_round_msg @round_1 @config_0)
  (irrelevant_msg @round_0)
  (le @round_0 @round_0)
  (le @round_0 @round_1)
  (le @round_1 @round_1)
  (member @node_0 @quorum_0)
  (minrelof @config_0 @round_0)
  (minrelof @config_0 @round_1)
  (= master_minrel @round_0)
  (= none @round_0)
  (= (quorum_of_round @round_0) @quorum_0)
  (= (quorum_of_round @round_1) @quorum_0)
)
(model P2
  ((@config_0 config) (@node_0 node) (@quorum_0 quorum) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (configure_round_msg @round_0 @config_0)
  (configure_round_msg @round_1 @config_0)
  (irrelevant_msg @round_0)
  (irrelevant_msg @round_1)
  (le @round_0 @round_0)
  (le @round_0 @round_1)
  (le @round_1 @round_1)
  (member @node_0 @quorum_0)
  (minrelof @config_0 @round_0)
  (minrelof @config_0 @round_1)
  (= master_minrel @round_0)
  (= none @round_1)
  (= (quorum_of_round @round_0) @quorum_0)
  (= (quorum_of_round @round_1) @quorum_0)
)
(model N3
  ((@config_0 config) (@node_0 node) (@quorum_0 quorum) (@round_0 round) (@round_1 round) (@uc_value_0 value))
  (le @round_0 @round_0)
  (le @round_1 @round_0)
  (le @round_1 @round_1)
  (member @node_0 @quorum_0)
  (= master_minrel @round_0)
  (= none @round_0)
  (= (quorum_of_round @round_0) @quorum_0)
  (= (quorum_of_round @round_1) @quorum_0)
)
(model P4
  ((@config_0 config) (@node_0 node) (@quorum_0 quorum) (@round_0 round) (@uc_value_0 value))
  (configure_round_msg @round_0 @config_0)
  (le @round_0 @round_0)
  (member @node_0 @quorum_0)
  (minrelof @config_0 @round_0)
