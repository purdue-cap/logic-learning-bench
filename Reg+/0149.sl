(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/156) — gt=concat(<num>,contain(or(<m0>,<m1>)))")
(set-info :description "lines with a number before the strings '!' or '@'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00110 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00129 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00392 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00688 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00683 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01027 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01272 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00215 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00065 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00149 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00665 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00120 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01266 head tail))))

(check-synth)
