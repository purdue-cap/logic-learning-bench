(constraint (not (RegLan.Sem r (RegLan.Asp w00020 0 (size (Pos w00020))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00169 0 (size (Pos w00169))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00162 0 (size (Pos w00162))))))
