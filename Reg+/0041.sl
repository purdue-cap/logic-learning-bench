(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/41) — gt=concat(not(<any>),contain(endwith(<low>)))")
(set-info :description "lines with no character before lower-case letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00038 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00224 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00740 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00218 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00222 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00511 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00758 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00020 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00169 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00162 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00446 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00457 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00461 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00723 head tail))))

(check-synth)
