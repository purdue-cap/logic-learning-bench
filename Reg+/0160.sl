(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/167) — gt=star(endwith(<let>))")
(set-info :description "lines with words ending in zero or more letters")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00038 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00039 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00230 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00119 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00405 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00353 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00080 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00002 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00115 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00865 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00935 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00747 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00323 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00743 head tail))))

(check-synth)
