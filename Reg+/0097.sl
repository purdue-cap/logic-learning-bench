(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/101) — gt=and(not(<num>),star(<let>))")
(set-info :description "lines without zero or more of a number and letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00038 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00229 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00524 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00741 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00934 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01199 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01399 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00012 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00141 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00421 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00109 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00662 head tail))))

(check-synth)
