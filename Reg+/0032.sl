(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/32) — gt=concat(<m0>,contain(concat(<num>,contain(<any>))))")
(set-info :description "lines with the string '!' before a number with a character after")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00325 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00837 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00989 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00330 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00331 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00614 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00829 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00068 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00079 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00215 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00217 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00348 head tail))))

(check-synth)
