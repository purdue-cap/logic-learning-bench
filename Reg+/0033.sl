(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/33) — gt=startwith(or(<low>,<cap>))")
(set-info :description "lines which are starting with a lower-case letter or a capital letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00038 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00020 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00229 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00169 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00224 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00172 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00217 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00010 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00106 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00108 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00105 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00003 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00068 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00019 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
