(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/33) — gt=startwith(or(<low>,<cap>))")
(set-info :description "lines which are starting with a lower-case letter or a capital letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00038 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00020 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00229 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00169 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00224 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00172 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00217 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00106 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00108 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00105 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00003 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00068 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00019 head tail))))

(check-synth)
