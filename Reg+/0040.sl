(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/40) — gt=endwith(concat(<vow>,contain(<num>)))")
(set-info :description "items terminating with vowel preceding a numeral .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00218 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00545 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00646 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00817 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00968 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00211 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01129 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00179 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00038 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00041 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00302 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00601 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00280 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00642 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
