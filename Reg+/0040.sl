(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/40) — gt=endwith(concat(<vow>,contain(<num>)))")
(set-info :description "items terminating with vowel preceding a numeral .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00218 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00545 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00646 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00817 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00968 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00211 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01129 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00179 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00041 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00302 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00601 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00280 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00642 head tail))))

(check-synth)
