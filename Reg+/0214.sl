(set-info :author "Chentian Wu")
(set-info :source "REGEL (stackoverflow/14) — gt=concat(star(<0>),or(concat(or(<0>,or(<1>,or(<2>,or(<3>,<4>)))),optional(concat(<.>,concat(optional(<5>),star(<0>))))),concat(<5>,concat(<.>,star(<0>)))))")
(set-info :description "write a Regular Expression validator to accept numbers only with decimal part 0 or 5 only and in range 0-5. No matter how many 0 in front or behind the numbers it can be valid.")

