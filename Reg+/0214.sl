(constraint      (RegLan.Sem r (RegLan.Asp w00036 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00177 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00176 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00490 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00406 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00099 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00007 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00106 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00008 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00118 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00009 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00122 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00010 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00124 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00011 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00025 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00087 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00024 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00185 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00128 head tail))))
