(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/66) — gt=concat(<m0>,contain(not(<let>)))")
(set-info :description "lines with the string '!' before a non letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00003 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01258 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00644 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00626 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01329 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01152 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01331 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w01209 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00409 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00037 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01252 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00750 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00125 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00059 head tail))))

(check-synth)
