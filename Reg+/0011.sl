(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/11) — gt=concat(or(or(<m0>,<low>),<m1>),contain(<vow>))")
(set-info :description "lines with the string '!' or '@' or lower-case letter before a vowel")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00079 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00154 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00246 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00341 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00695 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00649 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00640 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00175 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00003 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00019 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00041 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00009 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00102 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00383 head tail))))

(check-synth)
