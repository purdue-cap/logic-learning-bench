(constraint      (with-model w00246 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00341 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00695 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00649 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00640 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00175 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00003 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00019 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00041 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00009 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00102 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00383 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
