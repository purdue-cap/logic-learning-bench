(constraint      (with-model w00137 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00272 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00273 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00011 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00038 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00009 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00007 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00172 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00180 (RegLan.Sem r (RegLan.Asp head tail)))))
