(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/9) — gt=concat(or(<num>,<low>),contain(<any>))")
(set-info :description "lines with a number or lower-case letter before character")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

