(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/9) — gt=concat(or(<num>,<low>),contain(<any>))")
(set-info :description "lines with a number or lower-case letter before character")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00119 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00229 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00112 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00239 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00137 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00272 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00273 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00009 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00007 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00172 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00180 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00191 head tail))))

(check-synth)
