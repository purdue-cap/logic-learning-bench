(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/102) — gt=startwith(or(repeatatleast(<let>,4),<m0>))")
(set-info :description "lines stating with 4 or more letters or the string '!'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00938 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00003 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00079 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00848 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01315 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01433 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01528 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00893 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00018 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00229 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00524 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00591 head tail))))

(check-synth)
