(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/98) — gt=or(repeatatleast(<vow>,4),startwith(<m0>))")
(set-info :description "lines with 4 or more vowels or starting in string '!'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00089 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01442 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01260 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01156 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00753 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00943 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00003 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00408 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00104 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00232 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00532 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00755 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01126 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00381 head tail))))

(check-synth)
