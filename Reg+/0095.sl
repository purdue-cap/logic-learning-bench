(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/98) — gt=or(repeatatleast(<vow>,4),startwith(<m0>))")
(set-info :description "lines with 4 or more vowels or starting in string '!'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00089 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01442 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01260 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01156 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00753 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00943 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00003 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00408 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00104 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00232 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00532 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00755 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01126 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00381 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
