(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/136) — gt=and(concat(<vow>,contain(<m0>)),endwith(<low>))")
(set-info :description "lines with a vowel before the string '!' and ending in a lower-case letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00499 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00437 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01367 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01181 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00791 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00921 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01059 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00583 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00718 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00496 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00233 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01068 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01182 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01292 head tail))))

(check-synth)
