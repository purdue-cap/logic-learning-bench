(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/136) — gt=and(concat(<vow>,contain(<m0>)),endwith(<low>))")
(set-info :description "lines with a vowel before the string '!' and ending in a lower-case letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00499 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00437 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01367 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01181 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00791 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00921 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01059 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00583 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00718 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00496 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00233 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01068 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01182 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01292 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
