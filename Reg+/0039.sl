(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/39) — gt=concat(concat(<low>,contain(<m0>)),contain(<cap>))")
(set-info :description "lines with a lower-case letter before the string '!' then a capital letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00493 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00738 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00724 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00946 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00726 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00932 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00815 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00215 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00003 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00076 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00236 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00188 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00482 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00497 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
