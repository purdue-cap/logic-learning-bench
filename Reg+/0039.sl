(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/39) — gt=concat(concat(<low>,contain(<m0>)),contain(<cap>))")
(set-info :description "lines with a lower-case letter before the string '!' then a capital letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00493 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00738 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00724 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00946 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00726 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00932 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00815 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00215 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00003 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00076 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00236 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00188 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00482 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00497 head tail))))

(check-synth)
