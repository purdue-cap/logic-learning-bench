(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/74) — gt=not(startwith(or(<m0>,<num>)))")
(set-info :description "lines which are not starting with the string '!' or a number")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")
(require "./global/models.deepregex.empty.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp wempty_deepregex head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00699 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00956 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01180 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00722 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01142 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01053 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00003 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01018 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01271 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01173 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01150 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00012 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00016 head tail))))

(check-synth)
