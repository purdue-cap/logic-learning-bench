(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/162) — gt=not(repeatatleast(<let>,1))")
(set-info :description "lines that don't only contain a letter , once or more")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")
(require "./global/models.deepregex.empty.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp wempty_deepregex head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00002 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00011 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00003 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00019 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00012 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00665 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00039 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00020 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00021 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00170 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00021 head tail))))

(check-synth)
