(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/25) — gt=star(concat(<low>,contain(<let>)))")
(set-info :description "lines containing a lower-case letter preceding a letter , zero or more times")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00229 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00524 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00741 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00934 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01074 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01199 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01302 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00154 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00155 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00079 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00172 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00108 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00119 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00020 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
