(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/25) — gt=star(concat(<low>,contain(<let>)))")
(set-info :description "lines containing a lower-case letter preceding a letter , zero or more times")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00229 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00524 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00741 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00934 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01074 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01199 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01302 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00154 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00155 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00079 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00172 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00108 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00119 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00020 head tail))))

(check-synth)
