(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/123) — gt=concat(<low>,contain(or(or(<cap>,<m0>),<any>)))")
(set-info :description "items with a small letter preceding either '!' , a character , or an upper case letter .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00215 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00225 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00227 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00736 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00252 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00558 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00557 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00079 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00183 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01186 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01295 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00075 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00176 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00458 head tail))))

(check-synth)
