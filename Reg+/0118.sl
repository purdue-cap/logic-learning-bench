(constraint      (with-model w00252 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00558 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00557 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00079 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00183 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01186 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01295 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00075 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00176 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00458 (RegLan.Sem r (RegLan.Asp head tail)))))

