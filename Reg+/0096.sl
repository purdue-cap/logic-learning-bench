(constraint      (with-model w00641 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00850 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w01086 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00215 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00142 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00149 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01116 (RegLan.Sem r (RegLan.Asp head tail)))))
