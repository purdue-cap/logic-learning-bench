(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/100) — gt=concat(<m0>,contain(or(or(<num>,<m1>),<let>)))")
(set-info :description "lines that contain the string '!' followed by a number , a letter , or the string '@'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00333 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00073 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00998 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00079 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00338 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00641 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00850 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w01086 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00215 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00142 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00149 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01116 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00006 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00725 head tail))))

(check-synth)
