(constraint      (RegLan.Sem r (RegLan.Asp w00003 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00215 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00238 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00162 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00110 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00498 head tail))))
