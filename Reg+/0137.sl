(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/143) — gt=concat(repeatatleast(<cap>,1),contain(<low>))")
(set-info :description "items with an upper case letter at least 1 time preceding a small letter .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00913 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00196 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00716 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00466 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00917 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00922 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00463 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00254 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00400 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00566 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00411 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00474 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00473 head tail))))

(check-synth)
