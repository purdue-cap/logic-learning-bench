(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/143) — gt=concat(repeatatleast(<cap>,1),contain(<low>))")
(set-info :description "items with an upper case letter at least 1 time preceding a small letter .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00913 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00196 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00716 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00466 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00917 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00922 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00463 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00038 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00254 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00400 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00566 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00411 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00474 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00473 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
