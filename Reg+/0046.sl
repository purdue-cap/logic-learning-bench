(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/46) — gt=concat(contain(<low>),contain(<cap>))")
(set-info :description "lines in which a lower-case letter is present prior to the appearance of capital letters")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w01356 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01530 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01543 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01542 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00225 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00515 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01014 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00172 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00707 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01283 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00024 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00345 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00981 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01444 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
