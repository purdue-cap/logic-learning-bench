(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/46) — gt=concat(contain(<low>),contain(<cap>))")
(set-info :description "lines in which a lower-case letter is present prior to the appearance of capital letters")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w01356 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01530 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01543 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01542 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00225 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00515 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01014 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00172 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00707 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01283 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00024 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00345 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00981 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01444 head tail))))

(check-synth)
