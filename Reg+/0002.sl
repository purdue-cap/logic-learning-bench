(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/2) — gt=repeatatleast(or(<let>,<low>),6)")
(set-info :description "lines with a letter or a lower-case letter , 6 or more times in them")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w01074 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01033 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01199 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01174 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01071 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01197 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01215 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00039 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00019 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00009 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00394 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00530 head tail))))

(check-synth)
