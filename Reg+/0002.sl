(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/2) — gt=repeatatleast(or(<let>,<low>),6)")
(set-info :description "lines with a letter or a lower-case letter , 6 or more times in them")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w01074 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01033 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01199 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01174 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01071 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01197 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01215 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00011 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00038 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00039 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00019 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00009 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00394 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00530 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
