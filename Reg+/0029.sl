(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/29) — gt=concat(repeatatleast(<m0>,1),contain(not(<m1>)))")
(set-info :description "likes with the string '!' at least once before the string '@'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00073 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00318 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00613 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00340 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00616 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00831 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00986 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00019 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00223 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00152 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00435 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00116 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00129 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00694 head tail))))

(check-synth)
