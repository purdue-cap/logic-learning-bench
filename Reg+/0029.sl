(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/29) — gt=concat(repeatatleast(<m0>,1),contain(not(<m1>)))")
(set-info :description "likes with the string '!' at least once before the string '@'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00073 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00318 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00613 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00340 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00616 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00831 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00986 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00019 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00223 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00152 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00435 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00116 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00129 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00694 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
