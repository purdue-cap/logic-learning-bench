(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/56) — gt=repeatatleast(concat(<let>,contain(<vow>)),3)")
(set-info :description "lines with letter followed by vowel , 3 or more times")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w01115 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01112 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01122 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01125 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01114 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01535 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01552 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w01113 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00783 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01100 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01111 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00965 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01028 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01445 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
