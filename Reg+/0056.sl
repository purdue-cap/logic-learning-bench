(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/56) — gt=repeatatleast(concat(<let>,contain(<vow>)),3)")
(set-info :description "lines with letter followed by vowel , 3 or more times")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w01115 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01112 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01122 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01125 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01114 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01535 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01552 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w01113 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00783 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01100 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01111 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00965 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01028 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01445 head tail))))

(check-synth)
