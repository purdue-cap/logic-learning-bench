(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/139) — gt=concat(startwith(<m0>),contain(<num>))")
(set-info :description "lines starting with string '!' before number")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00845 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00070 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00647 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00651 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00849 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00855 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00840 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00747 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00772 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00578 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00780 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00422 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00803 head tail))))

(check-synth)
