(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/20) — gt=concat(<vow>,contain(or(<m0>,<num>)))")
(set-info :description "items with a vowel preceding a numeral or '!' .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00215 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00262 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00275 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00288 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00595 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00730 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00754 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00041 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00012 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00229 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00445 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00443 head tail))))

(check-synth)
