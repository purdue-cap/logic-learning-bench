(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/20) — gt=concat(<vow>,contain(or(<m0>,<num>)))")
(set-info :description "items with a vowel preceding a numeral or '!' .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00215 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00262 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00275 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00288 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00595 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00730 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00754 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00038 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00041 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00011 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00012 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00229 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00445 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00443 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
