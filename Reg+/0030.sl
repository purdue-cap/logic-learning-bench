(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/30) — gt=not(concat(contain(<m0>),contain(<any>)))")
(set-info :description "lines without the string '!' followsed by a character")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")
(require "./global/models.deepregex.empty.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp wempty_deepregex head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00038 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00020 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00019 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00010 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00229 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00441 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00079 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00079 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00065 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00073 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00068 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00317 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00319 head tail))))

(check-synth)
