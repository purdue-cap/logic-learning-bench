(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/30) — gt=not(concat(contain(<m0>),contain(<any>)))")
(set-info :description "lines without the string '!' followsed by a character")

(require "./global/theories.deepregex.sl")
