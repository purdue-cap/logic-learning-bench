(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/45) — gt=concat(repeatatleast(<let>,7),contain(<vow>))")
(set-info :description "lines with 7 or more letters before a vowel")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w01280 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01349 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01434 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01474 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01475 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01507 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01520 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00309 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00603 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00819 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00980 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01141 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01232 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01236 head tail))))

(check-synth)
