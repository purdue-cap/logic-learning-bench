(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/45) — gt=concat(repeatatleast(<let>,7),contain(<vow>))")
(set-info :description "lines with 7 or more letters before a vowel")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w01280 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01349 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01434 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01474 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01475 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01507 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01520 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00309 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00603 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00819 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00980 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01141 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01232 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01236 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
