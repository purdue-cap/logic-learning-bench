(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/150) — gt=endwith(or(concat(<low>,contain(<m0>)),<num>))")
(set-info :description "lines which are ending with a lower-case letter followed by the string '!' or a number")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00215 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00220 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00469 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00468 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00687 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01095 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01020 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00477 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00110 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00880 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00135 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00648 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00785 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00043 head tail))))

(check-synth)
