(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/150) — gt=endwith(or(concat(<low>,contain(<m0>)),<num>))")
(set-info :description "lines which are ending with a lower-case letter followed by the string '!' or a number")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00215 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00220 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00469 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00468 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00687 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01095 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01020 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00477 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00110 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00880 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00135 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00648 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00785 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00043 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
