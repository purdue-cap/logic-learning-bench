(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/64) — gt=repeatatleast(startwith(<cap>),3)")
(set-info :description "lines with 3 or more words that start in a capital letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w01422 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01483 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01551 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01553 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01545 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01549 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01547 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00451 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01467 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01481 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01538 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00053 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01534 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01517 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
