(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/64) — gt=repeatatleast(startwith(<cap>),3)")
(set-info :description "lines with 3 or more words that start in a capital letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w01422 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01483 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01551 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01553 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01545 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01549 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01547 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00451 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01467 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01481 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01538 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00053 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01534 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01517 head tail))))

(check-synth)
