(constraint (not (RegLan.Sem r (RegLan.Asp w00264 0 (size (Pos w00264))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00284 0 (size (Pos w00284))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00464 0 (size (Pos w00464))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00203 0 (size (Pos w00203))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00457 0 (size (Pos w00457))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00449 0 (size (Pos w00449))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00422 0 (size (Pos w00422))))))
