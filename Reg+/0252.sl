(constraint      (RegLan.Sem r (RegLan.Asp w00348 0 (size (Pos w00348)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00168 0 (size (Pos w00168)))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00088 0 (size (Pos w00088))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00103 0 (size (Pos w00103))))))
