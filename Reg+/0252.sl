(set-info :author "Chentian Wu")
(set-info :source "REGEL (stackoverflow/55) — gt=and(not(startwith(repeatatleast(<0>,2))),concat(repeatatleast(<num>,1),concat(<.>,repeat(<num>,2))))")
(set-info :description "R1: there is at least one digit. (could be zero)")

(require "./global/theories.stackoverflow.sl")
(require "./global/models.stackoverflow.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00169 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00170 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00344 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00417 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00491 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00348 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00168 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00088 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00103 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00096 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00264 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00284 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00464 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00203 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00457 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00449 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00422 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00418 head tail))))

(check-synth)
