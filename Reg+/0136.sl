(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/142) — gt=repeatatleast(<let>,7)")
(set-info :description "lines with 7 times a letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w01207 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01176 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01241 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01314 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01351 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01324 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01352 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w01080 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01037 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00945 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01006 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01164 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01200 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01228 head tail))))

(check-synth)
