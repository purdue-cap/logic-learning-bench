(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/4) — gt=star(concat(<low>,contain(<cap>)))")
(set-info :description "lines with a lower case letter followed by capital letter , zero or more time")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00224 (RegLan.Sem r (RegLan.Asp head tail))))
