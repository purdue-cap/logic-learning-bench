(constraint      (with-model w00541 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00542 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00734 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00735 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00544 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00038 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00039 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00011 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00012 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00229 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00169 (RegLan.Sem r (RegLan.Asp head tail)))))
