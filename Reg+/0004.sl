(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/4) — gt=star(concat(<low>,contain(<cap>)))")
(set-info :description "lines with a lower case letter followed by capital letter , zero or more time")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00224 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00243 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00541 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00542 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00734 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00735 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00544 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00039 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00012 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00229 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00169 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00002 head tail))))

(check-synth)
