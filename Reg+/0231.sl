(set-info :author "Chentian Wu")
(set-info :source "REGEL (stackoverflow/32) — gt=concat(repeatatleast(<num>,1),concat(<.>,repeatrange(<num>,1,4)))")
(set-info :description "I'm trying to devise a regular expression which will accept decimal number up to 4 digits.")

(require "./global/theories.stackoverflow.sl")
(require "./global/models.stackoverflow.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00123 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00359 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00436 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00573 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00097 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00005 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00202 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00164 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00435 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00434 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00352 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00300 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00433 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00505 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00466 head tail))))

(check-synth)
