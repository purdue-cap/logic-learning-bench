(constraint      (with-model w00954 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00798 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00021 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00182 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00127 (RegLan.Sem r (RegLan.Asp head tail)))))
