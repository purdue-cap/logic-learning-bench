(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/119) — gt=concat(<low>,contain(or(<any>,<m0>)))")
(set-info :description "lines with words with a lower-case letter before a character or the string '!' in them")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00226 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00805 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00215 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00516 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00226 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00954 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00798 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00021 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00182 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00127 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00456 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00706 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00915 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00912 head tail))))

(check-synth)
