(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/145) — gt=concat(<vow>,contain(or(or(<m0>,<low>),<m1>)))")
(set-info :description "lines having a vowel followed by either the string '!' , a lower-case letter , or the string '@'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00215 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00229 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00223 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00197 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00201 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00200 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00714 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00292 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00296 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00298 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00123 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00003 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00019 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00038 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
