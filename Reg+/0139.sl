(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/145) — gt=concat(<vow>,contain(or(or(<m0>,<low>),<m1>)))")
(set-info :description "lines having a vowel followed by either the string '!' , a lower-case letter , or the string '@'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00215 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00229 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00223 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00197 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00201 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00200 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00714 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00292 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00296 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00298 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00123 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00003 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00019 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))

(check-synth)
