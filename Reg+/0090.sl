(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/92) — gt=repeatatleast(contain(<any>),7)")
(set-info :description "lines with only 7 or more characters")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w01359 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01164 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01261 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01384 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01502 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01526 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01539 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00229 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00524 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00741 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00934 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01074 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00875 head tail))))

(check-synth)
