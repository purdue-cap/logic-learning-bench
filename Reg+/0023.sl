(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/23) — gt=concat(<low>,contain(<num>))")
(set-info :description "lines with a number following a lower case letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00218 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00240 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01075 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00789 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00270 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00510 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00765 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00039 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00020 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00009 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00114 head tail))))

(check-synth)
