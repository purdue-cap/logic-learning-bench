(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/23) — gt=concat(<low>,contain(<num>))")
(set-info :description "lines with a number following a lower case letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00218 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00240 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01075 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00789 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00270 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00510 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00765 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00011 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00010 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00038 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00039 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00020 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00009 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00114 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
