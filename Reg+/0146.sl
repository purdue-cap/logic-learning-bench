(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/153) — gt=concat(or(<m0>,<any>),contain(<vow>))")
(set-info :description "lines with string '!' or character before vowel")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00079 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00396 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00776 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00257 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00159 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00650 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00857 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00086 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00228 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00398 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00128 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00592 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00305 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00582 head tail))))

(check-synth)
