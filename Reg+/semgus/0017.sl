(synth-fun match_regex() Start)

(constraint (Start.Sem match_regex 1 97 0 true))
(constraint (Start.Sem match_regex 1 65 0 true))
(constraint (Start.Sem match_regex 1 66 0 true))
(constraint (Start.Sem match_regex 1 98 0 true))
(constraint (Start.Sem match_regex 1 97 0 true))
(constraint (Start.Sem match_regex 1 97 0 true))
(constraint (Start.Sem match_regex 1 97 0 true))
(constraint (Start.Sem match_regex 1 49 0 false))
(constraint (Start.Sem match_regex 2 49 48 false))
(constraint (Start.Sem match_regex 2 65 66 false))
(constraint (Start.Sem match_regex 2 97 98 false))
(constraint (Start.Sem match_regex 2 65 98 false))
(constraint (Start.Sem match_regex 1 44 0 false))
