(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/138) — gt=concat(repeatatleast(endwith(<m0>),1),contain(<m1>))")
(set-info :description "lines ending with string '!' at least once before string '@'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00073 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00929 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01003 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00611 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01436 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00774 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01325 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00019 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00003 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00749 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01154 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00666 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00836 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01364 head tail))))

(check-synth)
