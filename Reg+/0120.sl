(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/126) — gt=contain(concat(and(<low>,<any>),contain(<m0>)))")
(set-info :description "lines which are containing a lower-case letter and a character before the string '!'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00215 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00951 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00873 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00966 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00586 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00911 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01503 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00902 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01118 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00708 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01061 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00535 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00704 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01043 head tail))))

(check-synth)
