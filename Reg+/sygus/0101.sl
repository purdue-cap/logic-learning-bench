(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/105.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "a 123")
(define-fun w2 () String "a1")
(define-fun w3 () String "Letter 2 #")
(define-fun w4 () String "c 5")
(define-fun w5 () String "d 7 !#")
(define-fun w6 () String "PCP b 33")
(define-fun w7 () String "x32")
(define-fun w8 () String "No numeral")
(define-fun w9 () String "###")
(define-fun w10 () String "123")
(define-fun w11 () String "567 plus a")
(define-fun w12 () String "items")
(define-fun w13 () String "a character")
(define-fun w14 () String "!! 47")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re "#")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "6")
                (str.to_re "7")
                (str.to_re "C")
                (str.to_re "L")
                (str.to_re "N")
                (str.to_re "P")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "l")
                (str.to_re "m")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "p")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                (str.to_re "x")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
