(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/88.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "1aA")
(define-fun w2 () String "1aa")
(define-fun w3 () String "2bB")
(define-fun w4 () String "3bC")
(define-fun w5 () String "1999bC")
(define-fun w6 () String "20oO")
(define-fun w7 () String "13rS")
(define-fun w8 () String "1")
(define-fun w9 () String "1Aa")
(define-fun w10 () String "blah")
(define-fun w11 () String "Aa1")
(define-fun w12 () String ",,,")
(define-fun w13 () String "hello!")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re ",")
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "9")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "C")
                (str.to_re "O")
                (str.to_re "S")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "e")
                (str.to_re "h")
                (str.to_re "l")
                (str.to_re "o")
                (str.to_re "r")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
