(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/66.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "!")
(define-fun w2 () String "!2Afjsdf")
(define-fun w3 () String "!bcd")
(define-fun w4 () String "!345")
(define-fun w5 () String "!!!!!2342")
(define-fun w6 () String "!AAA234")
(define-fun w7 () String "!239CCC34")
(define-fun w8 () String "ajksdfj")
(define-fun w9 () String "23!")
(define-fun w10 () String "Z")
(define-fun w11 () String "xY234!!")
(define-fun w12 () String "abcd")
(define-fun w13 () String "2!")
(define-fun w14 () String " !")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "9")
                (str.to_re "A")
                (str.to_re "C")
                (str.to_re "Y")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "f")
                (str.to_re "j")
                (str.to_re "k")
                (str.to_re "s")
                (str.to_re "x")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
