(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/58.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "Fake")
(define-fun w2 () String "Nope")
(define-fun w3 () String "Not sure")
(define-fun w4 () String "I think this will work")
(define-fun w5 () String "S8")
(define-fun w6 () String "E%")
(define-fun w7 () String "M.")
(define-fun w8 () String "S")
(define-fun w9 () String "about")
(define-fun w10 () String "%S")
(define-fun w11 () String "(L")
(define-fun w12 () String "fore#F")
(define-fun w13 () String "foreF#")

(define-fun w14 () String "")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "#")
                (str.to_re "%")
                (str.to_re "(")
                (str.to_re ".")
                (str.to_re "8")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "I")
                (str.to_re "L")
                (str.to_re "M")
                (str.to_re "N")
                (str.to_re "S")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "p")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                (str.to_re "w")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(constraint (not (str.in_re w14 r)))

(check-synth)
