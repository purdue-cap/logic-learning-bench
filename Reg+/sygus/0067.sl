(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/67.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "!a!a!a!a")
(define-fun w2 () String "!f@32!c!fj23!kfls!wor!")
(define-fun w3 () String "!cc!dkw!map!fo234!0ri2op!pfAA!fla")
(define-fun w4 () String "!c!1!@!A!Z!")
(define-fun w5 () String "!ff!23A!ffC!ga!f!")
(define-fun w6 () String "!CC!ff23!ppr1!f!q!")
(define-fun w7 () String "!A!ccf!pw3!o!dd!g!")
(define-fun w8 () String "!f")
(define-fun w9 () String "!1F!C!fSdf")
(define-fun w10 () String "dfh2123@@")
(define-fun w11 () String "!rj!aowe!CC")
(define-fun w12 () String "!!")
(define-fun w13 () String "!C!!fj!")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "C")
                (str.to_re "F")
                (str.to_re "S")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "j")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "m")
                (str.to_re "o")
                (str.to_re "p")
                (str.to_re "q")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "w")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
