(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/97.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "a4")
(define-fun w2 () String "a992388ew")
(define-fun w3 () String "u5")
(define-fun w4 () String "o1")
(define-fun w5 () String "i5")
(define-fun w6 () String "we9w")
(define-fun w7 () String "a5oo2")
(define-fun w8 () String "s1")
(define-fun w9 () String "5")
(define-fun w10 () String "tik")
(define-fun w11 () String "too")
(define-fun w12 () String "slackvariabl ")
(define-fun w13 () String "slack variable")

(define-fun w14 () String "")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "8")
                (str.to_re "9")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "e")
                (str.to_re "i")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                (str.to_re "v")
                (str.to_re "w")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(constraint (not (str.in_re w14 r)))

(check-synth)
