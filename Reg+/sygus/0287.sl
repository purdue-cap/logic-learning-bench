(set-logic SLIA)

; Converted from upstream Regel benchmark stackoverflow/91.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "(501) 555 1234")
(define-fun w2 () String "(501)-555.1234")
(define-fun w3 () String "501-555-1234")
(define-fun w4 () String "501.555.1234")
(define-fun w5 () String "501 555 1234")
(define-fun w6 () String "501) 343-2233")
(define-fun w7 () String "(501 343-2233")
(define-fun w8 () String "(501. 343-2233")
(define-fun w9 () String "5013432233")
(define-fun w10 () String "800-..555-1234")
(define-fun w11 () String "-(.8005551234")
(define-fun w12 () String "*-(.8005551234")
(define-fun w13 () String "501*555-1234")
(define-fun w14 () String "-(.80055512 41")
(define-fun w15 () String "501_555_1234")
(define-fun w16 () String "555-1234")
(define-fun w17 () String "800-...........555-1234")
(define-fun w18 () String "013432233")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "(")
                (str.to_re ")")
                (str.to_re "*")
                (str.to_re "-")
                (str.to_re ".")
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "8")
                (str.to_re "_")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (str.in_re w8 r))
(constraint (str.in_re w9 r))
(constraint (str.in_re w10 r))
(constraint (str.in_re w11 r))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))
(constraint (not (str.in_re w15 r)))
(constraint (not (str.in_re w16 r)))
(constraint (not (str.in_re w17 r)))
(constraint (not (str.in_re w18 r)))

(check-synth)
