(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/62.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "fa")
(define-fun w2 () String "c1d1")
(define-fun w3 () String "z2fa111!!!")
(define-fun w4 () String "v22vsd2")
(define-fun w5 () String "xfas33")
(define-fun w6 () String "cBSDF231!!")
(define-fun w7 () String "qabFF22111")
(define-fun w8 () String "1ffddd")
(define-fun w9 () String "ABBcc")
(define-fun w10 () String "11@@@afnsdf")
(define-fun w11 () String "222VVV!!!")
(define-fun w12 () String "P123ffff")
(define-fun w13 () String "!!so23")

(define-fun w14 () String "")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "D")
                (str.to_re "F")
                (str.to_re "P")
                (str.to_re "S")
                (str.to_re "V")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "f")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "q")
                (str.to_re "s")
                (str.to_re "v")
                (str.to_re "x")
                (str.to_re "z")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(constraint (not (str.in_re w14 r)))

(check-synth)
