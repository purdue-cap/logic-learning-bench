(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/139.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "!abc1")
(define-fun w2 () String "!2")
(define-fun w3 () String "!f3d")
(define-fun w4 () String "!kD2")
(define-fun w5 () String "!fd%2")
(define-fun w6 () String "!tEr5")
(define-fun w7 () String "!45gE")
(define-fun w8 () String "1")
(define-fun w9 () String "abc1")
(define-fun w10 () String "dF3s")
(define-fun w11 () String "nBv")
(define-fun w12 () String "fdR!")
(define-fun w13 () String "576")
(define-fun w14 () String "sd!2")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "%")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "6")
                (str.to_re "7")
                (str.to_re "B")
                (str.to_re "D")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "R")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "k")
                (str.to_re "n")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "v")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
