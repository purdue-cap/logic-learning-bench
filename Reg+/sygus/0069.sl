(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/69.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "cAA1!")
(define-fun w2 () String "@AAA")
(define-fun w3 () String "2abAaZ")
(define-fun w4 () String "3ac!!")
(define-fun w5 () String "!347AA")
(define-fun w6 () String "555@@aa")
(define-fun w7 () String "Ai2ZZFF23")
(define-fun w8 () String "e2GGasd")
(define-fun w9 () String "IIII")
(define-fun w10 () String "o")
(define-fun w11 () String "Udfa")
(define-fun w12 () String "Eaf")
(define-fun w13 () String "u92!!f")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "7")
                (str.to_re "9")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "G")
                (str.to_re "I")
                (str.to_re "U")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "i")
                (str.to_re "o")
                (str.to_re "s")
                (str.to_re "u")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (not (str.in_re w7 r)))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
