(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/53.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "a!C")
(define-fun w2 () String "#abc!234aU3")
(define-fun w3 () String "{!X")
(define-fun w4 () String "~!Z")
(define-fun w5 () String "*er!weMwe")
(define-fun w6 () String "(!V")
(define-fun w7 () String "K!W")
(define-fun w8 () String "Jon")
(define-fun w9 () String "!!!")
(define-fun w10 () String "a!a")
(define-fun w11 () String "a!>")
(define-fun w12 () String "b!0")
(define-fun w13 () String "a*C")

(define-fun w14 () String "")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "#")
                (str.to_re "(")
                (str.to_re "*")
                (str.to_re "0")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re ">")
                (str.to_re "C")
                (str.to_re "J")
                (str.to_re "K")
                (str.to_re "M")
                (str.to_re "U")
                (str.to_re "V")
                (str.to_re "W")
                (str.to_re "X")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "e")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "w")
                (str.to_re "{")
                (str.to_re "~")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(constraint (not (str.in_re w14 r)))

(check-synth)
