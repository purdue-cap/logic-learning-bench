(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/45.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "BBBBBBBa")
(define-fun w2 () String "BBBBBBBBe")
(define-fun w3 () String "cklmnopqrtu")
(define-fun w4 () String "zzzzzzzzzzzei")
(define-fun w5 () String "zzzzzzzzzzzoz")
(define-fun w6 () String "mmmmmmmmmmmmmi;")
(define-fun w7 () String "zzzzzzzzzzzzzzo!!")
(define-fun w8 () String "za")
(define-fun w9 () String "zza")
(define-fun w10 () String "zzza")
(define-fun w11 () String "zzzzu")
(define-fun w12 () String "zzzzzi")
(define-fun w13 () String "kkkkkko")
(define-fun w14 () String "mmmmmmm")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re ";")
                (str.to_re "B")
                (str.to_re "a")
                (str.to_re "c")
                (str.to_re "e")
                (str.to_re "i")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "m")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "p")
                (str.to_re "q")
                (str.to_re "r")
                (str.to_re "t")
                (str.to_re "u")
                (str.to_re "z")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
