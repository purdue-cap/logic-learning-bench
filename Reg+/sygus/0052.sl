(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/52.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "!!!!!!!!!")
(define-fun w2 () String "!!!!!!here")
(define-fun w3 () String "!!!!!!!!!!!!!!what about now")
(define-fun w4 () String "!!!!!!!!!$#@#%")
(define-fun w5 () String "!!!!!!!!!aFe35#")
(define-fun w6 () String "!!!!!!fS3DC#%")
(define-fun w7 () String "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!")
(define-fun w8 () String "!")
(define-fun w9 () String "!!!!!")
(define-fun w10 () String "!Why!doesnt!this!work!because!I!think!it!should")
(define-fun w11 () String "nothing here")
(define-fun w12 () String "!@$#@@#!!$#@#@$!#%@!#@Eer3234!")
(define-fun w13 () String "Done !")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re "#")
                (str.to_re "$")
                (str.to_re "%")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "@")
                (str.to_re "C")
                (str.to_re "D")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "I")
                (str.to_re "S")
                (str.to_re "W")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                (str.to_re "w")
                (str.to_re "y")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
