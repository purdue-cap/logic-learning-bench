(set-logic SLIA)

; Converted from upstream Regel benchmark stackoverflow/61.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "Hercules.Cycle")
(define-fun w2 () String "Herbal&Product")
(define-fun w3 () String "Welcome@123")
(define-fun w4 () String "&Hercules")
(define-fun w5 () String "Colgate!()")
(define-fun w6 () String ".Youtube")
(define-fun w7 () String "@Incule")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "&")
                (str.to_re "(")
                (str.to_re ")")
                (str.to_re ".")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "@")
                (str.to_re "C")
                (str.to_re "H")
                (str.to_re "I")
                (str.to_re "P")
                (str.to_re "W")
                (str.to_re "Y")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "g")
                (str.to_re "l")
                (str.to_re "m")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                (str.to_re "y")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (not (str.in_re w4 r)))
(constraint (not (str.in_re w5 r)))
(constraint (not (str.in_re w6 r)))
(constraint (not (str.in_re w7 r)))

(check-synth)
