(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/81.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "2aa")
(define-fun w2 () String "2ab")
(define-fun w3 () String "1aaaaa")
(define-fun w4 () String "1cat")
(define-fun w5 () String "1fish")
(define-fun w6 () String "2fish")
(define-fun w7 () String "7hearts")
(define-fun w8 () String "redfish")
(define-fun w9 () String "blue fish")
(define-fun w10 () String ",,,")
(define-fun w11 () String "a1cat")
(define-fun w12 () String "yay!")
(define-fun w13 () String "numeral counts a number with more than one character")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re ",")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "7")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "l")
                (str.to_re "m")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                (str.to_re "w")
                (str.to_re "y")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
