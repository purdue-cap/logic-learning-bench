(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/142.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "abcdefg")
(define-fun w2 () String "ABCDEFG")
(define-fun w3 () String "reGREte")
(define-fun w4 () String "ghjklfgh")
(define-fun w5 () String "HGFDkjhgG")
(define-fun w6 () String "tGFDdgff")
(define-fun w7 () String "HGFdfhgfd")
(define-fun w8 () String "abcdef")
(define-fun w9 () String "ABCDEF")
(define-fun w10 () String "avDFG")
(define-fun w11 () String "123457")
(define-fun w12 () String "1234567")
(define-fun w13 () String "ab1hgfD")
(define-fun w14 () String "hgfd 3s")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "6")
                (str.to_re "7")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "C")
                (str.to_re "D")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "G")
                (str.to_re "H")
                (str.to_re "R")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "j")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "v")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
