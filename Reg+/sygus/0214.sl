(set-logic SLIA)

; Converted from upstream Regel benchmark stackoverflow/14.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "000000")
(define-fun w2 () String "0.0")
(define-fun w3 () String "0000.")
(define-fun w4 () String "0")
(define-fun w5 () String ".50000000")
(define-fun w6 () String "00001.")
(define-fun w7 () String "01.50")
(define-fun w8 () String "2.00000")
(define-fun w9 () String "2.5000")
(define-fun w10 () String "03")
(define-fun w11 () String "03.5")
(define-fun w12 () String "0004")
(define-fun w13 () String "0004.5000")
(define-fun w14 () String "00005.0")
(define-fun w15 () String "0.5")
(define-fun w16 () String "1")
(define-fun w17 () String "1.5")
(define-fun w18 () String "2")
(define-fun w19 () String "2.5")
(define-fun w20 () String "3")
(define-fun w21 () String "3.5")
(define-fun w22 () String "4")
(define-fun w23 () String "4.5")
(define-fun w24 () String "5")
(define-fun w25 () String "-1")
(define-fun w26 () String "-.5")
(define-fun w27 () String "-0")
(define-fun w28 () String "1.05")
(define-fun w29 () String "5.5")
(define-fun w30 () String "10")
(define-fun w31 () String "20")
(define-fun w32 () String "30")
(define-fun w33 () String "40")
(define-fun w34 () String "50")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "-")
                (str.to_re ".")
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (str.in_re w8 r))
(constraint (str.in_re w9 r))
(constraint (str.in_re w10 r))
(constraint (str.in_re w11 r))
(constraint (str.in_re w12 r))
(constraint (str.in_re w13 r))
(constraint (str.in_re w14 r))
(constraint (str.in_re w15 r))
(constraint (str.in_re w16 r))
(constraint (str.in_re w17 r))
(constraint (str.in_re w18 r))
(constraint (str.in_re w19 r))
(constraint (str.in_re w20 r))
(constraint (str.in_re w21 r))
(constraint (str.in_re w22 r))
(constraint (str.in_re w23 r))
(constraint (str.in_re w24 r))
(constraint (not (str.in_re w25 r)))
(constraint (not (str.in_re w26 r)))
(constraint (not (str.in_re w27 r)))
(constraint (not (str.in_re w28 r)))
(constraint (not (str.in_re w29 r)))
(constraint (not (str.in_re w30 r)))
(constraint (not (str.in_re w31 r)))
(constraint (not (str.in_re w32 r)))
(constraint (not (str.in_re w33 r)))
(constraint (not (str.in_re w34 r)))

(check-synth)
