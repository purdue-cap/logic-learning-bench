(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/92.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "asdfgjkls")
(define-fun w2 () String "1234567")
(define-fun w3 () String "12345556")
(define-fun w4 () String "1232435345")
(define-fun w5 () String "afdfadsfasdfasd")
(define-fun w6 () String "adfasdfasfadsfasdf")
(define-fun w7 () String "afdsafsafadsfadsfasdfadse")
(define-fun w8 () String "a")
(define-fun w9 () String "aa")
(define-fun w10 () String "aaa")
(define-fun w11 () String "aaaa")
(define-fun w12 () String "aaaaa")
(define-fun w13 () String "aaaaaa")
(define-fun w14 () String "34234")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "6")
                (str.to_re "7")
                (str.to_re "a")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "j")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "s")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
