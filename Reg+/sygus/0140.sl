(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/146.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "A!")
(define-fun w2 () String "E!")
(define-fun w3 () String "Iq!")
(define-fun w4 () String "O3!")
(define-fun w5 () String "Ad!d")
(define-fun w6 () String "A1!e3")
(define-fun w7 () String "U2!d")
(define-fun w8 () String "\u{1B}AA")
(define-fun w9 () String "!")
(define-fun w10 () String "C")
(define-fun w11 () String "Ca!")
(define-fun w12 () String "CC")
(define-fun w13 () String "F2!")
(define-fun w14 () String "a!")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "\u{1B}")
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "A")
                (str.to_re "C")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "I")
                (str.to_re "O")
                (str.to_re "U")
                (str.to_re "a")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "q")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
