(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/138.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "!@")
(define-fun w2 () String "a!d!@")
(define-fun w3 () String "111!2@")
(define-fun w4 () String "!!!@")
(define-fun w5 () String "gfd!gf34!@@")
(define-fun w6 () String "df!@")
(define-fun w7 () String "ws12!4d@")
(define-fun w8 () String "@")
(define-fun w9 () String "!")
(define-fun w10 () String "abc@")
(define-fun w11 () String "!bvcx34")
(define-fun w12 () String "123@")
(define-fun w13 () String "!093v")
(define-fun w14 () String "d!tr!tre!")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "9")
                (str.to_re "@")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "v")
                (str.to_re "w")
                (str.to_re "x")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
