(set-logic SLIA)

; Converted from upstream Regel benchmark stackoverflow/86.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "safename")
(define-fun w2 () String "123")
(define-fun w3 () String "there-is-something-here")
(define-fun w4 () String "your-name-goes-here")
(define-fun w5 () String "a-b")
(define-fun w6 () String "a-bc-d")
(define-fun w7 () String "ab-cd-e")
(define-fun w8 () String "a-bc-de")
(define-fun w9 () String "this-is-a-test")
(define-fun w10 () String "a-b-c")
(define-fun w11 () String "1-2-3")
(define-fun w12 () String "1-2-")
(define-fun w13 () String "-something-is-up")
(define-fun w14 () String "say-what-")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "-")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "m")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "p")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                (str.to_re "w")
                (str.to_re "y")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (str.in_re w8 r))
(constraint (str.in_re w9 r))
(constraint (str.in_re w10 r))
(constraint (str.in_re w11 r))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
