(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/77.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "yay!")
(define-fun w2 () String "yay@")
(define-fun w3 () String "yay I'm happy!")
(define-fun w4 () String "yay I'm happy@")
(define-fun w5 () String "!@!")
(define-fun w6 () String "@!@")
(define-fun w7 () String "!")
(define-fun w8 () String "yay! I'm happy")
(define-fun w9 () String "!aaa")
(define-fun w10 () String "@aaa")
(define-fun w11 () String "something with no symbols")
(define-fun w12 () String "!!!@@@ending")
(define-fun w13 () String "!@!a")

(define-fun w14 () String "")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re "'")
                (str.to_re "@")
                (str.to_re "I")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "l")
                (str.to_re "m")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "p")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "w")
                (str.to_re "y")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(constraint (not (str.in_re w14 r)))

(check-synth)
