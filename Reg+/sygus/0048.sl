(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/48.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "aq")
(define-fun w2 () String "e!")
(define-fun w3 () String "iZ")
(define-fun w4 () String "o[")
(define-fun w5 () String "u5")
(define-fun w6 () String "o;")
(define-fun w7 () String "u^")
(define-fun w8 () String "z")
(define-fun w9 () String "q3")
(define-fun w10 () String "p0")
(define-fun w11 () String "m;;")
(define-fun w12 () String "z'''")
(define-fun w13 () String "q!")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "'")
                (str.to_re "0")
                (str.to_re "3")
                (str.to_re "5")
                (str.to_re ";")
                (str.to_re "Z")
                (str.to_re "[")
                (str.to_re "^")
                (str.to_re "a")
                (str.to_re "e")
                (str.to_re "i")
                (str.to_re "m")
                (str.to_re "o")
                (str.to_re "p")
                (str.to_re "q")
                (str.to_re "u")
                (str.to_re "z")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
