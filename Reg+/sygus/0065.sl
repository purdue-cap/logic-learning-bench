(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/65.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "A!f2a")
(define-fun w2 () String "!")
(define-fun w3 () String "a")
(define-fun w4 () String "C23!")
(define-fun w5 () String "zAzz3U")
(define-fun w6 () String "z!!32e")
(define-fun w7 () String "1553I")
(define-fun w8 () String "!fj")
(define-fun w9 () String "!fJ2219")
(define-fun w10 () String "1ZfaV")
(define-fun w11 () String "39FF1C")
(define-fun w12 () String "i293AAc")
(define-fun w13 () String "U113AAJ")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "5")
                (str.to_re "9")
                (str.to_re "A")
                (str.to_re "C")
                (str.to_re "F")
                (str.to_re "I")
                (str.to_re "J")
                (str.to_re "U")
                (str.to_re "V")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "c")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "i")
                (str.to_re "j")
                (str.to_re "z")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
