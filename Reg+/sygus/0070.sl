(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/70.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "!a")
(define-fun w2 () String "!e")
(define-fun w3 () String "!i")
(define-fun w4 () String "!o")
(define-fun w5 () String "!u")
(define-fun w6 () String "!a234absdfsdf")
(define-fun w7 () String "!yuZXFHSDjf19231923")
(define-fun w8 () String "!123")
(define-fun w9 () String "!ttrrpw")
(define-fun w10 () String "!zzccddbb")
(define-fun w11 () String "a")
(define-fun w12 () String "123")
(define-fun w13 () String "f3fsdfwr")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "9")
                (str.to_re "D")
                (str.to_re "F")
                (str.to_re "H")
                (str.to_re "S")
                (str.to_re "X")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "i")
                (str.to_re "j")
                (str.to_re "o")
                (str.to_re "p")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                (str.to_re "w")
                (str.to_re "y")
                (str.to_re "z")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
