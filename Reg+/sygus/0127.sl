(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/133.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "Ad")
(define-fun w2 () String "Vdfgd")
(define-fun w3 () String "Swerfds")
(define-fun w4 () String "asEf")
(define-fun w5 () String "1234Fsdf")
(define-fun w6 () String "sdf3dSdf")
(define-fun w7 () String "AsAsA1")
(define-fun w8 () String "a")
(define-fun w9 () String "A")
(define-fun w10 () String "w")
(define-fun w11 () String "werS")
(define-fun w12 () String "sd234ds")
(define-fun w13 () String "S1234")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "A")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "S")
                (str.to_re "V")
                (str.to_re "a")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "w")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
