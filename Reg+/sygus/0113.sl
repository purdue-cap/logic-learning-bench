(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/118.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "3!h")
(define-fun w2 () String "86!gj")
(define-fun w3 () String "79!dgA")
(define-fun w4 () String "87!24")
(define-fun w5 () String "97!34Dgc")
(define-fun w6 () String "9!2a")
(define-fun w7 () String "87!sg")
(define-fun w8 () String "asd!sd")
(define-fun w9 () String "B!sd")
(define-fun w10 () String "S12")
(define-fun w11 () String "Bunrs")
(define-fun w12 () String "123")
(define-fun w13 () String "!sda")
(define-fun w14 () String "!12SD")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "6")
                (str.to_re "7")
                (str.to_re "8")
                (str.to_re "9")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "D")
                (str.to_re "S")
                (str.to_re "a")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "j")
                (str.to_re "n")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "u")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
