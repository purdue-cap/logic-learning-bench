(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/136.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "a!l")
(define-fun w2 () String "A!d")
(define-fun w3 () String "e123!ghjk")
(define-fun w4 () String "E!567Lk")
(define-fun w5 () String "i!0j")
(define-fun w6 () String "I!!5g")
(define-fun w7 () String "O!LKJo")
(define-fun w8 () String "s!h")
(define-fun w9 () String "S!cd")
(define-fun w10 () String "a!L")
(define-fun w11 () String "al")
(define-fun w12 () String "a45ghy")
(define-fun w13 () String "E@567jk")
(define-fun w14 () String "Q234!f3r")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "6")
                (str.to_re "7")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "E")
                (str.to_re "I")
                (str.to_re "J")
                (str.to_re "K")
                (str.to_re "L")
                (str.to_re "O")
                (str.to_re "Q")
                (str.to_re "S")
                (str.to_re "a")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "j")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "y")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
