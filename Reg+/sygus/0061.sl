(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/61.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "aC")
(define-fun w2 () String "zasDds")
(define-fun w3 () String "y123DAAAds")
(define-fun w4 () String "c2Gs23")
(define-fun w5 () String "pa12G23")
(define-fun w6 () String "rV")
(define-fun w7 () String "tZasZ")
(define-fun w8 () String "abc")
(define-fun w9 () String "!!23abc")
(define-fun w10 () String "a#2! fff")
(define-fun w11 () String "g123f22")
(define-fun w12 () String "A")
(define-fun w13 () String "Z")

(define-fun w14 () String "")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re "#")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "A")
                (str.to_re "C")
                (str.to_re "D")
                (str.to_re "G")
                (str.to_re "V")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "p")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "y")
                (str.to_re "z")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(constraint (not (str.in_re w14 r)))

(check-synth)
