(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/47.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "aaA")
(define-fun w2 () String "a!B")
(define-fun w3 () String "b;G")
(define-fun w4 () String "k2$M")
(define-fun w5 () String "u,3N")
(define-fun w6 () String "p4A5N")
(define-fun w7 () String "asS")
(define-fun w8 () String "Asq")
(define-fun w9 () String "b;8")
(define-fun w10 () String "c`a")
(define-fun w11 () String "z!'")
(define-fun w12 () String "zZz")
(define-fun w13 () String "Zz<")
(define-fun w14 () String "`kk")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "$")
                (str.to_re "'")
                (str.to_re ",")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "8")
                (str.to_re ";")
                (str.to_re "<")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "G")
                (str.to_re "M")
                (str.to_re "N")
                (str.to_re "S")
                (str.to_re "Z")
                (str.to_re "`")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "k")
                (str.to_re "p")
                (str.to_re "q")
                (str.to_re "s")
                (str.to_re "u")
                (str.to_re "z")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
