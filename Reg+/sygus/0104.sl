(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/108.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "a")
(define-fun w2 () String "a c")
(define-fun w3 () String "c a")
(define-fun w4 () String "VOWEL")
(define-fun w5 () String "AEIOU 123")
(define-fun w6 () String "# start")
(define-fun w7 () String "! i")
(define-fun w8 () String "r")
(define-fun w9 () String "123")
(define-fun w10 () String "##")
(define-fun w11 () String "N")
(define-fun w12 () String "ch @ 456")
(define-fun w13 () String "!!")

(define-fun w14 () String "")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re "#")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "6")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "E")
                (str.to_re "I")
                (str.to_re "L")
                (str.to_re "N")
                (str.to_re "O")
                (str.to_re "U")
                (str.to_re "V")
                (str.to_re "W")
                (str.to_re "a")
                (str.to_re "c")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(constraint (not (str.in_re w14 r)))

(check-synth)
