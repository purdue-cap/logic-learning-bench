(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/60.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "A")
(define-fun w2 () String "ZaC")
(define-fun w3 () String "X!!")
(define-fun w4 () String "X@@123C")
(define-fun w5 () String "AA")
(define-fun w6 () String "CCDD")
(define-fun w7 () String "C1G3X5")
(define-fun w8 () String "1CD")
(define-fun w9 () String "aA@C")
(define-fun w10 () String "!sacA")
(define-fun w11 () String "f!ACCGG")
(define-fun w12 () String "9914AAACC")
(define-fun w13 () String "29f21")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "9")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "C")
                (str.to_re "D")
                (str.to_re "G")
                (str.to_re "X")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "c")
                (str.to_re "f")
                (str.to_re "s")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
