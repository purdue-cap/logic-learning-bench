(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/114.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "1!1")
(define-fun w2 () String "23!a")
(define-fun w3 () String "45!abc")
(define-fun w4 () String "45! K")
(define-fun w5 () String "09! 23")
(define-fun w6 () String "8 !h")
(define-fun w7 () String "9 !12")
(define-fun w8 () String "noNumber!")
(define-fun w9 () String "onlyNumber123!")
(define-fun w10 () String "!has character")
(define-fun w11 () String "! abc!abc")
(define-fun w12 () String "##!")
(define-fun w13 () String "abc ! ##")
(define-fun w14 () String "no e")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re "#")
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "8")
                (str.to_re "9")
                (str.to_re "K")
                (str.to_re "N")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "e")
                (str.to_re "h")
                (str.to_re "l")
                (str.to_re "m")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                (str.to_re "y")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
