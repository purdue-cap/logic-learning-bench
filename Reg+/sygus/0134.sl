(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/140.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "1a2b3c4d5e")
(define-fun w2 () String "5b3d2h7f2f5h")
(define-fun w3 () String "8g4h2k7l7c4h2d")
(define-fun w4 () String "1a4f9h9h6j0k0l3")
(define-fun w5 () String "67d2g4h2k22l")
(define-fun w6 () String "3h543j2l63j3k7b")
(define-fun w7 () String "23f4dg26hj8g0g6k")
(define-fun w8 () String "1a2b3c4d")
(define-fun w9 () String "9L3G7h9l0g")
(define-fun w10 () String "1a2b3C4d5e")
(define-fun w11 () String "123478")
(define-fun w12 () String "asdfgh")
(define-fun w13 () String "d4g4l0h7s2")
(define-fun w14 () String "g86hjk678kjh6")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "6")
                (str.to_re "7")
                (str.to_re "8")
                (str.to_re "9")
                (str.to_re "C")
                (str.to_re "G")
                (str.to_re "L")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "j")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "s")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
