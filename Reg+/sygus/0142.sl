(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/148.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "abc1A")
(define-fun w2 () String "fr2e")
(define-fun w3 () String "143I")
(define-fun w4 () String "8h7Ud")
(define-fun w5 () String "g5Dre89V")
(define-fun w6 () String "!ds3Ef")
(define-fun w7 () String "a5e")
(define-fun w8 () String "2d")
(define-fun w9 () String "a5c")
(define-fun w10 () String "ae")
(define-fun w11 () String "hj7P")
(define-fun w12 () String "a")
(define-fun w13 () String "4")

(define-fun w14 () String "")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "7")
                (str.to_re "8")
                (str.to_re "9")
                (str.to_re "A")
                (str.to_re "D")
                (str.to_re "E")
                (str.to_re "I")
                (str.to_re "P")
                (str.to_re "U")
                (str.to_re "V")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "j")
                (str.to_re "r")
                (str.to_re "s")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(constraint (not (str.in_re w14 r)))

(check-synth)
