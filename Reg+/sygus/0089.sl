(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/91.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "DFGHJKJHGFD")
(define-fun w2 () String "OIUYTRE")
(define-fun w3 () String "LKJHGFDS")
(define-fun w4 () String "ZXCVBNM")
(define-fun w5 () String "SDFGHJK")
(define-fun w6 () String "POIUYTRE")
(define-fun w7 () String "WEDFGH")
(define-fun w8 () String "sdfghjk")
(define-fun w9 () String "oiuytre")
(define-fun w10 () String "cvbnm")
(define-fun w11 () String "ytrdcvbnjk")
(define-fun w12 () String "gkhgfghjkl.u,ymt")
(define-fun w13 () String "uhgyftcvbnm")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re ",")
                (str.to_re ".")
                (str.to_re "B")
                (str.to_re "C")
                (str.to_re "D")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "G")
                (str.to_re "H")
                (str.to_re "I")
                (str.to_re "J")
                (str.to_re "K")
                (str.to_re "L")
                (str.to_re "M")
                (str.to_re "N")
                (str.to_re "O")
                (str.to_re "P")
                (str.to_re "R")
                (str.to_re "S")
                (str.to_re "T")
                (str.to_re "U")
                (str.to_re "V")
                (str.to_re "W")
                (str.to_re "X")
                (str.to_re "Y")
                (str.to_re "Z")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "j")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "m")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                (str.to_re "v")
                (str.to_re "y")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
