(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/80.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "Aa")
(define-fun w2 () String "Bb")
(define-fun w3 () String "AAAaaa")
(define-fun w4 () String "BBBbbb")
(define-fun w5 () String "Aa and other")
(define-fun w6 () String "Start with caps")
(define-fun w7 () String "Hello,")
(define-fun w8 () String "other Aa and")
(define-fun w9 () String "bB")
(define-fun w10 () String ",,,")
(define-fun w11 () String "something!")
(define-fun w12 () String "aA")
(define-fun w13 () String "n0")

(define-fun w14 () String "")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re ",")
                (str.to_re "0")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "H")
                (str.to_re "S")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "l")
                (str.to_re "m")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "p")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "w")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(constraint (not (str.in_re w14 r)))

(check-synth)
