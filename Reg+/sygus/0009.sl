(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/9.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "1a")
(define-fun w2 () String "aa")
(define-fun w3 () String "1,")
(define-fun w4 () String "b,")
(define-fun w5 () String "4'")
(define-fun w6 () String "g;")
(define-fun w7 () String "gG")
(define-fun w8 () String "1")
(define-fun w9 () String "a")
(define-fun w10 () String ",")
(define-fun w11 () String "'")
(define-fun w12 () String "Aa")
(define-fun w13 () String "B2")
(define-fun w14 () String "CC")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "'")
                (str.to_re ",")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "4")
                (str.to_re ";")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "C")
                (str.to_re "G")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "g")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
