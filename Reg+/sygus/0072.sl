(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/73.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "ssjwiwo")
(define-fun w2 () String "yy asudfo oaf")
(define-fun w3 () String "ZHFj!!sh")
(define-fun w4 () String "hdI@@(#KF")
(define-fun w5 () String "!!!AAABBcd")
(define-fun w6 () String "!!!sd9fs89d8f98sdf")
(define-fun w7 () String "FFF!!!!CCC")
(define-fun w8 () String "a!sa")
(define-fun w9 () String "Z!@d13")
(define-fun w10 () String "13aCs")
(define-fun w11 () String "Aa")
(define-fun w12 () String "C3F")
(define-fun w13 () String "!!w2B")

(define-fun w14 () String "")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re "#")
                (str.to_re "(")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "8")
                (str.to_re "9")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "C")
                (str.to_re "F")
                (str.to_re "H")
                (str.to_re "I")
                (str.to_re "K")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "f")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "j")
                (str.to_re "o")
                (str.to_re "s")
                (str.to_re "u")
                (str.to_re "w")
                (str.to_re "y")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(constraint (not (str.in_re w14 r)))

(check-synth)
