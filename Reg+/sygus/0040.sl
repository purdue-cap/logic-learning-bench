(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/40.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "a1")
(define-fun w2 () String "ba2")
(define-fun w3 () String "!e31")
(define-fun w4 () String "zZi2")
(define-fun w5 () String "o3123")
(define-fun w6 () String "U2")
(define-fun w7 () String "u01234")
(define-fun w8 () String "B1")
(define-fun w9 () String "a")
(define-fun w10 () String "e")
(define-fun w11 () String "u!")
(define-fun w12 () String "z34")
(define-fun w13 () String "m;")
(define-fun w14 () String "!b12")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re ";")
                (str.to_re "B")
                (str.to_re "U")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "e")
                (str.to_re "i")
                (str.to_re "m")
                (str.to_re "o")
                (str.to_re "u")
                (str.to_re "z")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
