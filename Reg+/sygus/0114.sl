(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/119.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "aC")
(define-fun w2 () String "tZWa")
(define-fun w3 () String "a!")
(define-fun w4 () String "aC!")
(define-fun w5 () String "ed!sd")
(define-fun w6 () String "oJs!")
(define-fun w7 () String "B")
(define-fun w8 () String "BA")
(define-fun w9 () String "21")
(define-fun w10 () String "B61")
(define-fun w11 () String "B64S")
(define-fun w12 () String "BMB!s")
(define-fun w13 () String "B!B12")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "4")
                (str.to_re "6")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "C")
                (str.to_re "J")
                (str.to_re "M")
                (str.to_re "S")
                (str.to_re "W")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "o")
                (str.to_re "s")
                (str.to_re "t")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w1 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (not (str.in_re w7 r)))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
