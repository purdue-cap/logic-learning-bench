(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/100.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "!5l")
(define-fun w2 () String "!@")
(define-fun w3 () String "!ltter")
(define-fun w4 () String "!a")
(define-fun w5 () String "!@@")
(define-fun w6 () String "!ak@")
(define-fun w7 () String "!fikg")
(define-fun w8 () String "asdflk")
(define-fun w9 () String "a!")
(define-fun w10 () String "5!")
(define-fun w11 () String "@!")
(define-fun w12 () String "letter")
(define-fun w13 () String "&")
(define-fun w14 () String "a!5l")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "&")
                (str.to_re "5")
                (str.to_re "@")
                (str.to_re "a")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "i")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
