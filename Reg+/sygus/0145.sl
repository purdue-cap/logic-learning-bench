(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/152.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "!aA")
(define-fun w2 () String "!bF")
(define-fun w3 () String "!cF")
(define-fun w4 () String "!tF")
(define-fun w5 () String "!rH")
(define-fun w6 () String "!gJ")
(define-fun w7 () String "!vF")
(define-fun w8 () String "!Aa")
(define-fun w9 () String "!BFf")
(define-fun w10 () String "!235")
(define-fun w11 () String "!h")
(define-fun w12 () String "!JK")
(define-fun w13 () String "123")
(define-fun w14 () String "aFe")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "5")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "F")
                (str.to_re "H")
                (str.to_re "J")
                (str.to_re "K")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "r")
                (str.to_re "t")
                (str.to_re "v")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
