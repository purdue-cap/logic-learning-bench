(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/54.
; Grammar mirrors loom RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "Oo")
(define-fun w2 () String "words")
(define-fun w3 () String "many words")
(define-fun w4 () String "what has happened")
(define-fun w5 () String "No big numbers")
(define-fun w6 () String "I gues not")
(define-fun w7 () String "fake")
(define-fun w8 () String "TESTING")
(define-fun w9 () String "ALL CAPS")
(define-fun w10 () String "#$@#$")
(define-fun w11 () String "!!!!!!")
(define-fun w12 () String ")(ASDFA*)")
(define-fun w13 () String "80943584")
(define-fun w14 () String "324@#$@WERWE")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re "#")
                (str.to_re "$")
                (str.to_re "(")
                (str.to_re ")")
                (str.to_re "*")
                (str.to_re "0")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "8")
                (str.to_re "9")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "C")
                (str.to_re "D")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "G")
                (str.to_re "I")
                (str.to_re "L")
                (str.to_re "N")
                (str.to_re "O")
                (str.to_re "P")
                (str.to_re "R")
                (str.to_re "S")
                (str.to_re "T")
                (str.to_re "W")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "k")
                (str.to_re "m")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "p")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                (str.to_re "w")
                (str.to_re "y")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
