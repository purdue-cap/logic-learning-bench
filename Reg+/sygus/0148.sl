(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/155.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "a")
(define-fun w2 () String "76543f")
(define-fun w3 () String "@s")
(define-fun w4 () String "RgfdE")
(define-fun w5 () String "dgT5YGq")
(define-fun w6 () String "45g678")
(define-fun w7 () String "!d!")
(define-fun w8 () String "!")
(define-fun w9 () String "12")
(define-fun w10 () String "1")
(define-fun w11 () String "4")
(define-fun w12 () String "GFD2J")
(define-fun w13 () String "!!")

(define-fun w14 () String "")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "6")
                (str.to_re "7")
                (str.to_re "8")
                (str.to_re "@")
                (str.to_re "D")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "G")
                (str.to_re "J")
                (str.to_re "R")
                (str.to_re "T")
                (str.to_re "Y")
                (str.to_re "a")
                (str.to_re "d")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "q")
                (str.to_re "s")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(constraint (not (str.in_re w14 r)))

(check-synth)
