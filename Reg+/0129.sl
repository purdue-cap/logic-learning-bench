(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/135) — gt=concat(<m0>,contain(and(<num>,<any>)))")
(set-info :description "lines with the string '!' before a number and character")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00622 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00332 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00841 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00992 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00842 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01151 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00071 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00050 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00530 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00410 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00690 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00379 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00657 head tail))))

(check-synth)
