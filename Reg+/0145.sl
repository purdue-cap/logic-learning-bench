(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/152) — gt=concat(<m0>,contain(concat(<low>,contain(<cap>))))")
(set-info :description "lines with the string '!' before a lower case letter then by a capital letter .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00351 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00358 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00360 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00370 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00368 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00365 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00371 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00342 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00634 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00623 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00083 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00344 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00394 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00517 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
