(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/152) — gt=concat(<m0>,contain(concat(<low>,contain(<cap>))))")
(set-info :description "lines with the string '!' before a lower case letter then by a capital letter .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00351 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00358 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00360 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00370 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00368 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00365 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00371 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00342 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00634 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00623 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00083 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00344 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00394 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00517 head tail))))

(check-synth)
