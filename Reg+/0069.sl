(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/69) — gt=not(startwith(or(<cap>,<vow>)))")
(set-info :description "lines that don't begin with a capital letter or vowel")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")
(require "./global/models.deepregex.empty.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp wempty_deepregex head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00952 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00696 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01021 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00876 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00990 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01170 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w01348 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01219 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00713 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00048 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00721 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00464 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01130 head tail))))

(check-synth)
