(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/107) — gt=not(startwith(<m0>))")
(set-info :description "lines not starting in string '!'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w01120 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00786 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00999 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00394 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01457 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01221 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00019 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00003 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00854 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01383 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00065 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00066 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01332 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00361 head tail))))

(check-synth)
