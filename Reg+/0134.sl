(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/140) — gt=repeatatleast(concat(<num>,contain(<low>)),5)")
(set-info :description "lines with number followed by lower-case letter , 5 or more times")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w01387 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01449 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01478 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01495 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01450 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01498 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w01512 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w01265 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01389 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01386 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01007 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01085 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01402 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01469 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
