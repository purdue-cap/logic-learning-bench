(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/140) — gt=repeatatleast(concat(<num>,contain(<low>)),5)")
(set-info :description "lines with number followed by lower-case letter , 5 or more times")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w01387 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01449 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01478 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01495 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01450 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01498 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01512 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w01265 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01389 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01386 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01007 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01085 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01402 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01469 head tail))))

(check-synth)
