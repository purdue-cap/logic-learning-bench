(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/134) — gt=star(concat(<num>,contain(<cap>)))")
(set-info :description "lines with a number followed by a capital letter , zero or more times in it")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")
(require "./global/models.deepregex.empty.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp wempty_deepregex head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00117 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00685 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01016 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01496 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01448 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00882 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00020 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00043 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00689 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01344 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00900 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01185 head tail))))

(check-synth)
