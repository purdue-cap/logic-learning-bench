(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/28) — gt=concat(or(or(<m0>,<low>),<any>),contain(<cap>))")
(set-info :description "lines with the string '!' , lower-case letter , or character before a capital letter")

