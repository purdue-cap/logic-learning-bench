(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/28) — gt=concat(or(or(<m0>,<low>),<any>),contain(<cap>))")
(set-info :description "lines with the string '!' , lower-case letter , or character before a capital letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00074 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00118 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00224 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00523 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00673 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01071 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00734 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00108 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00003 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00021 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00019 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00168 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00223 head tail))))

(check-synth)
