(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/44) — gt=concat(<any>,contain(repeatatleast(<m0>,5)))")
(set-info :description "lines with a character occuring before the string '!' , 5 or more times")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w01065 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01303 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01378 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01353 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01499 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01501 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00984 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00825 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00750 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00652 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00928 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00757 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00427 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00215 head tail))))

(check-synth)
