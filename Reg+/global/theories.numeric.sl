; Numeric regex vocabulary: literal digits and the upstream <num1-9> class.
(declare-sort Pos 0)
(declare-fun is.any (Pos) Bool)
(declare-fun is.range.x31.x39 (Pos) Bool)
(declare-fun is.x30 (Pos) Bool)
(declare-fun is.x31 (Pos) Bool)
(declare-fun is.x32 (Pos) Bool)
(declare-fun is.x33 (Pos) Bool)
(declare-fun is.x34 (Pos) Bool)
(declare-fun is.x35 (Pos) Bool)
(declare-fun is.x36 (Pos) Bool)
(declare-fun is.x37 (Pos) Bool)
(declare-fun is.x38 (Pos) Bool)
(declare-fun is.x39 (Pos) Bool)
(declare-fun succ (Pos Pos) Bool)
(declare-fun leq (Pos Pos) Bool)
(declare-fun head () Pos)
(declare-fun tail () Pos)

(declare-term-types
 ((RegLan 0))
 (((char.any) (char.range.x31.x39) (char.x30) (char.x31) (char.x32) (char.x33) (char.x34) (char.x35) (char.x36) (char.x37) (char.x38) (char.x39)
   (re.opt RegLan)
   (re.plus RegLan)
   (re.++ RegLan RegLan)
   (re.union RegLan RegLan)
   (re.inter RegLan RegLan)
   (re.* RegLan))))

(declare-axiom (= (re.union x y) (re.union y x)))
(declare-axiom (= (re.union (re.union x y) z) (re.union x (re.union y z))))
(declare-axiom (= (re.union x x) x))
(declare-axiom (= (re.inter x y) (re.inter y x)))
(declare-axiom (= (re.inter (re.inter x y) z) (re.inter x (re.inter y z))))
(declare-axiom (= (re.inter x x) x))
(declare-axiom (= (re.++ (re.++ x y) z) (re.++ x (re.++ y z))))
(declare-axiom (= (re.* (re.* x)) (re.* x)))
(declare-axiom (= (re.plus (re.plus x)) (re.plus x)))
(declare-axiom (= (re.opt (re.opt x)) (re.opt x)))
(declare-axiom (= (re.opt (re.* x)) (re.* x)))
(declare-axiom (= (re.* (re.opt x)) (re.* x)))
(declare-axiom (= (re.plus (re.* x)) (re.* x)))
(declare-axiom (= (re.* (re.plus x)) (re.* x)))
(declare-axiom (= (re.opt (re.plus x)) (re.* x)))
(declare-axiom (= (re.plus (re.opt x)) (re.* x)))
(declare-axiom (= (re.++ (re.* x) (re.* x)) (re.* x)))
(declare-axiom (= (re.++ (re.* x) (re.opt x)) (re.* x)))
(declare-axiom (= (re.++ (re.opt x) (re.* x)) (re.* x)))
(declare-axiom (= (re.++ (re.plus x) (re.* x)) (re.plus x)))
(declare-axiom (= (re.++ (re.* x) (re.plus x)) (re.plus x)))
(declare-axiom (= (re.union (re.opt x) (re.* x)) (re.* x)))
(declare-axiom (= (re.union (re.* x) (re.opt x)) (re.* x)))
(declare-axiom (= (re.union (re.plus x) (re.* x)) (re.* x)))
(declare-axiom (= (re.union (re.* x) (re.plus x)) (re.* x)))

(define-aspects RegLan.Asp
  (record (i Pos) (j Pos))
  :where (leq i j))

(define-semantics
  ((RegLan.Sem (r RegLan) (asp RegLan.Asp)))
  ((match r
     ((char.any) (and (succ (j asp) (i asp)) (is.any (i asp))))
     ((char.x30) (and (succ (j asp) (i asp)) (is.x30 (i asp))))
     ((char.x31) (and (succ (j asp) (i asp)) (is.x31 (i asp))))
     ((char.x32) (and (succ (j asp) (i asp)) (is.x32 (i asp))))
     ((char.x33) (and (succ (j asp) (i asp)) (is.x33 (i asp))))
     ((char.x34) (and (succ (j asp) (i asp)) (is.x34 (i asp))))
     ((char.x35) (and (succ (j asp) (i asp)) (is.x35 (i asp))))
     ((char.x36) (and (succ (j asp) (i asp)) (is.x36 (i asp))))
     ((char.x37) (and (succ (j asp) (i asp)) (is.x37 (i asp))))
     ((char.x38) (and (succ (j asp) (i asp)) (is.x38 (i asp))))
     ((char.x39) (and (succ (j asp) (i asp)) (is.x39 (i asp))))
     ((char.range.x31.x39) (and (succ (j asp) (i asp)) (is.range.x31.x39 (i asp))))
     ((re.opt x)
      (or (= (i asp) (j asp))
          (RegLan.Sem x asp)))
     ((re.plus x)
      (exists ((k Pos))
        (and (leq (i asp) k) (not (= (i asp) k)) (leq k (j asp))
             (RegLan.Sem x (RegLan.Asp (i asp) k))
             (or (= k (j asp))
                 (RegLan.Sem r (RegLan.Asp k (j asp)))))))
     ((re.++ x y)
      (exists ((k Pos))
        (and (leq (i asp) k) (leq k (j asp))
             (RegLan.Sem x (RegLan.Asp (i asp) k))
             (RegLan.Sem y (RegLan.Asp k (j asp))))))
     ((re.union x y)
      (or (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.inter x y)
      (and (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.* x)
      (or (= (i asp) (j asp))
          (exists ((k Pos))
            (and (leq (i asp) k) (not (= (i asp) k)) (leq k (j asp))
                 (RegLan.Sem x (RegLan.Asp (i asp) k))
                 (RegLan.Sem r (RegLan.Asp k (j asp))))))))))
