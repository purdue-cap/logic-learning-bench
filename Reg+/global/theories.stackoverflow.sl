(provide RegLan RegLan.Asp RegLan.Sem re.opt re.plus re.++ re.union re.inter re.* char.any char.digit char.lower char.upper char.alpha char.alnum char.word char.space char.hex char.x21 char.x23 char.x24 char.x25 char.x26 char.x27 char.x28 char.x29 char.x2A char.x2B char.x2C char.x2D char.x2E char.x2F char.x3A char.x3B char.x3C char.x3D char.x3E char.x3F char.x40 char.x5C char.x5E char.x5F char.x7B char.x7C char.x7D)
(require "./signatures.stackoverflow.sl")

(declare-term-types
 ((RegLan 0))
 (((char.any) (char.digit) (char.lower) (char.upper) (char.alpha) (char.alnum) (char.word) (char.space) (char.hex) (char.x21) (char.x23) (char.x24) (char.x25) (char.x26) (char.x27) (char.x28) (char.x29) (char.x2A) (char.x2B) (char.x2C) (char.x2D) (char.x2E) (char.x2F) (char.x3A) (char.x3B) (char.x3C) (char.x3D) (char.x3E) (char.x3F) (char.x40) (char.x5C) (char.x5E) (char.x5F) (char.x7B) (char.x7C) (char.x7D)
   (re.opt RegLan)
   (re.plus RegLan)
   (re.++ RegLan RegLan)
   (re.union RegLan RegLan)
   (re.inter RegLan RegLan)
   (re.* RegLan))))

; Canonical algebraic axioms for pruning.
(declare-axiom (= (re.union x y) (re.union y x)))
(declare-axiom (= (re.union (re.union x y) z) (re.union x (re.union y z))))
(declare-axiom (= (re.union x x) x))
(declare-axiom (= (re.inter x y) (re.inter y x)))
(declare-axiom (= (re.inter (re.inter x y) z) (re.inter x (re.inter y z))))
(declare-axiom (= (re.inter x x) x))
(declare-axiom (= (re.++ (re.++ x y) z) (re.++ x (re.++ y z))))

; Regex simplifications from AlphaRegex-style normalization.
(declare-axiom (= (re.* (re.* x)) (re.* x)))
(declare-axiom (= (re.plus (re.plus x)) (re.plus x)))
(declare-axiom (= (re.opt (re.opt x)) (re.opt x)))
(declare-axiom (= (re.opt (re.* x)) (re.* x)))
(declare-axiom (= (re.* (re.opt x)) (re.* x)))
(declare-axiom (= (re.plus (re.* x)) (re.* x)))
(declare-axiom (= (re.* (re.plus x)) (re.* x)))
(declare-axiom (= (re.opt (re.plus x)) (re.* x)))
(declare-axiom (= (re.plus (re.opt x)) (re.* x)))
(declare-axiom (= (re.++ (re.* x) (re.* x)) (re.* x)))
(declare-axiom (= (re.++ (re.* x) (re.opt x)) (re.* x)))
(declare-axiom (= (re.++ (re.opt x) (re.* x)) (re.* x)))
(declare-axiom (= (re.++ (re.plus x) (re.* x)) (re.plus x)))
(declare-axiom (= (re.++ (re.* x) (re.plus x)) (re.plus x)))
(declare-axiom (= (re.union (re.opt x) (re.* x)) (re.* x)))
(declare-axiom (= (re.union (re.* x) (re.opt x)) (re.* x)))
(declare-axiom (= (re.union (re.plus x) (re.* x)) (re.* x)))
(declare-axiom (= (re.union (re.* x) (re.plus x)) (re.* x)))

(define-aspects RegLan.Asp
  (record (model Model) (i Pos) (j Pos))
  :where (leq i j))

(define-semantics
  ((RegLan.Sem (r RegLan) (asp RegLan.Asp)))
  ((match r
     ((char.any) (and (succ (j asp) (i asp)) (is.any (i asp))))
     ((char.digit) (and (succ (j asp) (i asp)) (is.digit (i asp))))
     ((char.lower) (and (succ (j asp) (i asp)) (is.lower (i asp))))
     ((char.upper) (and (succ (j asp) (i asp)) (is.upper (i asp))))
     ((char.alpha) (and (succ (j asp) (i asp)) (is.alpha (i asp))))
     ((char.alnum) (and (succ (j asp) (i asp)) (is.alnum (i asp))))
     ((char.word) (and (succ (j asp) (i asp)) (is.word (i asp))))
     ((char.space) (and (succ (j asp) (i asp)) (is.space (i asp))))
     ((char.hex) (and (succ (j asp) (i asp)) (is.hex (i asp))))
     ((char.x21) (and (succ (j asp) (i asp)) (is.x21 (i asp))))
     ((char.x23) (and (succ (j asp) (i asp)) (is.x23 (i asp))))
     ((char.x24) (and (succ (j asp) (i asp)) (is.x24 (i asp))))
     ((char.x25) (and (succ (j asp) (i asp)) (is.x25 (i asp))))
     ((char.x26) (and (succ (j asp) (i asp)) (is.x26 (i asp))))
     ((char.x27) (and (succ (j asp) (i asp)) (is.x27 (i asp))))
     ((char.x28) (and (succ (j asp) (i asp)) (is.x28 (i asp))))
     ((char.x29) (and (succ (j asp) (i asp)) (is.x29 (i asp))))
     ((char.x2A) (and (succ (j asp) (i asp)) (is.x2A (i asp))))
     ((char.x2B) (and (succ (j asp) (i asp)) (is.x2B (i asp))))
     ((char.x2C) (and (succ (j asp) (i asp)) (is.x2C (i asp))))
     ((char.x2D) (and (succ (j asp) (i asp)) (is.x2D (i asp))))
     ((char.x2E) (and (succ (j asp) (i asp)) (is.x2E (i asp))))
     ((char.x2F) (and (succ (j asp) (i asp)) (is.x2F (i asp))))
     ((char.x3A) (and (succ (j asp) (i asp)) (is.x3A (i asp))))
     ((char.x3B) (and (succ (j asp) (i asp)) (is.x3B (i asp))))
     ((char.x3C) (and (succ (j asp) (i asp)) (is.x3C (i asp))))
     ((char.x3D) (and (succ (j asp) (i asp)) (is.x3D (i asp))))
     ((char.x3E) (and (succ (j asp) (i asp)) (is.x3E (i asp))))
     ((char.x3F) (and (succ (j asp) (i asp)) (is.x3F (i asp))))
     ((char.x40) (and (succ (j asp) (i asp)) (is.x40 (i asp))))
     ((char.x5C) (and (succ (j asp) (i asp)) (is.x5C (i asp))))
     ((char.x5E) (and (succ (j asp) (i asp)) (is.x5E (i asp))))
     ((char.x5F) (and (succ (j asp) (i asp)) (is.x5F (i asp))))
     ((char.x7B) (and (succ (j asp) (i asp)) (is.x7B (i asp))))
     ((char.x7C) (and (succ (j asp) (i asp)) (is.x7C (i asp))))
     ((char.x7D) (and (succ (j asp) (i asp)) (is.x7D (i asp))))
     ((re.opt x)
      (or (= (i asp) (j asp))
          (RegLan.Sem x asp)))
     ((re.plus x)
      (exists ((k (univ (Pos (model asp)))))
        (and (leq (i asp) k) (not (= (i asp) k)) (leq k (j asp))
             (RegLan.Sem x (RegLan.Asp (model asp) (i asp) k))
             (or (= k (j asp))
                 (RegLan.Sem r (RegLan.Asp (model asp) k (j asp)))))))
     ((re.++ x y)
      (exists ((k (univ (Pos (model asp)))))
        (and (leq (i asp) k) (leq k (j asp))
             (RegLan.Sem x (RegLan.Asp (model asp) (i asp) k))
             (RegLan.Sem y (RegLan.Asp (model asp) k (j asp))))))
     ((re.union x y)
      (or (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.inter x y)
      (and (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.* x)
      (or (= (i asp) (j asp))
          (exists ((k (univ (Pos (model asp)))))
            (and (leq (i asp) k) (not (= (i asp) k)) (leq k (j asp))
                 (RegLan.Sem x (RegLan.Asp (model asp) (i asp) k))
                 (RegLan.Sem r (RegLan.Asp (model asp) k (j asp))))))))))
