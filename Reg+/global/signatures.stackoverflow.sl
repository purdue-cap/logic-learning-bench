(provide Pos is.any is.digit is.lower is.upper is.alpha is.alnum is.word is.space is.hex is.x21 is.x23 is.x24 is.x25 is.x26 is.x27 is.x28 is.x29 is.x2A is.x2B is.x2C is.x2D is.x2E is.x2F is.x3A is.x3B is.x3C is.x3D is.x3E is.x3F is.x40 is.x5C is.x5E is.x5F is.x7B is.x7C is.x7D)
(declare-sort Pos 0)
; any character
(declare-fun is.any (Pos) Bool)
; 0-9
(declare-fun is.digit (Pos) Bool)
; a-z
(declare-fun is.lower (Pos) Bool)
; A-Z
(declare-fun is.upper (Pos) Bool)
; A-Z, a-z
(declare-fun is.alpha (Pos) Bool)
; A-Z, a-z, 0-9
(declare-fun is.alnum (Pos) Bool)
; A-Z, a-z, 0-9, _
(declare-fun is.word (Pos) Bool)
; space, tab, newline
(declare-fun is.space (Pos) Bool)
; 0-9, a-f, A-F
(declare-fun is.hex (Pos) Bool)
; '!' (0x21)
(declare-fun is.x21 (Pos) Bool)
; '#' (0x23)
(declare-fun is.x23 (Pos) Bool)
; '$' (0x24)
(declare-fun is.x24 (Pos) Bool)
; '%' (0x25)
(declare-fun is.x25 (Pos) Bool)
; '&' (0x26)
(declare-fun is.x26 (Pos) Bool)
; ''' (0x27)
(declare-fun is.x27 (Pos) Bool)
; '(' (0x28)
(declare-fun is.x28 (Pos) Bool)
; ')' (0x29)
(declare-fun is.x29 (Pos) Bool)
; '*' (0x2A)
(declare-fun is.x2A (Pos) Bool)
; '+' (0x2B)
(declare-fun is.x2B (Pos) Bool)
; ',' (0x2C)
(declare-fun is.x2C (Pos) Bool)
; '-' (0x2D)
(declare-fun is.x2D (Pos) Bool)
; '.' (0x2E)
(declare-fun is.x2E (Pos) Bool)
; '/' (0x2F)
(declare-fun is.x2F (Pos) Bool)
; ':' (0x3A)
(declare-fun is.x3A (Pos) Bool)
; ';' (0x3B)
(declare-fun is.x3B (Pos) Bool)
; '<' (0x3C)
(declare-fun is.x3C (Pos) Bool)
; '=' (0x3D)
(declare-fun is.x3D (Pos) Bool)
; '>' (0x3E)
(declare-fun is.x3E (Pos) Bool)
; '?' (0x3F)
(declare-fun is.x3F (Pos) Bool)
; '@' (0x40)
(declare-fun is.x40 (Pos) Bool)
; '\\' (0x5C)
(declare-fun is.x5C (Pos) Bool)
; '^' (0x5E)
(declare-fun is.x5E (Pos) Bool)
; '_' (0x5F)
(declare-fun is.x5F (Pos) Bool)
; '{' (0x7B)
(declare-fun is.x7B (Pos) Bool)
; '|' (0x7C)
(declare-fun is.x7C (Pos) Bool)
; '}' (0x7D)
(declare-fun is.x7D (Pos) Bool)
