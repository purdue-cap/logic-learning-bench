(provide RegLan RegLan.Asp RegLan.Sem re.opt re.plus re.++ re.union re.inter re.* char.any char.digit char.lower char.upper char.alpha char.alnum char.word char.space char.hex char.x20 char.x21 char.x23 char.x25 char.x2C char.x2D char.x2E char.x30 char.x31 char.x32 char.x33 char.x34 char.x35 char.x36 char.x37 char.x38 char.x39 char.x40 char.x41 char.x42 char.x45 char.x48 char.x4C char.x4F char.x5A char.x61 char.x62 char.x63 char.x64 char.x65 char.x67 char.x68 char.x69 char.x6E char.x6F char.x74 char.x79 char.x39B)
(require "./signatures.stackoverflow.regfix.sl")

(declare-term-types
 ((RegLan 0))
 (((char.any) (char.digit) (char.lower) (char.upper) (char.alpha) (char.alnum) (char.word) (char.space) (char.hex) (char.x20) (char.x21) (char.x23) (char.x25) (char.x2C) (char.x2D) (char.x2E) (char.x30) (char.x31) (char.x32) (char.x33) (char.x34) (char.x35) (char.x36) (char.x37) (char.x38) (char.x39) (char.x40) (char.x41) (char.x42) (char.x45) (char.x48) (char.x4C) (char.x4F) (char.x5A) (char.x61) (char.x62) (char.x63) (char.x64) (char.x65) (char.x67) (char.x68) (char.x69) (char.x6E) (char.x6F) (char.x74) (char.x79) (char.x39B)
   (re.opt RegLan)
   (re.plus RegLan)
   (re.++ RegLan RegLan)
   (re.union RegLan RegLan)
   (re.inter RegLan RegLan)
   (re.* RegLan))))

(declare-axiom (= (re.union x y) (re.union y x)))
(declare-axiom (= (re.union (re.union x y) z) (re.union x (re.union y z))))
(declare-axiom (= (re.union x x) x))
(declare-axiom (= (re.inter x y) (re.inter y x)))
(declare-axiom (= (re.inter (re.inter x y) z) (re.inter x (re.inter y z))))
(declare-axiom (= (re.inter x x) x))
(declare-axiom (= (re.++ (re.++ x y) z) (re.++ x (re.++ y z))))
(declare-axiom (= (re.* (re.* x)) (re.* x)))
(declare-axiom (= (re.plus (re.plus x)) (re.plus x)))
(declare-axiom (= (re.opt (re.opt x)) (re.opt x)))
(declare-axiom (= (re.opt (re.* x)) (re.* x)))
(declare-axiom (= (re.* (re.opt x)) (re.* x)))
(declare-axiom (= (re.plus (re.* x)) (re.* x)))
(declare-axiom (= (re.* (re.plus x)) (re.* x)))
(declare-axiom (= (re.opt (re.plus x)) (re.* x)))
(declare-axiom (= (re.plus (re.opt x)) (re.* x)))
(declare-axiom (= (re.++ (re.* x) (re.* x)) (re.* x)))
(declare-axiom (= (re.++ (re.* x) (re.opt x)) (re.* x)))
(declare-axiom (= (re.++ (re.opt x) (re.* x)) (re.* x)))
(declare-axiom (= (re.++ (re.plus x) (re.* x)) (re.plus x)))
(declare-axiom (= (re.++ (re.* x) (re.plus x)) (re.plus x)))
(declare-axiom (= (re.union (re.opt x) (re.* x)) (re.* x)))
(declare-axiom (= (re.union (re.* x) (re.opt x)) (re.* x)))
(declare-axiom (= (re.union (re.plus x) (re.* x)) (re.* x)))
(declare-axiom (= (re.union (re.* x) (re.plus x)) (re.* x)))

(define-aspects RegLan.Asp
  (record (model Model) (i Int) (j Int))
  :where (and (<= 0 i) (<= i j) (<= j (size (Pos model)))))

(define-semantics
  ((RegLan.Sem (r RegLan) (asp RegLan.Asp)))
  ((match r
     ((char.any) (and (= (j asp) (+ (i asp) 1)) (is.any (i asp))))
     ((char.digit) (and (= (j asp) (+ (i asp) 1)) (is.digit (i asp))))
     ((char.lower) (and (= (j asp) (+ (i asp) 1)) (is.lower (i asp))))
     ((char.upper) (and (= (j asp) (+ (i asp) 1)) (is.upper (i asp))))
     ((char.alpha) (and (= (j asp) (+ (i asp) 1)) (is.alpha (i asp))))
     ((char.alnum) (and (= (j asp) (+ (i asp) 1)) (is.alnum (i asp))))
     ((char.word) (and (= (j asp) (+ (i asp) 1)) (is.word (i asp))))
     ((char.space) (and (= (j asp) (+ (i asp) 1)) (is.space (i asp))))
     ((char.hex) (and (= (j asp) (+ (i asp) 1)) (is.hex (i asp))))
     ((char.x20) (and (= (j asp) (+ (i asp) 1)) (is.x20 (i asp))))
     ((char.x21) (and (= (j asp) (+ (i asp) 1)) (is.x21 (i asp))))
     ((char.x23) (and (= (j asp) (+ (i asp) 1)) (is.x23 (i asp))))
     ((char.x25) (and (= (j asp) (+ (i asp) 1)) (is.x25 (i asp))))
     ((char.x2C) (and (= (j asp) (+ (i asp) 1)) (is.x2C (i asp))))
     ((char.x2D) (and (= (j asp) (+ (i asp) 1)) (is.x2D (i asp))))
     ((char.x2E) (and (= (j asp) (+ (i asp) 1)) (is.x2E (i asp))))
     ((char.x30) (and (= (j asp) (+ (i asp) 1)) (is.x30 (i asp))))
     ((char.x31) (and (= (j asp) (+ (i asp) 1)) (is.x31 (i asp))))
     ((char.x32) (and (= (j asp) (+ (i asp) 1)) (is.x32 (i asp))))
     ((char.x33) (and (= (j asp) (+ (i asp) 1)) (is.x33 (i asp))))
     ((char.x34) (and (= (j asp) (+ (i asp) 1)) (is.x34 (i asp))))
     ((char.x35) (and (= (j asp) (+ (i asp) 1)) (is.x35 (i asp))))
     ((char.x36) (and (= (j asp) (+ (i asp) 1)) (is.x36 (i asp))))
     ((char.x37) (and (= (j asp) (+ (i asp) 1)) (is.x37 (i asp))))
     ((char.x38) (and (= (j asp) (+ (i asp) 1)) (is.x38 (i asp))))
     ((char.x39) (and (= (j asp) (+ (i asp) 1)) (is.x39 (i asp))))
     ((char.x40) (and (= (j asp) (+ (i asp) 1)) (is.x40 (i asp))))
     ((char.x41) (and (= (j asp) (+ (i asp) 1)) (is.x41 (i asp))))
     ((char.x42) (and (= (j asp) (+ (i asp) 1)) (is.x42 (i asp))))
     ((char.x45) (and (= (j asp) (+ (i asp) 1)) (is.x45 (i asp))))
     ((char.x48) (and (= (j asp) (+ (i asp) 1)) (is.x48 (i asp))))
     ((char.x4C) (and (= (j asp) (+ (i asp) 1)) (is.x4C (i asp))))
     ((char.x4F) (and (= (j asp) (+ (i asp) 1)) (is.x4F (i asp))))
     ((char.x5A) (and (= (j asp) (+ (i asp) 1)) (is.x5A (i asp))))
     ((char.x61) (and (= (j asp) (+ (i asp) 1)) (is.x61 (i asp))))
     ((char.x62) (and (= (j asp) (+ (i asp) 1)) (is.x62 (i asp))))
     ((char.x63) (and (= (j asp) (+ (i asp) 1)) (is.x63 (i asp))))
     ((char.x64) (and (= (j asp) (+ (i asp) 1)) (is.x64 (i asp))))
     ((char.x65) (and (= (j asp) (+ (i asp) 1)) (is.x65 (i asp))))
     ((char.x67) (and (= (j asp) (+ (i asp) 1)) (is.x67 (i asp))))
     ((char.x68) (and (= (j asp) (+ (i asp) 1)) (is.x68 (i asp))))
     ((char.x69) (and (= (j asp) (+ (i asp) 1)) (is.x69 (i asp))))
     ((char.x6E) (and (= (j asp) (+ (i asp) 1)) (is.x6E (i asp))))
     ((char.x6F) (and (= (j asp) (+ (i asp) 1)) (is.x6F (i asp))))
     ((char.x74) (and (= (j asp) (+ (i asp) 1)) (is.x74 (i asp))))
     ((char.x79) (and (= (j asp) (+ (i asp) 1)) (is.x79 (i asp))))
     ((char.x39B) (and (= (j asp) (+ (i asp) 1)) (is.x39B (i asp))))
     ((re.opt x)
      (or (= (i asp) (j asp))
          (RegLan.Sem x asp)))
     ((re.plus x)
      (exists ((k (int-range (+ (i asp) 1) (j asp))))
        (and (RegLan.Sem x (RegLan.Asp (model asp) (i asp) k))
             (or (= k (j asp))
                 (RegLan.Sem r (RegLan.Asp (model asp) k (j asp)))))))
     ((re.++ x y)
      (exists ((k (int-range (i asp) (j asp))))
        (and (RegLan.Sem x (RegLan.Asp (model asp) (i asp) k))
             (RegLan.Sem y (RegLan.Asp (model asp) k (j asp))))))
     ((re.union x y)
      (or (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.inter x y)
      (and (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.* x)
      (or (= (i asp) (j asp))
          (exists ((k (int-range (+ (i asp) 1) (j asp))))
            (and (RegLan.Sem x (RegLan.Asp (model asp) (i asp) k))
                 (RegLan.Sem r (RegLan.Asp (model asp) k (j asp))))))))))
