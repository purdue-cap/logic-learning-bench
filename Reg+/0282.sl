(set-info :author "Chentian Wu")
(set-info :source "REGEL (stackoverflow/86) — gt=and(and(repeatatleast(or(or(<let>,<num>),<->),1),not(startwith(<->))),not(endwith(<->)))")
(set-info :description "a regular expression for validating a string with alphanumeric characters and dashes, while also not allowing leading or trailing dashes")

(require "./global/theories.stackoverflow.sl")
(require "./global/models.stackoverflow.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00484 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00111 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00703 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00694 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00145 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00381 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00445 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00443 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00656 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00316 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00272 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00182 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00669 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00524 head tail))))

(check-synth)
