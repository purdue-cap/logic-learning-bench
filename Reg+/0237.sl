(set-info :author "Chentian Wu")
(set-info :source "REGEL (stackoverflow/39) — gt=and(concat(repeatrange(<num>,1,13),optional(concat(<.>,repeatrange(<num>,1,2)))),not(contain(concat(<.>,<0>))))")
(set-info :description "I am trying to use a regular expression to validate decimal values. Rules : It should allow positive numbers. It should allow max 13 numbers before decimal point. It should allow max two number after decimal. It should allow .(dot) with number like a ''.5''. It should not allow the ''.0''")

(require "./global/theories.stackoverflow.sl")
(require "./global/models.stackoverflow.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00030 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00031 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00028 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00006 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00099 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00188 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00626 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00660 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00671 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00005 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00027 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00274 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00053 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00647 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00676 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
