(set-info :author "Chentian Wu")
(set-info :source "REGEL (stackoverflow/39) — gt=and(concat(repeatrange(<num>,1,13),optional(concat(<.>,repeatrange(<num>,1,2)))),not(contain(concat(<.>,<0>))))")
(set-info :description "I am trying to use a regular expression to validate decimal values. Rules : It should allow positive numbers. It should allow max 13 numbers before decimal point. It should allow max two number after decimal. It should allow .(dot) with number like a ''.5''. It should not allow the ''.0''")

(require "./global/theories.stackoverflow.sl")
(require "./global/models.stackoverflow.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00030 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00031 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00028 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00006 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00099 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00188 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00626 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00660 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00671 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00005 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00027 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00274 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00053 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00647 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00676 head tail))))

(check-synth)
