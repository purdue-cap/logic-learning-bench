(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/50) — gt=endwith(or(and(<let>,<vow>),<m0>))")
(set-info :description "lines ending in a letter and vowel or string '!'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00229 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00520 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00238 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00975 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01243 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00779 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00778 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w01248 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01470 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01297 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01398 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01429 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01393 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01461 head tail))))

(check-synth)
