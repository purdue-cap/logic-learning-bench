(constraint      (with-model w00779 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00778 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w01248 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01470 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01297 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01398 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01429 (RegLan.Sem r (RegLan.Asp head tail)))))
