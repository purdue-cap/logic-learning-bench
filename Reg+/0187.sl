(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/195) — gt=not(startwith(or(<let>,<m0>)))")
(set-info :description "lines not starting with a letter or string '!'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")
(require "./global/models.deepregex.empty.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp wempty_deepregex head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00011 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00019 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00119 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00149 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00432 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00394 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00003 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00530 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00218 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00079 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00069 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00609 head tail))))

(check-synth)
