(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/65) — gt=endwith(or(<m0>,<vow>))")
(set-info :description "lines end with the string '!' or a vowel")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")
(require "./global/models.deepregex.empty.sl")

(synth-fun r () RegLan)

(constraint (not (RegLan.Sem r (RegLan.Asp wempty_deepregex head tail))))
(constraint      (RegLan.Sem r (RegLan.Asp w00897 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00003 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00038 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00710 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01139 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01138 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00867 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00364 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01155 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00868 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01022 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01230 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01192 head tail))))

(check-synth)
