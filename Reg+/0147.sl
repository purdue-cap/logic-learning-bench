(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/154) — gt=concat(repeatatleast(<cap>,2),contain(<any>))")
(set-info :description "lines with a capital letter , 2 or more times before a character in them")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00903 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00904 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01040 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01285 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00919 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01183 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00478 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00172 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00465 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00717 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00394 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00568 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00686 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00572 head tail))))

(check-synth)
