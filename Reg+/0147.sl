(constraint      (with-model w01183 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00478 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00172 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00465 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00717 (RegLan.Sem r (RegLan.Asp head tail)))))
