(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/114) — gt=concat(<num>,contain(and(<m0>,<any>)))")
(set-info :description "lines with a number before string '!' and a character")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00388 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00682 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01023 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00878 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01001 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00691 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00890 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w01372 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01488 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01477 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01327 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00372 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01304 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00796 head tail))))

(check-synth)
