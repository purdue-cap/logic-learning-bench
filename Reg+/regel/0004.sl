(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/4) — gt=star(concat(<low>,contain(<cap>)))")
(set-info :description "lines with a lower case letter followed by capital letter , zero or more time")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00224 0 (size (Pos w00224)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00243 0 (size (Pos w00243)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00541 0 (size (Pos w00541)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00542 0 (size (Pos w00542)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00734 0 (size (Pos w00734)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00735 0 (size (Pos w00735)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00544 0 (size (Pos w00544)))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 0 (size (Pos w00038))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00039 0 (size (Pos w00039))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 0 (size (Pos w00011))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00012 0 (size (Pos w00012))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00229 0 (size (Pos w00229))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00169 0 (size (Pos w00169))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00002 0 (size (Pos w00002))))))

(check-synth)
