(constraint      (RegLan.Sem r (RegLan.Asp w00112 0 (size (Pos w00112)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00239 0 (size (Pos w00239)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00137 0 (size (Pos w00137)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00272 0 (size (Pos w00272)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00273 0 (size (Pos w00273)))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 0 (size (Pos w00011))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 0 (size (Pos w00038))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00009 0 (size (Pos w00009))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00007 0 (size (Pos w00007))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00172 0 (size (Pos w00172))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00180 0 (size (Pos w00180))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00191 0 (size (Pos w00191))))))

(check-synth)
