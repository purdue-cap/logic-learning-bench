(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/143.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "BCDAa")
(define-fun w2 () String "Ds")
(define-fun w3 () String "Q23d")
(define-fun w4 () String "Eg2")
(define-fun w5 () String "FdFVs")
(define-fun w6 () String "RE2d4")
(define-fun w7 () String "Cr2")
(define-fun w8 () String "a")
(define-fun w9 () String "cc")
(define-fun w10 () String "1Aw")
(define-fun w11 () String "fQf")
(define-fun w12 () String "2A3")
(define-fun w13 () String "LLL")
(define-fun w14 () String "K89")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "8")
                (str.to_re "9")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "C")
                (str.to_re "D")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "K")
                (str.to_re "L")
                (str.to_re "Q")
                (str.to_re "R")
                (str.to_re "V")
                (str.to_re "a")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "w")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
