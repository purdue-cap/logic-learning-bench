(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/74.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "@f15")
(define-fun w2 () String "gcaro")
(define-fun w3 () String "Ciro211")
(define-fun w4 () String "Z2i3")
(define-fun w5 () String " !jdfkj")
(define-fun w6 () String "F!2i3r")
(define-fun w7 () String "!")
(define-fun w8 () String "1erfa2")
(define-fun w9 () String "5afAfjw!")
(define-fun w10 () String "9!isfoK")
(define-fun w11 () String "!!fja22")
(define-fun w12 () String "2")
(define-fun w13 () String "9")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "5")
                (str.to_re "9")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "C")
                (str.to_re "F")
                (str.to_re "K")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "i")
                (str.to_re "j")
                (str.to_re "k")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "w")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (not (str.in_re w7 r)))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
