(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/95.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "a")
(define-fun w2 () String "adfa")
(define-fun w3 () String "wW")
(define-fun w4 () String "akfjas")
(define-fun w5 () String "afjlsf")
(define-fun w6 () String "#?a")
(define-fun w7 () String "a!!")
(define-fun w8 () String "A")
(define-fun w9 () String "AA")
(define-fun w10 () String "BS")
(define-fun w11 () String "WWWWWWW")
(define-fun w12 () String "AJKALJLAJKJL")
(define-fun w13 () String "!@#!@#!@#!@#")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "#")
                (str.to_re "?")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "J")
                (str.to_re "K")
                (str.to_re "L")
                (str.to_re "S")
                (str.to_re "W")
                (str.to_re "a")
                (str.to_re "d")
                (str.to_re "f")
                (str.to_re "j")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "s")
                (str.to_re "w")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
