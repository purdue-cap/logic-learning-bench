(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/173.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "ABCD!")
(define-fun w2 () String "BCDF!")
(define-fun w3 () String "BCDFF!")
(define-fun w4 () String "ABCDE!!")
(define-fun w5 () String "PPPP!12")
(define-fun w6 () String "QQQQQ!!1")
(define-fun w7 () String "QQQQ!abc")
(define-fun w8 () String " ")
(define-fun w9 () String "a")
(define-fun w10 () String "ABCD")
(define-fun w11 () String "b")
(define-fun w12 () String "AB")
(define-fun w13 () String "ABC")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "C")
                (str.to_re "D")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "P")
                (str.to_re "Q")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
