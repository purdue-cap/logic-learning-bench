(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/64.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "Abc\\Def\\Ghi")
(define-fun w2 () String "Zfw\\Fewfa\\Kwer")
(define-fun w3 () String "Xreragsdgafawer\\Cfasdwerdfsdf\\Kapworfldsa")
(define-fun w4 () String "Hifowld\\Asdfa\\Ddfower\\Casowerp\\Aowerp\\Gsdfa")
(define-fun w5 () String "Fsdower\\Casdfr\\DDaowe\\Kaowerp")
(define-fun w6 () String "Ionosphere\\Game\\Theory\\Sucks\\Haha")
(define-fun w7 () String "Crpwpap\\Howerp\\Gsowerp\\Toweripa")
(define-fun w8 () String "Abc")
(define-fun w9 () String "Abc\\Def\\hijkl")
(define-fun w10 () String "Tel\\soapw\\Gpfa")
(define-fun w11 () String "abcd\\efwa\\gowpzr\\kldfkl")
(define-fun w12 () String "t")
(define-fun w13 () String "agowp\\Aowerip\\C023123")
(define-fun w14 () String "a2kf\\Cworp\\Tawoer")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "A")
                (str.to_re "C")
                (str.to_re "D")
                (str.to_re "F")
                (str.to_re "G")
                (str.to_re "H")
                (str.to_re "I")
                (str.to_re "K")
                (str.to_re "S")
                (str.to_re "T")
                (str.to_re "X")
                (str.to_re "Z")
                (str.to_re "\\")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "j")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "m")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "p")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                (str.to_re "w")
                (str.to_re "y")
                (str.to_re "z")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
