(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/128.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "ab!!")
(define-fun w2 () String "natural!!!")
(define-fun w3 () String "unta!!")
(define-fun w4 () String "bAb!!")
(define-fun w5 () String "cCa!!sd")
(define-fun w6 () String "jih!!sda")
(define-fun w7 () String "Cosda!s!!sd")
(define-fun w8 () String "s!")
(define-fun w9 () String "one!")
(define-fun w10 () String "no")
(define-fun w11 () String "cool")
(define-fun w12 () String "befeo!sd")
(define-fun w13 () String "123!")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "A")
                (str.to_re "C")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "j")
                (str.to_re "l")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
