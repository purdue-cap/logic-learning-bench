(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/94.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "words5")
(define-fun w2 () String "a")
(define-fun w3 () String "64")
(define-fun w4 () String "128")
(define-fun w5 () String "abc?")
(define-fun w6 () String "888")
(define-fun w7 () String "333")
(define-fun w8 () String "-200")
(define-fun w9 () String "*")
(define-fun w10 () String "!")
(define-fun w11 () String "@")
(define-fun w12 () String "#")
(define-fun w13 () String "$")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "#")
                (str.to_re "$")
                (str.to_re "*")
                (str.to_re "-")
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "6")
                (str.to_re "8")
                (str.to_re "?")
                (str.to_re "@")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "w")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
