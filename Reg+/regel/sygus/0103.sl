(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/107.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "normal")
(define-fun w2 () String "good")
(define-fun w3 () String "#other")
(define-fun w4 () String "123")
(define-fun w5 () String "not staring!")
(define-fun w6 () String "else !a")
(define-fun w7 () String "@")
(define-fun w8 () String "!")
(define-fun w9 () String "!some")
(define-fun w10 () String "!number123")
(define-fun w11 () String "!!")
(define-fun w12 () String "!#")
(define-fun w13 () String "!AE 123 W")
(define-fun w14 () String "!cc")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re "#")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "E")
                (str.to_re "W")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "l")
                (str.to_re "m")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "u")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
