(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/43.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String ";a")
(define-fun w2 () String "1a")
(define-fun w3 () String "@k")
(define-fun w4 () String "*m")
(define-fun w5 () String "(p")
(define-fun w6 () String "'z")
(define-fun w7 () String "[m")
(define-fun w8 () String ";A")
(define-fun w9 () String "mM")
(define-fun w10 () String "kM")
(define-fun w11 () String "NP")
(define-fun w12 () String "!P")
(define-fun w13 () String "Z")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "'")
                (str.to_re "(")
                (str.to_re "*")
                (str.to_re "1")
                (str.to_re ";")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "M")
                (str.to_re "N")
                (str.to_re "P")
                (str.to_re "Z")
                (str.to_re "[")
                (str.to_re "a")
                (str.to_re "k")
                (str.to_re "m")
                (str.to_re "p")
                (str.to_re "z")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
