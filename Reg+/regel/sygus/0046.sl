(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/46.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "aaaaaaAaa")
(define-fun w2 () String "m;;asdf;cjfdsFasdfF")
(define-fun w3 () String "k!0()sfasdhvyaQQQQAPasdfPPP")
(define-fun w4 () String "g~'\"asdfoqpweru23$_AAaAaBcA")
(define-fun w5 () String "aB")
(define-fun w6 () String "aBa")
(define-fun w7 () String "1Zd3Z3")
(define-fun w8 () String "Aa")
(define-fun w9 () String "BB!z")
(define-fun w10 () String "CCCCCCCC")
(define-fun w11 () String "G")
(define-fun w12 () String "!Lm")
(define-fun w13 () String "~\"Boo")
(define-fun w14 () String "!@#$%1234Moo")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "\"")
                (str.to_re "#")
                (str.to_re "$")
                (str.to_re "%")
                (str.to_re "'")
                (str.to_re "(")
                (str.to_re ")")
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re ";")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "C")
                (str.to_re "F")
                (str.to_re "G")
                (str.to_re "L")
                (str.to_re "M")
                (str.to_re "P")
                (str.to_re "Q")
                (str.to_re "Z")
                (str.to_re "_")
                (str.to_re "a")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "j")
                (str.to_re "k")
                (str.to_re "m")
                (str.to_re "o")
                (str.to_re "p")
                (str.to_re "q")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "u")
                (str.to_re "v")
                (str.to_re "w")
                (str.to_re "y")
                (str.to_re "z")
                (str.to_re "~")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
