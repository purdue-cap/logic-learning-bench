(set-logic SLIA)

; Converted from upstream Regel benchmark stackoverflow/55.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "0.01")
(define-fun w2 () String "0.12")
(define-fun w3 () String "111.23")
(define-fun w4 () String "1234.56")
(define-fun w5 () String "012345.67")
(define-fun w6 () String "123.00")
(define-fun w7 () String "0.00")
(define-fun w8 () String ".12")
(define-fun w9 () String "1.1")
(define-fun w10 () String "0.0")
(define-fun w11 () String "00.00")
(define-fun w12 () String "1234.")
(define-fun w13 () String "1234.567")
(define-fun w14 () String "1234")
(define-fun w15 () String "00123.45")
(define-fun w16 () String "abcd.12")
(define-fun w17 () String "12a4.56")
(define-fun w18 () String "1234.5A")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re ".")
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "6")
                (str.to_re "7")
                (str.to_re "A")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))
(constraint (not (str.in_re w15 r)))
(constraint (not (str.in_re w16 r)))
(constraint (not (str.in_re w17 r)))
(constraint (not (str.in_re w18 r)))

(check-synth)
