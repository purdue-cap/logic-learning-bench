(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/68.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "bBcaDDaff1223f")
(define-fun w2 () String "BBcdswf!942")
(define-fun w3 () String "zfZdkaCOgg23A")
(define-fun w4 () String "XfdaPPweA231cc")
(define-fun w5 () String "KKsdaCVSSD9923")
(define-fun w6 () String "APPCweQCC831")
(define-fun w7 () String "kasowAVKLL12931")
(define-fun w8 () String "avowDZ")
(define-fun w9 () String "EfwkeUUUald")
(define-fun w10 () String "Gwieuaks!!@")
(define-fun w11 () String "J")
(define-fun w12 () String "c")
(define-fun w13 () String "csjhd2")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "8")
                (str.to_re "9")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "C")
                (str.to_re "D")
                (str.to_re "E")
                (str.to_re "G")
                (str.to_re "J")
                (str.to_re "K")
                (str.to_re "L")
                (str.to_re "O")
                (str.to_re "P")
                (str.to_re "Q")
                (str.to_re "S")
                (str.to_re "U")
                (str.to_re "V")
                (str.to_re "X")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "i")
                (str.to_re "j")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "o")
                (str.to_re "s")
                (str.to_re "u")
                (str.to_re "v")
                (str.to_re "w")
                (str.to_re "z")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
