(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/63.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "!")
(define-fun w2 () String " !")
(define-fun w3 () String "jfo123!AA")
(define-fun w4 () String "!aZfja")
(define-fun w5 () String "ac@@!Afai12")
(define-fun w6 () String "rw!!Jf23")
(define-fun w7 () String "9fj!ffAz")
(define-fun w8 () String "A")
(define-fun w9 () String "123fasdA")
(define-fun w10 () String "jfZxZ")
(define-fun w11 () String "12Ufka")
(define-fun w12 () String "k123A2")
(define-fun w13 () String "4C")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "9")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "C")
                (str.to_re "J")
                (str.to_re "U")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "f")
                (str.to_re "i")
                (str.to_re "j")
                (str.to_re "k")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "w")
                (str.to_re "x")
                (str.to_re "z")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
