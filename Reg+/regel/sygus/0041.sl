(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/41.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "a")
(define-fun w2 () String "aA")
(define-fun w3 () String "aaaB")
(define-fun w4 () String "a1")
(define-fun w5 () String "a;")
(define-fun w6 () String "a>?")
(define-fun w7 () String "b///")
(define-fun w8 () String "A")
(define-fun w9 () String "AA")
(define-fun w10 () String "A!")
(define-fun w11 () String "AMC")
(define-fun w12 () String "BBC")
(define-fun w13 () String "CNN")
(define-fun w14 () String "ZZZ!")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "/")
                (str.to_re "1")
                (str.to_re ";")
                (str.to_re ">")
                (str.to_re "?")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "C")
                (str.to_re "M")
                (str.to_re "N")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "b")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
