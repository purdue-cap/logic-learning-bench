(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/42.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "!a")
(define-fun w2 () String "!!")
(define-fun w3 () String "!kl")
(define-fun w4 () String "!;'")
(define-fun w5 () String "!Zz")
(define-fun w6 () String "!?.~")
(define-fun w7 () String "!!!")
(define-fun w8 () String "a!")
(define-fun w9 () String "1!")
(define-fun w10 () String ";!!")
(define-fun w11 () String "m!")
(define-fun w12 () String "z!")
(define-fun w13 () String "007")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "'")
                (str.to_re ".")
                (str.to_re "0")
                (str.to_re "1")
                (str.to_re "7")
                (str.to_re ";")
                (str.to_re "?")
                (str.to_re "Z")
                (str.to_re "a")
                (str.to_re "k")
                (str.to_re "l")
                (str.to_re "m")
                (str.to_re "z")
                (str.to_re "~")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
