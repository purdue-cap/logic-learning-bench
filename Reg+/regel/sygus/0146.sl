(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/153.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "!a")
(define-fun w2 () String "12A")
(define-fun w3 () String "dsge")
(define-fun w4 () String "dI")
(define-fun w5 () String "@o")
(define-fun w6 () String "!jgU")
(define-fun w7 () String "$#!fO")
(define-fun w8 () String "!q")
(define-fun w9 () String "aR")
(define-fun w10 () String "12n")
(define-fun w11 () String "23")
(define-fun w12 () String "t3d")
(define-fun w13 () String "w2")
(define-fun w14 () String "qwb")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "!")
                (str.to_re "#")
                (str.to_re "$")
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "@")
                (str.to_re "A")
                (str.to_re "I")
                (str.to_re "O")
                (str.to_re "R")
                (str.to_re "U")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "d")
                (str.to_re "e")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "j")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "q")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "w")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
