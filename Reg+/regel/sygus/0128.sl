(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/134.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "1A")
(define-fun w2 () String "345F")
(define-fun w3 () String "1asRbr")
(define-fun w4 () String "1dF4sD4fsdTgd3F")
(define-fun w5 () String "4g3F5f2H6d3E")
(define-fun w6 () String "6fE45")
(define-fun w7 () String "A")
(define-fun w8 () String "1")
(define-fun w9 () String "h")
(define-fun w10 () String "6fgj")
(define-fun w11 () String "8g6cg98gh")
(define-fun w12 () String "A3467")
(define-fun w13 () String "NBGFD13")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "6")
                (str.to_re "7")
                (str.to_re "8")
                (str.to_re "9")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "D")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "G")
                (str.to_re "H")
                (str.to_re "N")
                (str.to_re "R")
                (str.to_re "T")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "f")
                (str.to_re "g")
                (str.to_re "h")
                (str.to_re "j")
                (str.to_re "r")
                (str.to_re "s")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (not (str.in_re w7 r)))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))

(check-synth)
