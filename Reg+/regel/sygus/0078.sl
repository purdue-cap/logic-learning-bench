(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/79.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "!a")
(define-fun w2 () String "!b")
(define-fun w3 () String "!!a")
(define-fun w4 () String "!a!a")
(define-fun w5 () String "!!b!!b")
(define-fun w6 () String "!ba")
(define-fun w7 () String "b")
(define-fun w8 () String "words containing")
(define-fun w9 () String "start!")
(define-fun w10 () String ",,,")
(define-fun w11 () String "!,")
(define-fun w12 () String "lol")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re " ")
                (str.to_re "!")
                (str.to_re ",")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "g")
                (str.to_re "i")
                (str.to_re "l")
                (str.to_re "n")
                (str.to_re "o")
                (str.to_re "r")
                (str.to_re "s")
                (str.to_re "t")
                (str.to_re "w")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w1 r))
(constraint (not (str.in_re w7 r)))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))

(check-synth)
