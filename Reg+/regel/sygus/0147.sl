(set-logic SLIA)

; Converted from upstream Regel benchmark deepregex/154.
; Grammar mirrors delis RegLan theory: char literals actually used + re.allchar + standard ops.

(define-fun w1 () String "AAabc")
(define-fun w2 () String "AB123")
(define-fun w3 () String "AC4f45")
(define-fun w4 () String "FGREDD23")
(define-fun w5 () String "GGabc")
(define-fun w6 () String "EEE1df2")
(define-fun w7 () String "RTa")
(define-fun w8 () String "Aa")
(define-fun w9 () String "Ebb")
(define-fun w10 () String "R123")
(define-fun w11 () String "123")
(define-fun w12 () String "fds")
(define-fun w13 () String "34bv")
(define-fun w14 () String "h78")

(synth-fun r () RegLan
    ((Start RegLan))
    (
        (Start RegLan
            (
                (str.to_re "1")
                (str.to_re "2")
                (str.to_re "3")
                (str.to_re "4")
                (str.to_re "5")
                (str.to_re "7")
                (str.to_re "8")
                (str.to_re "A")
                (str.to_re "B")
                (str.to_re "C")
                (str.to_re "D")
                (str.to_re "E")
                (str.to_re "F")
                (str.to_re "G")
                (str.to_re "R")
                (str.to_re "T")
                (str.to_re "a")
                (str.to_re "b")
                (str.to_re "c")
                (str.to_re "d")
                (str.to_re "f")
                (str.to_re "h")
                (str.to_re "s")
                (str.to_re "v")
                re.allchar
                (re.opt Start)
                (re.++ Start Start)
                (re.union Start Start)
                (re.inter Start Start)
                (re.* Start)
                (re.+ Start)
            )
        )
    )
)

(constraint (str.in_re w1 r))
(constraint (str.in_re w2 r))
(constraint (str.in_re w3 r))
(constraint (str.in_re w4 r))
(constraint (str.in_re w5 r))
(constraint (str.in_re w6 r))
(constraint (str.in_re w7 r))
(constraint (not (str.in_re w8 r)))
(constraint (not (str.in_re w9 r)))
(constraint (not (str.in_re w10 r)))
(constraint (not (str.in_re w11 r)))
(constraint (not (str.in_re w12 r)))
(constraint (not (str.in_re w13 r)))
(constraint (not (str.in_re w14 r)))

(check-synth)
