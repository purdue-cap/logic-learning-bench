(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/105) — gt=concat(and(<let>,<any>),contain(<num>))")
(set-info :description "items with a character and a letter preceding a numeral .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00927 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00218 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01395 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00552 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01094 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01290 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00597 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w01396 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00373 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00394 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01388 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00960 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01431 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00824 head tail))))

(check-synth)
