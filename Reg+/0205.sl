(synth-fun r () RegLan)

(constraint      (with-model w00034 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00035 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00036 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00037 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00038 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00039 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00040 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00041 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00042 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00044 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00045 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00046 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00007 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00033 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00047 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
