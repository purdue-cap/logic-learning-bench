(set-info :author "Chentian Wu")
(set-info :source "REGEL (stackoverflow/5) — gt=or(concat(<0>,<num1-9>),concat(<1>,or(<0>,or(<1>,<2>))))")
(set-info :description "What is the regular expression for validating a month with the leading zero?")

(require "./global/theories.stackoverflow.sl")
(require "./global/models.stackoverflow.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00034 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00035 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00036 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00037 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00038 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00039 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00040 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00041 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00042 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00044 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00045 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00046 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00007 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00033 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00047 head tail))))

(check-synth)
