(set-info :author "Chentian Wu")
(set-info :source "REGEL (stackoverflow/5) — gt=or(concat(<0>,<num1-9>),concat(<1>,or(<0>,or(<1>,<2>))))")
(set-info :description "What is the regular expression for validating a month with the leading zero?")

(require "./global/theories.numeric.sl")

; '01'
(define-model w00034
  (interp-sort Pos ($0 $1 $2))
  (interp-fun is.any (match ((($0) true) (($1) true) ((_) false))))
  (interp-fun is.x30 (match ((($0) true) ((_) false))))
  (interp-fun is.x31 (match ((($1) true) ((_) false))))
  (interp-fun is.x32 (match (((_) false))))
  (interp-fun is.x33 (match (((_) false))))
  (interp-fun is.x34 (match (((_) false))))
  (interp-fun is.x35 (match (((_) false))))
  (interp-fun is.x36 (match (((_) false))))
  (interp-fun is.x37 (match (((_) false))))
  (interp-fun is.x38 (match (((_) false))))
  (interp-fun is.x39 (match (((_) false))))
  (interp-fun is.range.x31.x39 (match ((($1) true) ((_) false))))
  (interp-fun succ (match ((($1 $0) true) (($2 $1) true) ((_ _) false))))
  (interp-fun leq (match ((($0 $0) true) (($0 $1) true) (($0 $2) true) (($1 $1) true) (($1 $2) true) (($2 $2) true) ((_ _) false))))
  (interp-fun head ($0))
  (interp-fun tail ($2))
)

