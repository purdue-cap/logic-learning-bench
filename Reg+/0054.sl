(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/54) — gt=concat(<let>,contain(<low>))")
(set-info :description "items with words containing a letter preceding a small letter .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00208 0 (size (Pos w00208)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00977 0 (size (Pos w00977)))))
(constraint      (RegLan.Sem r (RegLan.Asp w01403 0 (size (Pos w01403)))))
(constraint      (RegLan.Sem r (RegLan.Asp w01519 0 (size (Pos w01519)))))
(constraint      (RegLan.Sem r (RegLan.Asp w01480 0 (size (Pos w01480)))))
(constraint      (RegLan.Sem r (RegLan.Asp w01394 0 (size (Pos w01394)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00779 0 (size (Pos w00779)))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01191 0 (size (Pos w01191))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01279 0 (size (Pos w01279))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00856 0 (size (Pos w00856))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00984 0 (size (Pos w00984))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01335 0 (size (Pos w01335))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01273 0 (size (Pos w01273))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01447 0 (size (Pos w01447))))))

(check-synth)
