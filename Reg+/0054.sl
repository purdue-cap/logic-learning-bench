(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/54) — gt=concat(<let>,contain(<low>))")
(set-info :description "items with words containing a letter preceding a small letter .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00208 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00977 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01403 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01519 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01480 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01394 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00779 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w01191 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01279 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00856 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00984 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01335 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01273 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01447 head tail))))

(check-synth)
