(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/137) — gt=or(<num>,<any>)")
(set-info :description "words in lines that include a number or character")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00038 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00011 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00012 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00042 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00034 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00005 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00035 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00115 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00230 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00119 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00241 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00090 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00590 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00871 head tail))))

(check-synth)
