(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/118) — gt=concat(repeatatleast(startwith(<num>),1),contain(<m0>))")
(set-info :description "lines starting with a number before the string '!'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00415 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00885 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01026 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00886 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01274 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00692 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00887 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w01084 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00705 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00479 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00916 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00394 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00653 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00838 head tail))))

(check-synth)
