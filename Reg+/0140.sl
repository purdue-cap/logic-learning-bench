(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/146) — gt=concat(and(<vow>,<cap>),contain(<m0>))")
(set-info :description "items with an upper class and vowel preceding '!' .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00162 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00197 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00470 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00476 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00703 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00898 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00720 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00311 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00003 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00022 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00462 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00191 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00467 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00215 head tail))))

(check-synth)
