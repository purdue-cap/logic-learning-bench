(constraint      (with-model w00352 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00350 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00531 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00038 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00003 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00020 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00011 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00074 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00224 (RegLan.Sem r (RegLan.Asp head tail)))))
