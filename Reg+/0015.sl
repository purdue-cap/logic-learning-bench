(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/15) — gt=concat(or(or(<vow>,<m0>),<cap>),contain(<low>))")
(set-info :description "items with '!' , vowel , or an upper case letter preceding a small letter .")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00172 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00229 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00185 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00079 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00352 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00350 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00531 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00003 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00020 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00074 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00224 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00169 head tail))))

(check-synth)
