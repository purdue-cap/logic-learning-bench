(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/47) — gt=concat(concat(<low>,contain(<any>)),contain(<cap>))")
(set-info :description "lines which have a lower-case letter followed by a character before a capital letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00523 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00494 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00540 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00792 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00806 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00971 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00534 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00453 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00539 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00556 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00600 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00602 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00483 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00484 head tail))))

(check-synth)
