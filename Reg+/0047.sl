(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/47) — gt=concat(concat(<low>,contain(<any>)),contain(<cap>))")
(set-info :description "lines which have a lower-case letter followed by a character before a capital letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00523 0 (size (Pos w00523)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00494 0 (size (Pos w00494)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00540 0 (size (Pos w00540)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00792 0 (size (Pos w00792)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00806 0 (size (Pos w00806)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00971 0 (size (Pos w00971)))))
(constraint      (RegLan.Sem r (RegLan.Asp w00534 0 (size (Pos w00534)))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00453 0 (size (Pos w00453))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00539 0 (size (Pos w00539))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00556 0 (size (Pos w00556))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00600 0 (size (Pos w00600))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00602 0 (size (Pos w00602))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00483 0 (size (Pos w00483))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00484 0 (size (Pos w00484))))))

(check-synth)
