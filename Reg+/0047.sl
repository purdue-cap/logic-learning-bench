(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/47) — gt=concat(concat(<low>,contain(<any>)),contain(<cap>))")
(set-info :description "lines which have a lower-case letter followed by a character before a capital letter")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (with-model w00523 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00494 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00540 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00792 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00806 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00971 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint      (with-model w00534 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00453 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00539 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00556 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00600 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00602 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00483 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00484 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
