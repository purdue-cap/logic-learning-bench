(set-info :author "Chentian Wu")
(set-info :source "REGEL (stackoverflow/87) — gt=and(not(contain(concat(<0>,concat(<,>,star(<0>))))),concat(repeatatleast(<num>,1),optional(concat(<,>,repeatrange(<num>,1,3)))))")
(set-info :description "Decimal numbers up to 3 decimal places which are greater than zero")

(require "./global/theories.stackoverflow.sl")
(require "./global/models.stackoverflow.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00259 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00167 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00092 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00258 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00269 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00180 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00007 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00364 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00363 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00365 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00006 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00090 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00165 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00257 head tail))))

(check-synth)
