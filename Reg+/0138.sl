(constraint      (RegLan.Sem r (RegLan.Asp w00115 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00121 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00271 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00096 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01284 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00038 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00004 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00003 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00029 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00019 head tail))))

