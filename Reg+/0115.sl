(set-info :author "Chentian Wu")
(set-info :source "REGEL (deepregex/120) — gt=concat(or(or(<m0>,<m1>),<cap>),contain(<m2>))")
(set-info :description "lines with either the string '!' , the string '@' , or a capital letter followed by the string '#'")

(require "./global/theories.deepregex.sl")
(require "./global/models.deepregex.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w00066 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00150 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00163 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00066 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00177 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00189 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w00193 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00003 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00004 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00250 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00019 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00116 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00129 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00111 head tail))))

(check-synth)
