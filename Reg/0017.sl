(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no17_atleastone0_atmostone1")
(set-info :description "w contains at least one 0 and at most one 1")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w001 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w0001 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w0010 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w01000 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w100000 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w1 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w101 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0110 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1001 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w10001 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w111000 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w010000100 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w000101001 head tail))))

(check-synth)
