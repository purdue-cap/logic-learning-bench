(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no17_atleastone0_atmostone1")
(set-info :description "w contains at least one 0 and at most one 1")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (with-model w0 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w001 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w0001 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w0010 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w01000 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w100000 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w1 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w101 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w0110 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w1010 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w1001 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w10001 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w111000 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w010000100 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w000101001 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
