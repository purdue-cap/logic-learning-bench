(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no24_00_before_11")
(set-info :description "The set of all strings of 0s and 1s such that every pair of adjacent 0s appears before any pair of adjacent 1s.")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 0 (size (Pos w0)))))
(constraint (RegLan.Sem r (RegLan.Asp w1 0 (size (Pos w1)))))
(constraint (RegLan.Sem r (RegLan.Asp w01 0 (size (Pos w01)))))
(constraint (RegLan.Sem r (RegLan.Asp w010 0 (size (Pos w010)))))
(constraint (RegLan.Sem r (RegLan.Asp w0101 0 (size (Pos w0101)))))
(constraint (RegLan.Sem r (RegLan.Asp w1010 0 (size (Pos w1010)))))
(constraint (RegLan.Sem r (RegLan.Asp w00111 0 (size (Pos w00111)))))
(constraint (RegLan.Sem r (RegLan.Asp w001100111 0 (size (Pos w001100111)))))
(constraint (RegLan.Sem r (RegLan.Asp w100110011 0 (size (Pos w100110011)))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00 0 (size (Pos w00))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w100 0 (size (Pos w100))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w001 0 (size (Pos w001))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0010 0 (size (Pos w0010))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1001 0 (size (Pos w1001))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11001 0 (size (Pos w11001))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00101 0 (size (Pos w00101))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w001100 0 (size (Pos w001100))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1001011 0 (size (Pos w1001011))))))

(check-synth)
