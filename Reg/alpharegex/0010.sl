(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no10_alternating")
(set-info :description "alternating 0 and 1")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 0 (size (Pos w0)))))
(constraint (RegLan.Sem r (RegLan.Asp w1 0 (size (Pos w1)))))
(constraint (RegLan.Sem r (RegLan.Asp w01 0 (size (Pos w01)))))
(constraint (RegLan.Sem r (RegLan.Asp w10 0 (size (Pos w10)))))
(constraint (RegLan.Sem r (RegLan.Asp w101 0 (size (Pos w101)))))
(constraint (RegLan.Sem r (RegLan.Asp w010 0 (size (Pos w010)))))
(constraint (RegLan.Sem r (RegLan.Asp w1010 0 (size (Pos w1010)))))
(constraint (RegLan.Sem r (RegLan.Asp w0101 0 (size (Pos w0101)))))
(constraint (RegLan.Sem r (RegLan.Asp w10101 0 (size (Pos w10101)))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00 0 (size (Pos w00))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11 0 (size (Pos w11))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w011 0 (size (Pos w011))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w001 0 (size (Pos w001))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w110 0 (size (Pos w110))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1001 0 (size (Pos w1001))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w101101 0 (size (Pos w101101))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w010010 0 (size (Pos w010010))))))

(check-synth)
