(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no7_zeros_divisible_by_3")
(set-info :description "zeros divisible by 3")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w00 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w000 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w111 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w111111 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w10101 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w1001001 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w100100110010010 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w11 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w101 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w110 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1111 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11111 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1111111 head tail))))

(check-synth)
