(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no7_zeros_divisible_by_3")
(set-info :description "zeros divisible by 3")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 0 (size (Pos w0)))))
(constraint (RegLan.Sem r (RegLan.Asp w00 0 (size (Pos w00)))))
(constraint (RegLan.Sem r (RegLan.Asp w000 0 (size (Pos w000)))))
(constraint (RegLan.Sem r (RegLan.Asp w111 0 (size (Pos w111)))))
(constraint (RegLan.Sem r (RegLan.Asp w111111 0 (size (Pos w111111)))))
(constraint (RegLan.Sem r (RegLan.Asp w10101 0 (size (Pos w10101)))))
(constraint (RegLan.Sem r (RegLan.Asp w1001001 0 (size (Pos w1001001)))))
(constraint (RegLan.Sem r (RegLan.Asp w100100110010010 0 (size (Pos w100100110010010)))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11 0 (size (Pos w11))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w011 0 (size (Pos w011))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w101 0 (size (Pos w101))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w110 0 (size (Pos w110))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1111 0 (size (Pos w1111))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11111 0 (size (Pos w11111))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1111111 0 (size (Pos w1111111))))))

(check-synth)
