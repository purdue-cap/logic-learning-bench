(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no7_zeros_divisible_by_3")
(set-info :description "zeros divisible by 3")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (with-model w0 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w00 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w000 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w111 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w111111 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w10101 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w1001001 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w100100110010010 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w11 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w011 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w101 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w110 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w1111 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w11111 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w1111111 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
