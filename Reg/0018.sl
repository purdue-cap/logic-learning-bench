(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no18_0110")
(set-info :description "There are at least two occurences of 1 between any two occurrences of 0.")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w0110 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w01110 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w011110 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w111 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w01111 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w1111110 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w10101 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w010111 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w111010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0011111 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1111100 head tail))))

(check-synth)
