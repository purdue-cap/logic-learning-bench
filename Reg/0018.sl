(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no18_0110")
(set-info :description "There are at least two occurences of 1 between any two occurrences of 0.")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (with-model w0 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w0110 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w01110 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w011110 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w111 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w01111 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w1111110 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w010 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w10101 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w010111 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w111010 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w0011111 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w1111100 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
