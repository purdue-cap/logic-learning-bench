(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no20_odd_pos_is_1")
(set-info :description "every odd position of w is 1.")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (with-model w0 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w0_ (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w0_0 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w0_0_ (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w0_0_0 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w0_0_0_ (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w1 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w1? (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w??1 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w1??? (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w??1? (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w1???? (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w??1?? (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w????1 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w????1? (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
