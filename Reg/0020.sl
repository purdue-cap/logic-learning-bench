(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no20_odd_pos_is_1")
(set-info :description "every odd position of w is 1.")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w0_ head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w0_0 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w0_0_ head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w0_0_0 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w0_0_0_ head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w1 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1? head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w??1 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1??? head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w??1? head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1???? head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w??1?? head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w????1 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w????1? head tail))))

(check-synth)
