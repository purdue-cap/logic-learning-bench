(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no10_alternating")
(set-info :description "alternating 0 and 1")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (with-model w0 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w1 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w01 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w10 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w101 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w010 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w1010 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w0101 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w10101 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w11 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w011 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w001 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w110 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w1001 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w101101 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w010010 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
