(set-info :author "Chentian Wu")
(set-info :source "Sipser, Introduction to the Theory of Computation (3e), Ex 1.53#9")
(set-info :description "(0|ε)1*")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w0 0 (size (Pos w0)))))
(constraint      (RegLan.Sem r (RegLan.Asp w1 0 (size (Pos w1)))))
(constraint      (RegLan.Sem r (RegLan.Asp w01 0 (size (Pos w01)))))
(constraint      (RegLan.Sem r (RegLan.Asp w11 0 (size (Pos w11)))))
(constraint      (RegLan.Sem r (RegLan.Asp w011 0 (size (Pos w011)))))
(constraint      (RegLan.Sem r (RegLan.Asp w111 0 (size (Pos w111)))))
(constraint      (RegLan.Sem r (RegLan.Asp w0111 0 (size (Pos w0111)))))
(constraint      (RegLan.Sem r (RegLan.Asp w1111 0 (size (Pos w1111)))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00 0 (size (Pos w00))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w10 0 (size (Pos w10))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w000 0 (size (Pos w000))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w001 0 (size (Pos w001))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w010 0 (size (Pos w010))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w100 0 (size (Pos w100))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w101 0 (size (Pos w101))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w110 0 (size (Pos w110))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0000 0 (size (Pos w0000))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0001 0 (size (Pos w0001))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0010 0 (size (Pos w0010))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0011 0 (size (Pos w0011))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0100 0 (size (Pos w0100))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0101 0 (size (Pos w0101))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0110 0 (size (Pos w0110))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1000 0 (size (Pos w1000))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1001 0 (size (Pos w1001))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1010 0 (size (Pos w1010))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1011 0 (size (Pos w1011))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1100 0 (size (Pos w1100))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1101 0 (size (Pos w1101))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1110 0 (size (Pos w1110))))))

(check-synth)