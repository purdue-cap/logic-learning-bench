(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no13_atmost_2zeros")
(set-info :description "The set of all strings at most two zeros")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 0 (size (Pos w0)))))
(constraint (RegLan.Sem r (RegLan.Asp w1 0 (size (Pos w1)))))
(constraint (RegLan.Sem r (RegLan.Asp w00 0 (size (Pos w00)))))
(constraint (RegLan.Sem r (RegLan.Asp w11 0 (size (Pos w11)))))
(constraint (RegLan.Sem r (RegLan.Asp w10101 0 (size (Pos w10101)))))
(constraint (RegLan.Sem r (RegLan.Asp w11011011 0 (size (Pos w11011011)))))
(constraint (RegLan.Sem r (RegLan.Asp w111 0 (size (Pos w111)))))
(constraint (RegLan.Sem r (RegLan.Asp w1111 0 (size (Pos w1111)))))
(constraint (not (RegLan.Sem r (RegLan.Asp w000 0 (size (Pos w000))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11011010 0 (size (Pos w11011010))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11000 0 (size (Pos w11000))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 0 (size (Pos w00011))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11010101 0 (size (Pos w11010101))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0000 0 (size (Pos w0000))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w101010101 0 (size (Pos w101010101))))))

(check-synth)
