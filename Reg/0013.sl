(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no13_atmost_2zeros")
(set-info :description "The set of all strings at most two zeros")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (with-model w0 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w1 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w00 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w11 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w10101 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w11011011 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w111 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w1111 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w000 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w11011010 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w11000 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00011 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w11010101 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w0000 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w101010101 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
