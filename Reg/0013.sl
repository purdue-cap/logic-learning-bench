(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no13_atmost_2zeros")
(set-info :description "The set of all strings at most two zeros")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w1 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w00 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w11 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w10101 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w11011011 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w111 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w1111 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w000 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11011010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11000 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11010101 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0000 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w101010101 head tail))))

(check-synth)
