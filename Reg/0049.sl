(set-info :author "Chentian Wu")
(set-info :source "Sipser, Introduction to the Theory of Computation (3e), Σ*1")
(set-info :description "ends with 1")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w1 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w01 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w11 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w001 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w011 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w101 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w111 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w0001 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w0011 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w0101 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w0111 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w1001 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w1011 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w1101 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w1111 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w0 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w10 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w000 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w100 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w110 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0000 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0100 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0110 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1000 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1100 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1110 head tail))))

(check-synth)