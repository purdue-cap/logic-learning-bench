(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no8_even_zeros")
(set-info :description "even number of zeros")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w11 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w01010 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w00100100 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w1111 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w010101010 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w00100100100100 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w1 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w10 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w100 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w111 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0101010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11111 head tail))))

(check-synth)
