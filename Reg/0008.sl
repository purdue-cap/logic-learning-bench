(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no8_even_zeros")
(set-info :description "even number of zeros")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (with-model w0 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w11 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w01010 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w00100100 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w1111 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w010101010 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w00100100100100 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w1 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w10 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w100 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w111 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w0101010 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w11111 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
