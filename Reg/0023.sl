(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no23_even_0s_and_followed_by_atleast_one_1")
(set-info :description "w has an even number of 0's and each 0 is followed by at least one 1.")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w000 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w1010 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w01010 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w1000100 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w10010010001000 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w1 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1111 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w101 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0101 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w001 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w01110 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w10 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w110 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w100 head tail))))

(check-synth)
