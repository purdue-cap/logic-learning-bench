(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no23_even_0s_and_followed_by_atleast_one_1")
(set-info :description "w has an even number of 0's and each 0 is followed by at least one 1.")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (with-model w0 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w000 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w1010 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w01010 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w1000100 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w10010010001000 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w1 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w1111 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w101 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w0101 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w001 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w01110 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w10 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w110 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w100 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
