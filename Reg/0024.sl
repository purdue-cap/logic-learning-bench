(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no24_00_before_11")
(set-info :description "The set of all strings of 0s and 1s such that every pair of adjacent 0s appears before any pair of adjacent 1s.")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (with-model w0 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w1 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w01 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w010 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w0101 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w1010 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w00111 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w001100111 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w100110011 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w00 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w100 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w001 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w0010 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w1001 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w11001 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w00101 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w001100 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w1001011 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
