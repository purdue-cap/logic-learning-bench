(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no24_00_before_11")
(set-info :description "The set of all strings of 0s and 1s such that every pair of adjacent 0s appears before any pair of adjacent 1s.")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w1 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w01 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w010 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w0101 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w1010 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w00111 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w001100111 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w100110011 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w00 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w100 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w001 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w0010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1001 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11001 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00101 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w001100 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1001011 head tail))))

(check-synth)
