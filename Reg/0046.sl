(set-info :author "Chentian Wu")
(set-info :source "Sipser, Introduction to the Theory of Computation (3e), Ex 1.53#7")
(set-info :description "exactly {01, 10}")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint      (RegLan.Sem r (RegLan.Asp w01 head tail)))
(constraint      (RegLan.Sem r (RegLan.Asp w10 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w0 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w00 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w000 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w001 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w010 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w011 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w100 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w101 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w110 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w111 head tail))))

(check-synth)