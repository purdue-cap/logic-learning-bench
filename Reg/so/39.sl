(require "theories/39.sl")
(require "models/39.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (ReAsp so_39_P1 0 (size (Pos so_39_P1)))))
(constraint (RegLan.Sem r (ReAsp so_39_P2 0 (size (Pos so_39_P2)))))
(constraint (RegLan.Sem r (ReAsp so_39_P3 0 (size (Pos so_39_P3)))))
(constraint (RegLan.Sem r (ReAsp so_39_P4 0 (size (Pos so_39_P4)))))
(constraint (RegLan.Sem r (ReAsp so_39_P5 0 (size (Pos so_39_P5)))))
(constraint (RegLan.Sem r (ReAsp so_39_P6 0 (size (Pos so_39_P6)))))
(constraint (RegLan.Sem r (ReAsp so_39_P7 0 (size (Pos so_39_P7)))))
(constraint (RegLan.Sem r (ReAsp so_39_P8 0 (size (Pos so_39_P8)))))
(constraint (RegLan.Sem r (ReAsp so_39_P9 0 (size (Pos so_39_P9)))))
(constraint (not (RegLan.Sem r (ReAsp so_39_N1 0 (size (Pos so_39_N1))))))
(constraint (not (RegLan.Sem r (ReAsp so_39_N2 0 (size (Pos so_39_N2))))))
(constraint (not (RegLan.Sem r (ReAsp so_39_N3 0 (size (Pos so_39_N3))))))
(constraint (not (RegLan.Sem r (ReAsp so_39_N4 0 (size (Pos so_39_N4))))))
(constraint (not (RegLan.Sem r (ReAsp so_39_N5 0 (size (Pos so_39_N5))))))
(constraint (not (RegLan.Sem r (ReAsp so_39_N6 0 (size (Pos so_39_N6))))))

(check-synth)
