(require "theories/5.sl")
(require "models/5.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (ReAsp so_5_P1 0 (size (Pos so_5_P1)))))
(constraint (RegLan.Sem r (ReAsp so_5_P2 0 (size (Pos so_5_P2)))))
(constraint (RegLan.Sem r (ReAsp so_5_P3 0 (size (Pos so_5_P3)))))
(constraint (RegLan.Sem r (ReAsp so_5_P4 0 (size (Pos so_5_P4)))))
(constraint (RegLan.Sem r (ReAsp so_5_P5 0 (size (Pos so_5_P5)))))
(constraint (RegLan.Sem r (ReAsp so_5_P6 0 (size (Pos so_5_P6)))))
(constraint (RegLan.Sem r (ReAsp so_5_P7 0 (size (Pos so_5_P7)))))
(constraint (RegLan.Sem r (ReAsp so_5_P8 0 (size (Pos so_5_P8)))))
(constraint (RegLan.Sem r (ReAsp so_5_P9 0 (size (Pos so_5_P9)))))
(constraint (RegLan.Sem r (ReAsp so_5_P10 0 (size (Pos so_5_P10)))))
(constraint (RegLan.Sem r (ReAsp so_5_P11 0 (size (Pos so_5_P11)))))
(constraint (RegLan.Sem r (ReAsp so_5_P12 0 (size (Pos so_5_P12)))))
(constraint (not (RegLan.Sem r (ReAsp so_5_N1 0 (size (Pos so_5_N1))))))
(constraint (not (RegLan.Sem r (ReAsp so_5_N2 0 (size (Pos so_5_N2))))))
(constraint (not (RegLan.Sem r (ReAsp so_5_N3 0 (size (Pos so_5_N3))))))

(check-synth)
