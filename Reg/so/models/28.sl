    (($5) true)
    (($6) true)
    (($7) true)
    (($8) true)
    (($9) true)
    (($10) true)
    (($11) true)
    (($12) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    (($1) true)
    (($2) true)
    (($3) true)
    (($5) true)
    (($7) true)
    ((_) false)
  )))
  (interp-fun is.lower (match (
    (($10) true)
    (($11) true)
    (($12) true)
    ((_) false)
  )))
  (interp-fun is.upper (match (
    (($0) true)
    (($4) true)
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($0) true)
    (($4) true)
    (($10) true)
    (($11) true)
    (($12) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($0) true)
    (($1) true)
    (($2) true)
    (($3) true)
    (($4) true)
    (($5) true)
    (($7) true)
    (($10) true)
    (($11) true)
    (($12) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($0) true)
    (($1) true)
    (($2) true)
    (($3) true)
    (($4) true)
    (($5) true)
    (($6) true)
    (($7) true)
    (($8) true)
    (($10) true)
    (($11) true)
    (($12) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($0) true)
    (($1) true)
    (($2) true)
    (($3) true)
    (($4) true)
    (($5) true)
    (($7) true)
    (($10) true)
    (($12) true)
    ((_) false)
  )))
  (interp-fun is.x2E (match (
    (($9) true)
    ((_) false)
  )))
)

