    (($10) true)
    ((_) false)
  )))
  (interp-fun is.upper (match (
    (($0) true)
    (($6) true)
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($0) true)
    (($1) true)
    (($2) true)
    (($3) true)
    (($4) true)
    (($6) true)
    (($7) true)
    (($8) true)
    (($9) true)
    (($10) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($0) true)
    (($1) true)
    (($2) true)
    (($3) true)
    (($4) true)
    (($6) true)
    (($7) true)
    (($8) true)
    (($9) true)
    (($10) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($0) true)
    (($1) true)
    (($2) true)
    (($3) true)
    (($4) true)
    (($6) true)
    (($7) true)
    (($8) true)
    (($9) true)
    (($10) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    (($5) true)
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($9) true)
    ((_) false)
  )))
  (interp-fun is.x20 (match (
    (($5) true)
    ((_) false)
  )))
)

