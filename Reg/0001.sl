(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no1_start_with_0")
(set-info :description "w starts with 0")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w01 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w00 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w011 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w000 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w010 head tail)))
(constraint (RegLan.Sem r (RegLan.Asp w001 head tail)))
(constraint (not (RegLan.Sem r (RegLan.Asp w1 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w10 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w111 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w100 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w110 head tail))))
(constraint (not (RegLan.Sem r (RegLan.Asp w101 head tail))))

(check-synth)
