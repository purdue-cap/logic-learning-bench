(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no1_start_with_0")
(set-info :description "w starts with 0")

(require "./global/theories.alpharegex.sl")
(require "./global/models.alpharegex.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (RegLan.Asp w0 0 (size (Pos w0)))))
(constraint (RegLan.Sem r (RegLan.Asp w01 0 (size (Pos w01)))))
(constraint (RegLan.Sem r (RegLan.Asp w00 0 (size (Pos w00)))))
(constraint (RegLan.Sem r (RegLan.Asp w011 0 (size (Pos w011)))))
(constraint (RegLan.Sem r (RegLan.Asp w000 0 (size (Pos w000)))))
(constraint (RegLan.Sem r (RegLan.Asp w010 0 (size (Pos w010)))))
(constraint (RegLan.Sem r (RegLan.Asp w001 0 (size (Pos w001)))))
(constraint (not (RegLan.Sem r (RegLan.Asp w1 0 (size (Pos w1))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w11 0 (size (Pos w11))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w10 0 (size (Pos w10))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w111 0 (size (Pos w111))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w100 0 (size (Pos w100))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w110 0 (size (Pos w110))))))
(constraint (not (RegLan.Sem r (RegLan.Asp w101 0 (size (Pos w101))))))

(check-synth)
