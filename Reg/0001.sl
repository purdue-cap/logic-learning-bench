(set-info :author "Chentian Wu")
(set-info :source "AlphaRegex (Lee, So, Oh, GPCE 2016) — no1_start_with_0")
(set-info :description "w starts with 0")

(require "./global/theories.sl")
(require "./global/models.sl")

(synth-fun r () RegLan)

(constraint (with-model w0 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w01 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w00 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w011 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w000 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w010 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (with-model w001 (RegLan.Sem r (RegLan.Asp head tail))))
(constraint (not (with-model w1 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w11 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w10 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w111 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w100 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w110 (RegLan.Sem r (RegLan.Asp head tail)))))
(constraint (not (with-model w101 (RegLan.Sem r (RegLan.Asp head tail)))))

(check-synth)
