  )))
  (interp-fun p3 (match (
    (($3) true)
    (($4) true)
    ((_) false)
  )))
  (interp-fun next (match (
    (($0) $1)
    (($1) $2)
    (($2) $3)
    (($3) $4)
    (($4) $1)
  )))
  (interp-fun future (match (
    (($0 $0) true)
    (($0 $1) true)
    (($0 $2) true)
    (($0 $3) true)
    (($0 $4) true)
    (($1 $1) true)
    (($1 $2) true)
