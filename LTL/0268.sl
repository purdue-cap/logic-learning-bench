    (($2 $1) true)
    (($2 $2) true)
    (($2 $3) true)
    (($2 $4) true)
    (($3 $1) true)
    (($3 $2) true)
    (($3 $3) true)
    (($3 $4) true)
    (($4 $1) true)
    (($4 $2) true)
    (($4 $3) true)
    (($4 $4) true)
    ((_ _) false)
  )))
  (interp-fun prefix (match (
    (($0 $1 $0) true)
    (($0 $2 $0) true)
    (($0 $2 $1) true)
    (($0 $3 $0) true)
    (($0 $3 $1) true)
    (($0 $3 $2) true)
    (($0 $4 $0) true)
    (($0 $4 $1) true)
    (($0 $4 $2) true)
    (($0 $4 $3) true)
    (($1 $2 $1) true)
    (($1 $3 $1) true)
    (($1 $3 $2) true)
    (($1 $4 $1) true)
    (($1 $4 $2) true)
    (($1 $4 $3) true)
    (($2 $1 $2) true)
    (($2 $1 $3) true)
    (($2 $1 $4) true)
    (($2 $3 $2) true)
    (($2 $4 $2) true)
    (($2 $4 $3) true)
    (($3 $1 $3) true)
    (($3 $1 $4) true)
    (($3 $2 $1) true)
    (($3 $2 $3) true)
    (($3 $2 $4) true)
    (($3 $4 $3) true)
    (($4 $1 $4) true)
    (($4 $2 $1) true)
    (($4 $2 $4) true)
    (($4 $3 $1) true)
    (($4 $3 $2) true)
    (($4 $3 $4) true)
    ((_ _ _) false)
  )))
)

(synth-fun phi () LTL)

(constraint (LTL.Sem phi (LTL.Asp P0 $0)))
(constraint (LTL.Sem phi (LTL.Asp P1 $0)))
(constraint (LTL.Sem phi (LTL.Asp P2 $0)))
(constraint (LTL.Sem phi (LTL.Asp P3 $0)))
(constraint (LTL.Sem phi (LTL.Asp P4 $0)))
(constraint (not (LTL.Sem phi (LTL.Asp N0 $0))))
(constraint (not (LTL.Sem phi (LTL.Asp N1 $0))))
(constraint (not (LTL.Sem phi (LTL.Asp N2 $0))))
(constraint (not (LTL.Sem phi (LTL.Asp N3 $0))))
(constraint (not (LTL.Sem phi (LTL.Asp N4 $0))))

(check-synth)
