    (($3 $4) true)
    (($4 $1) true)
    (($4 $2) true)
    (($4 $3) true)
    (($4 $4) true)
    ((_ _) false)
  )))
  (interp-fun prefix (match (
    (($0 $1 $0) true)
    (($0 $2 $0) true)
    (($0 $2 $1) true)
    (($0 $3 $0) true)
    (($0 $3 $1) true)
    (($0 $3 $2) true)
    (($0 $4 $0) true)
    (($0 $4 $1) true)
