(require "theories/ltl-lasso-2.sl")
;; operators: G, F, !, U, &, |, ->, X
;; depth: 1
;; expected: G(x0)

(define-model P0
  (define-univ Pos ($0 $1 $2 $3 $4))
  (interp-fun p0 (match (
    (($0) true)
    (($1) true)
    (($2) true)
    (($3) true)
    (($4) true)
    ((_) false)
  )))
  (interp-fun p1 (match (
    (($0) true)
    (($2) true)
    (($3) true)
    (($4) true)
    ((_) false)
  )))
  (interp-fun next (match (
    (($0) $1)
    (($1) $2)
    (($2) $3)
    (($3) $4)
    (($4) $0)
  )))
  (interp-fun future (match (
    (($0 $0) true)
    (($0 $1) true)
    (($0 $2) true)
    (($0 $3) true)
    (($0 $4) true)
    (($1 $1) true)
    (($1 $2) true)
    (($1 $3) true)
    (($1 $4) true)
    (($1 $0) true)
    (($2 $2) true)
    (($2 $3) true)
    (($2 $4) true)
    (($2 $0) true)
    (($2 $1) true)
    (($3 $3) true)
    (($3 $4) true)
    (($3 $0) true)
    (($3 $1) true)
    (($3 $2) true)
    (($4 $4) true)
    (($4 $0) true)
    (($4 $1) true)
    (($4 $2) true)
    (($4 $3) true)
    ((_ _) false)
  )))
  (interp-fun prefix (match (
    (($0 $1 $0) true)
    (($0 $2 $0) true)
    (($0 $2 $1) true)
    (($0 $3 $0) true)
    (($0 $3 $1) true)
    (($0 $3 $2) true)
    (($0 $4 $0) true)
    (($0 $4 $1) true)
    (($0 $4 $2) true)
    (($0 $4 $3) true)
    (($1 $2 $1) true)
    (($1 $3 $1) true)
    (($1 $3 $2) true)
    (($1 $4 $1) true)
    (($1 $4 $2) true)
    (($1 $4 $3) true)
    (($1 $0 $1) true)
    (($1 $0 $2) true)
    (($1 $0 $3) true)
    (($1 $0 $4) true)
    (($2 $3 $2) true)
    (($2 $4 $2) true)
    (($2 $4 $3) true)
    (($2 $0 $2) true)
    (($2 $0 $3) true)
    (($2 $0 $4) true)
    (($2 $1 $2) true)
    (($2 $1 $3) true)
    (($2 $1 $4) true)
    (($2 $1 $0) true)
    (($3 $4 $3) true)
    (($3 $0 $3) true)
    (($3 $0 $4) true)
    (($3 $1 $3) true)
    (($3 $1 $4) true)
    (($3 $1 $0) true)
    (($3 $2 $3) true)
    (($3 $2 $4) true)
    (($3 $2 $0) true)
    (($3 $2 $1) true)
    (($4 $0 $4) true)
    (($4 $1 $4) true)
    (($4 $1 $0) true)
    (($4 $2 $4) true)
    (($4 $2 $0) true)
    (($4 $2 $1) true)
    (($4 $3 $4) true)
    (($4 $3 $0) true)
    (($4 $3 $1) true)
    (($4 $3 $2) true)
    ((_ _ _) false)
  )))
)

