(define-model P0
  (define-univ Pos ($0 $1 $2 $3 $4))
  (interp-fun p0 (match (
    (($0) true)
    (($1) true)
    (($3) true)
    (($4) true)
    ((_) false)
  )))
  (interp-fun p1 (match (
    (($0) true)
    (($2) true)
    (($3) true)
    ((_) false)
  )))
  (interp-fun p2 (match (
    (($1) true)
    (($2) true)
    (($3) true)
    ((_) false)
  )))
  (interp-fun next (match (
    (($0) $1)
    (($1) $2)
    (($2) $3)
    (($3) $4)
    (($4) $2)
  )))
  (interp-fun future (match (
    (($0 $0) true)
    (($0 $1) true)
    (($0 $2) true)
    (($0 $3) true)
    (($0 $4) true)
    (($1 $1) true)
    (($1 $2) true)
    (($1 $3) true)
    (($1 $4) true)
    (($2 $2) true)
    (($2 $3) true)
    (($2 $4) true)
    (($3 $2) true)
    (($3 $3) true)
    (($3 $4) true)
    (($4 $2) true)
    (($4 $3) true)
    (($4 $4) true)
    ((_ _) false)
  )))
  (interp-fun prefix (match (
    (($0 $1 $0) true)
    (($0 $2 $0) true)
    (($0 $2 $1) true)
    (($0 $3 $0) true)
    (($0 $3 $1) true)
    (($0 $3 $2) true)
    (($0 $4 $0) true)
    (($0 $4 $1) true)
    (($0 $4 $2) true)
    (($0 $4 $3) true)
    (($1 $2 $1) true)
    (($1 $3 $1) true)
    (($1 $3 $2) true)
    (($1 $4 $1) true)
    (($1 $4 $2) true)
    (($1 $4 $3) true)
