(define-model P0
  (define-univ Pos ($0 $1 $2 $3 $4))
  (interp-fun p0 (match (
    (($2) true)
    (($3) true)
    ((_) false)
  )))
  (interp-fun p1 (match (
    ((_) false)
  )))
  (interp-fun p2 (match (
