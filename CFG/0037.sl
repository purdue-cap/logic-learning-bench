(constraint      (CFG.Sem g (CFG.Asp w_p_aaaba 0 (size (Pos w_p_aaaba)) reset.S0)))
(constraint (not (CFG.Sem g (CFG.Asp w_n_b 0 (size (Pos w_n_b)) reset.S0))))
