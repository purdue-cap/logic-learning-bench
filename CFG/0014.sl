(synth-fun g () CFG)

(constraint      (CFG.Sem g (CFG.Asp w_p_aab 0 (size (Pos w_p_aab)) reset.S0)))
(constraint      (CFG.Sem g (CFG.Asp w_p_aba 0 (size (Pos w_p_aba)) reset.S0)))
(constraint      (CFG.Sem g (CFG.Asp w_p_baa 0 (size (Pos w_p_baa)) reset.S0)))
