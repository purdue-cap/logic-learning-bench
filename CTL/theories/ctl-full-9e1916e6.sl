(provide U Ctr CTL CTL.Asp CTL.Sem initial R bound next.depth c m t dead ap.c ap.m ap.t ap.dead ctl.top ctl.not ctl.AX ctl.EX ctl.AF ctl.EF ctl.AG ctl.EG ctl.and ctl.or ctl.AU ctl.EU czero cbot)


(declare-sort U 0)
(declare-sort Ctr 0)
(declare-fun c (U) Bool)
(declare-fun m (U) Bool)
(declare-fun t (U) Bool)
(declare-fun dead (U) Bool)
(declare-fun R (U U) Bool)
(declare-fun bound (U) Ctr)
(declare-fun next.depth (U Ctr) Ctr)
(declare-fun initial () U)
(declare-fun czero () Ctr)
(declare-fun cbot () Ctr)

(declare-term-types
 ((CTL 0))
 (((ap.c)
   (ap.m)
   (ap.t)
   (ap.dead)
   (ctl.top)
   (ctl.not CTL)
   (ctl.AX CTL)
   (ctl.EX CTL)
   (ctl.AF CTL)
   (ctl.EF CTL)
   (ctl.AG CTL)
   (ctl.EG CTL)
   (ctl.and CTL CTL)
   (ctl.or CTL CTL)
   (ctl.AU CTL CTL)
   (ctl.EU CTL CTL)
  )))

; Canonical Boolean algebraic axioms for pruning.
(declare-axiom (= (ctl.and x y) (ctl.and y x)))
(declare-axiom (= (ctl.and (ctl.and x y) z) (ctl.and x (ctl.and y z))))
(declare-axiom (= (ctl.and x x) x))
(declare-axiom (= (ctl.or x y) (ctl.or y x)))
(declare-axiom (= (ctl.or (ctl.or x y) z) (ctl.or x (ctl.or y z))))
(declare-axiom (= (ctl.or x x) x))


(define-aspects CTL.Asp
  (record (model Model) (state U) (depth Ctr)))

(define-semantics
  ((CTL.Sem (phi CTL) (asp CTL.Asp)))
  ((match phi
     ((ap.c) (c (state asp)))
     ((ap.m) (m (state asp)))
     ((ap.t) (t (state asp)))
     ((ap.dead) (dead (state asp)))
     ((ctl.top) true)
     ((ctl.not x) (not (CTL.Sem x asp)))
     ((ctl.and x y) (and (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.or x y) (or (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.AX x)
      (forall ((next (univ (U (model asp)))))
        (or (not (R (state asp) next))
            (CTL.Sem x (CTL.Asp (model asp) next (depth asp))))))
     ((ctl.EX x)
      (exists ((next (univ (U (model asp)))))
        (and (R (state asp) next)
             (CTL.Sem x (CTL.Asp (model asp) next (depth asp))))))
     ((ctl.AF x)
      (or (CTL.Sem x asp)
          (and (not (= (depth asp) czero))
               (not (= (depth asp) cbot))
               (forall ((next (univ (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.EF x)
      (or (CTL.Sem x asp)
          (and (not (= (depth asp) czero))
               (not (= (depth asp) cbot))
               (exists ((next (univ (U (model asp)))))
                 (and (R (state asp) next)
                      (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.AG x)
      (and (CTL.Sem x asp)
           (or (= (depth asp) czero)
               (= (depth asp) cbot)
               (forall ((next (univ (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.EG x)
      (and (CTL.Sem x asp)
           (or (= (depth asp) czero)
               (= (depth asp) cbot)
               (exists ((next (univ (U (model asp)))))
                 (and (R (state asp) next)
                      (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.AU x y)
      (or (CTL.Sem y asp)
          (and (not (= (depth asp) czero))
               (not (= (depth asp) cbot))
               (CTL.Sem x asp)
               (forall ((next (univ (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.EU x y)
      (or (CTL.Sem y asp)
          (and (not (= (depth asp) czero))
               (not (= (depth asp) cbot))
               (CTL.Sem x asp)
               (exists ((next (univ (U (model asp)))))
                 (and (R (state asp) next)
                      (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp))))))))))))
