(provide U Ctr CTL CTL.Asp CTL.Sem initial R bound next.depth a b c d ap.a ap.b ap.c ap.d nap.a nap.b nap.c nap.d ctl.top ctl.EX ctl.EG ctl.or ctl.EU czero cbot)


(declare-sort U 0)
(declare-sort Ctr 0)
(declare-fun a (U) Bool)
(declare-fun b (U) Bool)
(declare-fun c (U) Bool)
(declare-fun d (U) Bool)
(declare-fun R (U U) Bool)
(declare-fun bound (U) Ctr)
(declare-fun next.depth (U Ctr) Ctr)
(declare-fun initial () U)
(declare-fun czero () Ctr)
(declare-fun cbot () Ctr)

(declare-term-types
 ((CTL 0))
 (((ap.a)
   (nap.a)
   (ap.b)
   (nap.b)
   (ap.c)
   (nap.c)
   (ap.d)
   (nap.d)
   (ctl.top)
   (ctl.EX CTL)
   (ctl.EG CTL)
   (ctl.or CTL CTL)
   (ctl.EU CTL CTL)
  )))

; Canonical Boolean algebraic axioms for pruning.
(declare-axiom (= (ctl.or x y) (ctl.or y x)))
(declare-axiom (= (ctl.or (ctl.or x y) z) (ctl.or x (ctl.or y z))))
(declare-axiom (= (ctl.or x x) x))


(define-aspects CTL.Asp
  (record (model Model) (state U) (depth Ctr)))

(define-semantics
  ((CTL.Sem (phi CTL) (asp CTL.Asp)))
  ((match phi
     ((ap.a) (a (state asp)))
     ((nap.a) (not (a (state asp))))
     ((ap.b) (b (state asp)))
     ((nap.b) (not (b (state asp))))
     ((ap.c) (c (state asp)))
     ((nap.c) (not (c (state asp))))
     ((ap.d) (d (state asp)))
     ((nap.d) (not (d (state asp))))
     ((ctl.top) true)
     ((ctl.or x y) (or (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.EX x)
      (exists ((next (univ (U (model asp)))))
        (and (R (state asp) next)
             (CTL.Sem x (CTL.Asp (model asp) next (depth asp))))))
     ((ctl.EG x)
      (and (CTL.Sem x asp)
           (or (= (depth asp) czero)
               (= (depth asp) cbot)
               (exists ((next (univ (U (model asp)))))
                 (and (R (state asp) next)
                      (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.EU x y)
      (or (CTL.Sem y asp)
          (and (not (= (depth asp) czero))
               (not (= (depth asp) cbot))
               (CTL.Sem x asp)
               (exists ((next (univ (U (model asp)))))
                 (and (R (state asp) next)
                      (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp))))))))))))
