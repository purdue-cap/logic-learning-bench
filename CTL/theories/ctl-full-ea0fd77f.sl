(provide U Ctr CTL CTL.Asp CTL.Sem initial R bound next.depth p0 p1 p2 p3 p4 ap.p0 ap.p1 ap.p2 ap.p3 ap.p4 ctl.top ctl.not ctl.AX ctl.EX ctl.AF ctl.EF ctl.AG ctl.EG ctl.and ctl.or ctl.AU ctl.EU czero cbot)


(declare-sort U 0)
(declare-sort Ctr 0)
(declare-fun p0 (U) Bool)
(declare-fun p1 (U) Bool)
(declare-fun p2 (U) Bool)
(declare-fun p3 (U) Bool)
(declare-fun p4 (U) Bool)
(declare-fun R (U U) Bool)
(declare-fun bound (U) Ctr)
(declare-fun next.depth (U Ctr) Ctr)
(declare-fun initial () U)
(declare-fun czero () Ctr)
(declare-fun cbot () Ctr)

(declare-term-types
 ((CTL 0))
 (((ap.p0)
   (ap.p1)
   (ap.p2)
   (ap.p3)
   (ap.p4)
   (ctl.top)
   (ctl.not CTL)
   (ctl.AX CTL)
   (ctl.EX CTL)
   (ctl.AF CTL)
   (ctl.EF CTL)
   (ctl.AG CTL)
   (ctl.EG CTL)
   (ctl.and CTL CTL)
   (ctl.or CTL CTL)
   (ctl.AU CTL CTL)
   (ctl.EU CTL CTL)
  )))

(define-aspects CTL.Asp
  (record (model Model) (state U) (depth Ctr)))

(define-semantics
  ((CTL.Sem (phi CTL) (asp CTL.Asp)))
  ((match phi
     ((ap.p0) (p0 (state asp)))
     ((ap.p1) (p1 (state asp)))
     ((ap.p2) (p2 (state asp)))
     ((ap.p3) (p3 (state asp)))
     ((ap.p4) (p4 (state asp)))
     ((ctl.top) true)
     ((ctl.not x) (not (CTL.Sem x asp)))
     ((ctl.and x y) (and (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.or x y) (or (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.AX x)
      (forall ((next (univ (U (model asp)))))
        (or (not (R (state asp) next))
            (CTL.Sem x (CTL.Asp (model asp) next (depth asp))))))
     ((ctl.EX x)
      (exists ((next (univ (U (model asp)))))
        (and (R (state asp) next)
             (CTL.Sem x (CTL.Asp (model asp) next (depth asp))))))
     ((ctl.AF x)
      (or (CTL.Sem x asp)
          (and (not (= (depth asp) czero))
               (not (= (depth asp) cbot))
               (forall ((next (univ (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.EF x)
      (or (CTL.Sem x asp)
          (and (not (= (depth asp) czero))
               (not (= (depth asp) cbot))
               (exists ((next (univ (U (model asp)))))
                 (and (R (state asp) next)
                      (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.AG x)
      (and (CTL.Sem x asp)
           (or (= (depth asp) czero)
               (= (depth asp) cbot)
               (forall ((next (univ (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.EG x)
      (and (CTL.Sem x asp)
           (or (= (depth asp) czero)
               (= (depth asp) cbot)
               (exists ((next (univ (U (model asp)))))
                 (and (R (state asp) next)
                      (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.AU x y)
      (or (CTL.Sem y asp)
          (and (not (= (depth asp) czero))
               (not (= (depth asp) cbot))
               (CTL.Sem x asp)
               (forall ((next (univ (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.EU x y)
      (or (CTL.Sem y asp)
          (and (not (= (depth asp) czero))
               (not (= (depth asp) cbot))
               (CTL.Sem x asp)
               (exists ((next (univ (U (model asp)))))
                 (and (R (state asp) next)
                      (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp))))))))))))
