(provide U Ctr CTL CTL.Asp CTL.Sem initial R bound next.depth c m t dead ap.c ap.m ap.t ap.dead nap.c nap.m nap.t nap.dead ctl.top ctl.EX ctl.EG ctl.or ctl.EU czero cbot)


(declare-sort U 0)
(declare-sort Ctr 0)
(declare-fun c (U) Bool)
(declare-fun m (U) Bool)
(declare-fun t (U) Bool)
(declare-fun dead (U) Bool)
(declare-fun R (U U) Bool)
(declare-fun bound (U) Ctr)
(declare-fun next.depth (U Ctr) Ctr)
(declare-fun initial () U)
(declare-fun czero () Ctr)
(declare-fun cbot () Ctr)

(declare-term-types
 ((CTL 0))
 (((ap.c)
   (nap.c)
   (ap.m)
   (nap.m)
   (ap.t)
   (nap.t)
   (ap.dead)
   (nap.dead)
   (ctl.top)
   (ctl.EX CTL)
   (ctl.EG CTL)
   (ctl.or CTL CTL)
   (ctl.EU CTL CTL)
  )))

; Canonical Boolean algebraic axioms for pruning.
(declare-axiom (= (ctl.or x y) (ctl.or y x)))
(declare-axiom (= (ctl.or (ctl.or x y) z) (ctl.or x (ctl.or y z))))
(declare-axiom (= (ctl.or x x) x))


(define-aspects CTL.Asp
  (record (state U) (depth Ctr)))

(define-semantics
  ((CTL.Sem (phi CTL) (asp CTL.Asp)))
  ((match phi
     ((ap.c) (c (state asp)))
     ((nap.c) (not (c (state asp))))
     ((ap.m) (m (state asp)))
     ((nap.m) (not (m (state asp))))
     ((ap.t) (t (state asp)))
     ((nap.t) (not (t (state asp))))
     ((ap.dead) (dead (state asp)))
     ((nap.dead) (not (dead (state asp))))
     ((ctl.top) true)
     ((ctl.or x y) (or (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.EX x)
      (exists ((next U))
        (and (R (state asp) next)
             (CTL.Sem x (CTL.Asp next (depth asp))))))
     ((ctl.EG x)
      (and (CTL.Sem x asp)
           (or (= (depth asp) czero)
               (= (depth asp) cbot)
               (exists ((next U))
                 (and (R (state asp) next)
                      (CTL.Sem phi (CTL.Asp next (next.depth next (depth asp)))))))))
     ((ctl.EU x y)
      (or (CTL.Sem y asp)
          (and (not (= (depth asp) czero))
               (not (= (depth asp) cbot))
               (CTL.Sem x asp)
               (exists ((next U))
                 (and (R (state asp) next)
                      (CTL.Sem phi (CTL.Asp next (next.depth next (depth asp))))))))))))
